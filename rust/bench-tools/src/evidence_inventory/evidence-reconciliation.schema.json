{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisory host evidence reconciliation; never a retirement authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root",
    "head",
    "entries",
    "missing_tracked",
    "allocated_bytes_by_class",
    "retirement_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "root": {
      "type": "string",
      "pattern": "\\S"
    },
    "head": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "bytes",
          "allocated_bytes",
          "mode",
          "sha256",
          "class",
          "inventory_class",
          "reason",
          "status",
          "storage"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\S"
          },
          "type": {
            "enum": [
              "file",
              "symlink",
              "special"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "allocated_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "class": {
            "enum": [
              "tracked-identical",
              "development",
              "rebuildable",
              "account-state",
              "reproducibility",
              "local-evidence",
              "unknown"
            ]
          },
          "inventory_class": {
            "enum": [
              "tracked-identical",
              "development",
              "rebuildable",
              "account-state",
              "reproducibility",
              "local-evidence",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "shared",
              "retained",
              "excluded"
            ]
          },
          "storage": {
            "type": [
              "string",
              "null"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "missing_tracked": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "allocated_bytes_by_class": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "retirement_authorized": {
      "const": false
    }
  }
}
