{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-unpublished.schema.json",
  "title": "Pinned inputs known to be unpublished v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unpublished"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "unpublished": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "sha256",
          "reason"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[^/][^\\\\]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
