{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence retirement closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace",
    "manifest",
    "inventory",
    "restoration_receipt",
    "capture_prefix",
    "closure_reason",
    "closed_by",
    "schema_version",
    "kind",
    "investigation",
    "maintenance_window",
    "accounting_roots",
    "evidence"
  ],
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": ".+"
    },
    "manifest": {
      "type": "string",
      "pattern": ".+"
    },
    "inventory": {
      "type": "string",
      "pattern": ".+"
    },
    "restoration_receipt": {
      "type": "string",
      "pattern": ".+"
    },
    "capture_prefix": {
      "type": "string",
      "pattern": ".+"
    },
    "closure_reason": {
      "type": "string",
      "pattern": ".+"
    },
    "closed_by": {
      "type": "string",
      "pattern": ".+"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "review",
        "grading",
        "worktree"
      ]
    },
    "investigation": {
      "const": "closed"
    },
    "maintenance_window": {
      "const": true
    },
    "accounting_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": ".+"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": ".+"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "classifications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "reason",
          "sha256"
        ],
        "properties": {
          "class": {
            "enum": [
              "local-evidence",
              "reproducibility"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": ".+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
