{
  "name": "code-review-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "bun run evidence:fetch && bench/tools/bench-tools export-explorer",
    "rates:check": "bench/tools/bench-tools rates check",
    "rates:refresh": "bench/tools/bench-tools rates refresh",
    "dev": "bun run data && vite --host 0.0.0.0 --port 3000",
    "dev:fixture": "bun tools/fixture_preview.ts && vite --host 0.0.0.0 --port 3000",
    "build": "bun run data && bun run build:site",
    "build:site": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:web && bun run test:bench && bun run test:client",
    "test:web": "bun run test:web:site && bun run test:web:tools",
    "test:web:site": "bun run test:web:contracts && bun run data && bun run test:web:src",
    "test:web:contracts": "cd rust/bench-tools && cargo test --locked --test behavior_contracts -- --exact decision-history digest-vectors",
    "test:web:src": "bun test ./src",
    "test:web:tools": "bun test ./tools",
    "test:bench": "bun run evidence:fetch && (cd rust/bench-tools && cargo test --locked --test behavior_contracts -- check-manifest:: normalize-review:: usage::)",
    "test:client": "bench/tools/bench-tools grading probe-claude",
    "verify:claims": "bun run evidence:fetch && bench/tools/bench-tools claims check",
    "verify:current": "bun run evidence:fetch && bench/tools/bench-tools current-grading check && bench/tools/bench-tools calibration check",
    "scorecard": "bun tools/scorecard.ts",
    "roster": "bench/tools/bench-tools roster",
    "audit:maintainers": "bench/tools/bench-tools upstream report",
    "plan:methodology": "bench/tools/bench-tools methodology",
    "verify:pinned": "bench/tools/bench-tools evidence pinned",
    "verify:import": "bun run evidence:fetch && bench/tools/bench-tools import-benchmark --check",
    "import:preserve": "bench/tools/bench-tools import-benchmark --preserve",
    "regrade:methodology": "bench/tools/bench-tools regrade run",
    "evidence:fetch": "bench/tools/bench-tools evidence fetch --manifest bench/evidence/manifests/repository-payloads-2026-10-08-v1.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
