{
  "$id": "bench/schema/current-candidate.schema.json",
  "title": "Pending novel candidates awaiting an eligibility ruling",
  "type": "object",
  "required": [
    "schema_version",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "revision",
          "recorded_at",
          "claim",
          "evidence",
          "limits",
          "relevance",
          "confidence",
          "would_settle",
          "anchors",
          "source",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NC-[a-f0-9]{12}$"
          },
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "revision": {
            "$ref": "#/$defs/revision"
          },
          "recorded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "claim": {
            "type": "string",
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "pattern": "\\S"
          },
          "limits": {
            "type": "string",
            "pattern": "\\S"
          },
          "relevance": {
            "type": "string",
            "pattern": "\\S"
          },
          "confidence": {
            "type": "string",
            "pattern": "\\S"
          },
          "would_settle": {
            "type": "string",
            "pattern": "\\S"
          },
          "anchors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/anchor"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "run",
              "receipt"
            ],
            "additionalProperties": false,
            "properties": {
              "run": {
                "type": "string",
                "pattern": "\\S"
              },
              "receipt": {
                "$ref": "#/$defs/pin"
              }
            }
          },
          "decision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "review",
        "item_id",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "review": {
          "$ref": "#/$defs/pin"
        },
        "item_id": {
          "type": "string",
          "pattern": "^item-[0-9]+$"
        },
        "quote": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
