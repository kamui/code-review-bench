{
  "$id": "bench/schema/current-adjudication.schema.json",
  "title": "Current adjudication v1",
  "type": "object",
  "required": [
    "schema_version",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "revision",
          "subject",
          "dimension",
          "status",
          "outcome",
          "authority",
          "reason",
          "receipt",
          "receipt_scope",
          "boundary",
          "evidence",
          "independent_checks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "revision": {
            "$ref": "#/$defs/revision"
          },
          "subject": {
            "type": "string",
            "pattern": "\\S"
          },
          "dimension": {
            "enum": [
              "eligibility",
              "impact",
              "control",
              "advice-benefit"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "proposed",
              "approved"
            ]
          },
          "outcome": {
            "enum": [
              "eligible",
              "refuted",
              "unsupported",
              "advisory",
              "inconsequential",
              "scope-excluded",
              "unresolved",
              "serious",
              "other-material",
              "unknown",
              "audited-clean",
              "provisional",
              "unaudited",
              "known-problems",
              "supported-benefit",
              "unsupported-benefit"
            ]
          },
          "authority": {
            "enum": [
              "human",
              "automation"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "receipt_scope": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\S"
          },
          "boundary": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pin"
            }
          },
          "independent_checks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/check"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "review",
        "item_id",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "review": {
          "$ref": "#/$defs/pin"
        },
        "item_id": {
          "type": "string",
          "pattern": "^item-[0-9]+$"
        },
        "quote": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "source",
        "checker",
        "independent_of",
        "result",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/pin"
        },
        "checker": {
          "type": "string",
          "pattern": "\\S"
        },
        "independent_of": {
          "type": "string",
          "pattern": "\\S"
        },
        "result": {
          "enum": [
            "confirmed",
            "refuted",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
