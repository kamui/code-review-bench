{
  "$id": "bench/schema/current-audit.schema.json",
  "title": "Current evaluator audit v1",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "reason",
    "plan",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "unassessed",
        "assessed"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "plan": {
      "type": "object",
      "required": [
        "declared_at",
        "basis",
        "seed",
        "selection",
        "strata",
        "sample",
        "tolerances"
      ],
      "additionalProperties": false,
      "properties": {
        "declared_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "basis": {
          "type": "string",
          "pattern": "\\S"
        },
        "seed": {
          "type": "string",
          "pattern": "\\S"
        },
        "selection": {
          "type": "string",
          "pattern": "\\S"
        },
        "strata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "unit",
              "population"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "unit": {
                "enum": [
                  "family-review",
                  "claim"
                ]
              },
              "population": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "sample": {
          "type": "object",
          "required": [
            "state",
            "reason",
            "authority",
            "receipt",
            "receipt_scope",
            "sizes"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "pending",
                "selected"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "authority": {
              "enum": [
                "human",
                null
              ]
            },
            "receipt": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "receipt_scope": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "\\S"
            },
            "sizes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stratum",
                  "size"
                ],
                "additionalProperties": false,
                "properties": {
                  "stratum": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "size": {
                    "type": [
                      "integer",
                      "string"
                    ],
                    "minimum": 0,
                    "pattern": "^all$"
                  }
                }
              }
            }
          }
        },
        "tolerances": {
          "type": "object",
          "required": [
            "state",
            "reason",
            "authority",
            "receipt",
            "receipt_scope",
            "limits"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "pending",
                "selected"
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            },
            "authority": {
              "enum": [
                "human",
                null
              ]
            },
            "receipt": {
              "type": [
                "object",
                "null"
              ],
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "receipt_scope": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "\\S"
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stratum",
                  "max_errors"
                ],
                "additionalProperties": false,
                "properties": {
                  "stratum": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "max_errors": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
