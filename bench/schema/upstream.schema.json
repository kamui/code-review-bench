{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upstream.schema.json",
  "title": "Immutable upstream retrieval snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "target",
    "repo",
    "pr",
    "revision",
    "review_cutoff",
    "retrieved_at",
    "coverage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "review_cutoff": {
      "type": "string"
    },
    "retrieved_at": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "endpoint",
          "complete",
          "pages",
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": [
                "object",
                "array"
              ]
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
