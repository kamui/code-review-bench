{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Versioned shared claim",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "version",
    "target",
    "revision",
    "supersedes",
    "revision_reason",
    "claim",
    "evidence",
    "links",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CL-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "supersedes": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "revision_reason": {
      "type": "string"
    },
    "claim": {
      "type": "object",
      "required": [
        "trigger",
        "mechanism",
        "consequence",
        "change_relation",
        "settlement_question"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "change_relation": {
          "type": "string"
        },
        "settlement_question": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "stance",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "stance": {
            "enum": [
              "supports",
              "opposes",
              "context"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mapping",
          "review",
          "attempt_id",
          "item_id",
          "relation",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "mapping": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "review": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^att-[0-9]+$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^item-[0-9]+$"
          },
          "relation": {
            "enum": [
              "equivalent",
              "related"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "status",
        "outcome",
        "reason",
        "authority",
        "receipt",
        "register",
        "defect_id"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "outcome": {
          "enum": [
            "eligible",
            "false",
            "non-material"
          ]
        },
        "reason": {
          "type": "string"
        },
        "authority": {
          "enum": [
            "human",
            "automation"
          ]
        },
        "receipt": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "register": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "defect_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "feedback_kind": {
          "enum": [
            "advisory",
            "inconsequential",
            "scope-excluded",
            "refuted",
            "unsupported",
            null
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "technical",
        "attribution",
        "materiality",
        "maintainer"
      ],
      "additionalProperties": false,
      "properties": {
        "technical": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "supported",
                "refuted",
                "unsupported",
                "unsettled"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "attribution": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "introduced",
                "worsened",
                "new-obligation",
                "preexisting",
                "unsettled"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "materiality": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "evidence"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "material",
                "non-material",
                "unsettled"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "maintainer": {
          "type": "object",
          "required": [
            "status",
            "reason",
            "snapshots",
            "judgments"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "accepted",
                "deferred",
                "declined",
                "refuted",
                "by-design",
                "unknown",
                "mixed"
              ]
            },
            "reason": {
              "type": "string"
            },
            "snapshots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "judgments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "snapshot",
                  "endpoint",
                  "record_id",
                  "quote",
                  "reason",
                  "role",
                  "relation",
                  "applicability",
                  "disposition"
                ],
                "additionalProperties": false,
                "properties": {
                  "snapshot": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "record_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "role": {
                    "type": "object",
                    "required": [
                      "status",
                      "reason",
                      "evidence"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "enum": [
                          "confirmed",
                          "unverified",
                          "not-maintainer"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "path",
                            "sha256"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "type": "string"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          }
                        }
                      }
                    }
                  },
                  "relation": {
                    "enum": [
                      "equivalent",
                      "related"
                    ]
                  },
                  "applicability": {
                    "enum": [
                      "present-at-head",
                      "fixed-before-head",
                      "unclear"
                    ]
                  },
                  "disposition": {
                    "enum": [
                      "accepted",
                      "deferred",
                      "declined",
                      "refuted",
                      "by-design"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
