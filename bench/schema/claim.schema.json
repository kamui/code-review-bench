{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Versioned shared claim",
  "type": "object",
  "required": [
    "schema_version",
    "claim_id",
    "version",
    "target",
    "revision",
    "supersedes",
    "revision_reason",
    "claim",
    "evidence",
    "links",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CL-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "supersedes": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "revision_reason": {
      "type": "string"
    },
    "claim": {
      "type": "object",
      "required": [
        "trigger",
        "mechanism",
        "consequence",
        "change_relation",
        "settlement_question"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "change_relation": {
          "type": "string"
        },
        "settlement_question": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "stance",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "stance": {
            "enum": [
              "supports",
              "opposes",
              "context"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mapping",
          "review",
          "attempt_id",
          "item_id",
          "relation",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "mapping": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "review": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^att-[0-9]+$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^item-[0-9]+$"
          },
          "relation": {
            "enum": [
              "equivalent",
              "related"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "status",
        "outcome",
        "reason",
        "authority",
        "receipt",
        "register",
        "defect_id"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "outcome": {
          "enum": [
            "eligible",
            "false",
            "non-material"
          ]
        },
        "reason": {
          "type": "string"
        },
        "authority": {
          "enum": [
            "human",
            "automation"
          ]
        },
        "receipt": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "register": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "defect_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
