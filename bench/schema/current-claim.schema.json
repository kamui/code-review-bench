{
  "$id": "bench/schema/current-claim.schema.json",
  "title": "Current claim v1",
  "type": "object",
  "required": [
    "schema_version",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "revision",
          "claim",
          "evidence",
          "links",
          "adjudication",
          "family_id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "target": {
            "type": "string",
            "pattern": "\\S"
          },
          "revision": {
            "$ref": "#/$defs/revision"
          },
          "claim": {
            "type": "object",
            "required": [
              "trigger",
              "mechanism",
              "consequence",
              "change_relation",
              "settlement_question"
            ],
            "additionalProperties": false,
            "properties": {
              "trigger": {
                "type": "string",
                "pattern": "\\S"
              },
              "mechanism": {
                "type": "string",
                "pattern": "\\S"
              },
              "consequence": {
                "type": "string",
                "pattern": "\\S"
              },
              "change_relation": {
                "type": "string",
                "pattern": "\\S"
              },
              "settlement_question": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "stance",
                "summary"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "$ref": "#/$defs/pin"
                },
                "stance": {
                  "enum": [
                    "supports",
                    "opposes",
                    "context"
                  ]
                },
                "summary": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "review",
                "attempt_id",
                "item_id",
                "relation",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "review": {
                  "$ref": "#/$defs/pin"
                },
                "attempt_id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "item_id": {
                  "type": "string",
                  "pattern": "^item-[0-9]+$"
                },
                "relation": {
                  "enum": [
                    "equivalent",
                    "related"
                  ]
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "adjudication": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\S"
          },
          "family_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "head",
        "base_sha",
        "packet_sha256",
        "diff_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "diff_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "anchor": {
      "type": "object",
      "required": [
        "review",
        "item_id",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "review": {
          "$ref": "#/$defs/pin"
        },
        "item_id": {
          "type": "string",
          "pattern": "^item-[0-9]+$"
        },
        "quote": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "source",
        "checker",
        "independent_of",
        "result",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/pin"
        },
        "checker": {
          "type": "string",
          "pattern": "\\S"
        },
        "independent_of": {
          "type": "string",
          "pattern": "\\S"
        },
        "result": {
          "enum": [
            "confirmed",
            "refuted",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
