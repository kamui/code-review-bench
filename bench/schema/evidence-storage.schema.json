{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-storage.schema.json",
  "title": "Portable evidence storage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "tag",
    "subjects",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^evidence-[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": ".+"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "mode",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "evidence",
            "reproducibility"
          ]
        }
      }
    },
    "publication": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "release_id",
        "asset_id",
        "sha256",
        "verified_at"
      ],
      "properties": {
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "asset_id": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_at": {
          "type": "string"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "sha256",
        "bytes",
        "members",
        "publication"
      ],
      "properties": {
        "asset": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "publication": {
          "$ref": "#/$defs/publication"
        }
      }
    }
  }
}
