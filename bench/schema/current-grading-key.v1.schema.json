{
  "$id": "bench/schema/current-grading-key.v1.schema.json",
  "title": "The private key of a prepared grading workspace",
  "description": "Written by the retired grade.py preparation (runner_deviation version 1) and bench-tools grade prepare (version 2, as tools/behavior_contracts/grade-prepare-decisions.v1.json records). A version 2 key names the bench-tools executable in files as rust/bench-tools and pins its store entry in bench_tools; check-prepared enforces that pairing.",
  "type": "object",
  "required": [
    "contract",
    "run",
    "target",
    "input_fingerprint",
    "current_record",
    "workspace_identity_blinded",
    "identifying",
    "prompt_sha256",
    "created_at",
    "prepared_files",
    "validator",
    "command_policy_sha256",
    "profiles_sha256",
    "runner_deviation",
    "claim_snapshot",
    "reviews"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "current-grading-key/v1"
    },
    "run": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "input_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "current_record": {
      "type": "object",
      "required": [
        "root",
        "current"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "current": {
          "type": "string"
        }
      }
    },
    "workspace_identity_blinded": {
      "const": true
    },
    "identifying": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "type": "string"
    },
    "prepared_files": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "command_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profiles_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runner_deviation": {
      "type": "object",
      "required": [
        "version",
        "files",
        "execution_policy_sha256",
        "codex_catalog_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "bench_tools": {
          "type": "object",
          "required": [
            "sha256",
            "receipt_sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "execution_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "codex_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provisioning": {
          "type": "object"
        }
      }
    },
    "claim_snapshot": {
      "type": "object",
      "required": [
        "claims",
        "context_sha256"
      ],
      "properties": {
        "claims": {
          "type": "array"
        },
        "context_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence": {
          "type": "object"
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token",
          "attempt_id",
          "items",
          "review"
        ],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^blind-[0-9a-f]{6}$"
          },
          "attempt_id": {
            "type": "string"
          },
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "review": {
            "type": "object"
          }
        }
      }
    },
    "remedy_policy": {
      "type": "object",
      "required": [
        "source",
        "role"
      ],
      "properties": {
        "source": {
          "type": "object"
        },
        "role": {
          "enum": [
            "first",
            "second"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
