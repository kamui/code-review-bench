#!/bin/sh
# Runs `bench-tools redaction check` for the commit hooks and fails closed: any exit but 0 refuses the commit.
set -u
top=$(git rev-parse --show-toplevel) || exit 1
"$top/bench/tools/bench-tools" redaction check "$@"
status=$?
if [ "$status" -ne 0 ]; then
    cat >&2 <<'MESSAGE'
Commit refused by the redaction check (docs/evidence-storage.md#redaction).
- If a file is listed, run bench/tools/bench-tools redaction apply on it, stage it again and commit again.
- If the commit message is listed, write it again without the identifier or machine name.
- If bench-tools is not installed or has no redaction command, run bench/tools/bench-tools runtime install --select.
- If the values file is missing, write it as that section describes.
MESSAGE
    exit 1
fi
