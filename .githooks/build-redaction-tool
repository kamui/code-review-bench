#!/bin/sh
# Builds the bench-tools that the commit hooks run, or with --path prints where it is kept.
#
# The build is kept under the user's cache, named by the Git blob of rust/bench-tools/src/redaction.rs at HEAD. Every
# checkout on the machine whose rules are the same shares it, and a change to the rules asks for a new build.
set -eu
top=$(git rev-parse --show-toplevel)
rules=rust/bench-tools/src/redaction.rs
if ! blob=$(git -C "$top" rev-parse --verify --quiet "HEAD:$rules"); then
    echo "redaction check: HEAD has no $rules" >&2
    exit 1
fi
root=${XDG_CACHE_HOME:-${HOME:?}/.cache}/code-review-bench/redaction-check/$blob
if [ "${1-}" = --path ]; then
    echo "$root/bin/bench-tools"
    exit 0
fi
if ! git -C "$top" diff --quiet HEAD -- "$rules"; then
    echo "redaction check: $rules differs from HEAD; commit or revert it, then build again" >&2
    exit 1
fi
cargo install --locked --path "$top/rust/bench-tools" --root "$root" --force
echo "redaction check: built $root/bin/bench-tools"
