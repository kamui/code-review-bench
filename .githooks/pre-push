#!/bin/sh
# Allows only history that descends from the commits the repository was re-created with on 2026-11-13.
#
# Every earlier history holds unredacted evidence, and no commit of it descends from these two. A remote whose URL
# names the archive is exempt.
current="7accf490ec3b951af897f952f85b75b5045d0a15 7928aff2cdc267f133efe67222f555d08ff2299b"
case "$2" in
    *code-review-bench-archive*) exit 0 ;;
esac
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    found=no
    for commit in $current; do
        if git merge-base --is-ancestor "$commit" "$local_sha^{commit}" 2>/dev/null; then
            found=yes
        fi
    done
    if [ "$found" = no ]; then
        echo "push refused: $local_ref is not part of the history the repository was re-created with on 2026-11-13." >&2
        echo "Earlier histories hold unredacted evidence. Work from a fresh, full clone of kamui/code-review-bench." >&2
        exit 1
    fi
done
exit 0
