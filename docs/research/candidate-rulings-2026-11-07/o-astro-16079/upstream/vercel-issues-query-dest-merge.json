/followers","following_url":"https://api.github.com/users/TooTallNate/following{/other_user}","gists_url":"https://api.github.com/users/TooTallNate/gists{/gist_id}","starred_url":"https://api.github.com/users/TooTallNate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TooTallNate/subscriptions","organizations_url":"https://api.github.com/users/TooTallNate/orgs","repos_url":"https://api.github.com/users/TooTallNate/repos","events_url":"https://api.github.com/users/TooTallNate/events{/privacy}","received_events_url":"https://api.github.com/users/TooTallNate/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2019-03-28T22:42:31Z","updated_at":"2019-03-29T09:06:43Z","closed_at":"2019-03-28T22:55:03Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/vercel/vercel/pulls/2036","html_url":"https://github.com/vercel/vercel/pull/2036","diff_url":"https://github.com/vercel/vercel/pull/2036.diff","patch_url":"https://github.com/vercel/vercel/pull/2036.patch","merged_at":"2019-03-28T22:55:03Z"},"body":"This matches how the Now proxy invokes the lambdas, where the route `dest` query params are mixed-in to the provided `req.url`, with the dest query params taking precedence over any conflicting user-provided query params.","reactions":{"url":"https://api.github.com/repos/vercel/vercel/issues/2036/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/vercel/issues/2036/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/vercel/vercel/issues/2027","repository_url":"https://api.github.com/repos/vercel/vercel","labels_url":"https://api.github.com/repos/vercel/vercel/issues/2027/labels{/name}","comments_url":"https://api.github.com/repos/vercel/vercel/issues/2027/comments","events_url":"https://api.github.com/repos/vercel/vercel/issues/2027/events","html_url":"https://github.com/vercel/vercel/pull/2027","id":426247934,"node_id":"MDExOlB1bGxSZXF1ZXN0MjY1MTUyNDQz","number":2027,"title":"[now dev] Use `pcre-to-regexp` to match `routes`","user":{"login":"TooTallNate","id":71256,"node_id":"MDQ6VXNlcjcxMjU2","avatar_url":"https://avatars.githubusercontent.com/u/71256?v=4","gravatar_id":"","url":"https://api.github.com/users/TooTallNate","html_url":"https://github.com/TooTallNate","followers_url":"https://api.github.com/users/TooTallNate/followers","following_url":"https://api.github.com/users/TooTallNate/following{/other_user}","gists_url":"https://api.github.com/users/TooTallNate/gists{/gist_id}","starred_url":"https://api.github.com/users/TooTallNate/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/TooTallNate/subscriptions","organizations_url":"https://api.github.com/users/TooTallNate/orgs","repos_url":"https://api.github.com/users/TooTallNate/repos","events_url":"https://api.github.com/users/TooTallNate/events{/privacy}","received_events_url":"https://api.github.com/users/TooTallNate/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2019-03-28T01:07:45Z","updated_at":"2019-03-28T01:37:47Z","closed_at":"2019-03-28T01:37:44Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/vercel/vercel/pulls/2027","html_url":"https://github.com/vercel/vercel/pull/2027","diff_url":"https://github.com/vercel/vercel/pull/2027.diff","patch_url":"https://github.com/vercel/vercel/pull/2027.patch","merged_at":"2019-03-28T01:37:44Z"},"body":"The now.json `routes` support PCRE syntax like named captures, so use the `pcre-to-regexp` module to match the routes.\n\nAlso pass the resolved router `dest` and query params to the Lambda.\n\nFixes #2023.","reactions":{"url":"https://api.github.com/repos/vercel/vercel/issues/2027/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/vercel/vercel/issues/2027/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}