---
const url = new URL(Astro.request.url);
const values = url.searchParams.getAll('x_astro_path');
const cookie = Astro.request.headers.get('cookie') || '';
---
<html><body><pre>ACCOUNT pathname={Astro.url.pathname}
request_url={Astro.request.url}
x_astro_path_values={JSON.stringify(values)}
cookie_names={JSON.stringify(cookie.split(';').map(c => c.trim().split('=')[0]).filter(Boolean))}
rendered_at={Date.now()}</pre></body></html>
