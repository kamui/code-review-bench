[{"sha":"2097e9dd0e9f768fc953e2669964eda85a259eb4","node_id":"C_kwDOOeizoNoAKDIwOTdlOWRkMGU5Zjc2OGZjOTUzZTI2Njk5NjRlZGE4NWEyNTllYjQ","commit":{"author":{"name":"Muhsin903125","email":"64016442+Muhsin903125@users.noreply.github.com","date":"2026-10-14T10:38:57Z"},"committer":{"name":"Muhsin903125","email":"64016442+Muhsin903125@users.noreply.github.com","date":"2026-10-14T10:38:57Z"},"message":"Rebuild the site in Astro with a CMS, programmatic SEO pages and real media\n\nReplaces the single-page eNno template with a multi-page Astro 4 site on\nthe LOPAZ architecture: server-rendered with Vercel ISR, content in one\nZod-validated JSON document stored in Cloudinary, edited at /admin and\npublished in seconds.\n\n- Pages: home, about, team, services, products, brands, delivery areas,\n  gallery, contact, FAQ, privacy, terms, 404\n- Programmatic pages for 6 services, 8 categories, 50 brands and 7\n  emirates, behind a quality gate that noindexes thin pages\n- JSON-LD graph per page (Organization, ComputerStore per branch,\n  Service, HowTo, FAQPage, Brand, Person, ImageGallery/VideoObject),\n  sitemap with image and video entries, llms.txt and AI-crawler robots\n- Light design in the Colion navy and gold, Sora and Manrope type,\n  full-bleed video hero, pinned horizontal category rail, scroll\n  scrubbing, parallax and section backdrops\n- The owner's 34 stock-room photos and 6 reels in the gallery, with\n  bulk drag-and-drop upload to Cloudinary from the admin\n- Mixkit and Wikimedia Commons media credited in CREDITS.md\n- Legacy URLs redirected in vercel.json\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"d0836e15ea2dbe39681761e79bb90de192752717","url":"https://api.github.com/repos/Muhsin903125/colion_website/git/trees/d0836e15ea2dbe39681761e79bb90de192752717"},"url":"https://api.github.com/repos/Muhsin903125/colion_website/git/commits/2097e9dd0e9f768fc953e2669964eda85a259eb4","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Muhsin903125/colion_website/commits/2097e9dd0e9f768fc953e2669964eda85a259eb4","html_url":"https://github.com/Muhsin903125/colion_website/commit/2097e9dd0e9f768fc953e2669964eda85a259eb4","comments_url":"https://api.github.com/repos/Muhsin903125/colion_website/commits/2097e9dd0e9f768fc953e2669964eda85a259eb4/comments","author":{"login":"Muhsin903125","id":64016442,"node_id":"MDQ6VXNlcjY0MDE2NDQy","avatar_url":"https://avatars.githubusercontent.com/u/64016442?v=4","gravatar_id":"","url":"https://api.github.com/users/Muhsin903125","html_url":"https://github.com/Muhsin903125","followers_url":"https://api.github.com/users/Muhsin903125/followers","following_url":"https://api.github.com/users/Muhsin903125/following{/other_user}","gists_url":"https://api.github.com/users/Muhsin903125/gists{/gist_id}","starred_url":"https://api.github.com/users/Muhsin903125/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Muhsin903125/subscriptions","organizations_url":"https://api.github.com/users/Muhsin903125/orgs","repos_url":"https://api.github.com/users/Muhsin903125/repos","events_url":"https://api.github.com/users/Muhsin903125/events{/privacy}","received_events_url":"https://api.github.com/users/Muhsin903125/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Muhsin903125","id":64016442,"node_id":"MDQ6VXNlcjY0MDE2NDQy","avatar_url":"https://avatars.githubusercontent.com/u/64016442?v=4","gravatar_id":"","url":"https://api.github.com/users/Muhsin903125","html_url":"https://github.com/Muhsin903125","followers_url":"https://api.github.com/users/Muhsin903125/followers","following_url":"https://api.github.com/users/Muhsin903125/following{/other_user}","gists_url":"https://api.github.com/users/Muhsin903125/gists{/gist_id}","starred_url":"https://api.github.com/users/Muhsin903125/starred{/owner}{/repo}","subscriptions_url":"https