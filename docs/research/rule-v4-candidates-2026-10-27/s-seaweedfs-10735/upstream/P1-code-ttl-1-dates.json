[{"sha":"d1f503181b29b8616f83783e4d0f591e7743a747","node_id":"C_kwDOT6SfHtoAKGQxZjUwMzE4MWIyOWI4NjE2ZjgzNzgzZTRkMGY1OTFlNzc0M2E3NDc","commit":{"author":{"name":"Konstantin Lebedev","email":"9497591+kmlebedev@users.noreply.github.com","date":"2026-08-06T06:55:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-08-06T06:55:20Z"},"message":"[s3] force filer apply s3 expiry metadata (#10469)\n\n* fix: apply S3 Expiry Metadata\n\n* add test Header X-Seaweedfs-Expires-S3\n\n* resolve comments\n\n* test entry lookup by mtime\n\n* filer: skip s3 expiry stamp on versioned entries\n\nThe s3 expiry path skips entries carrying a version id, so stamping one\ntakes away its expiry rather than moving it onto mtime. Files under\n.versions/ are written once, so crtime already tracks their needles.\n\n---------\n\nCo-authored-by: Konstantin Lebedev <whitefox@mayflower.work>\nCo-authored-by: Chris Lu <chris.lu@gmail.com>","tree":{"sha":"369cc68d5c03dd4da210adae91b2820e5b82ba08","url":"https://api.github.com/repos/xx025/seaweedfs-session-revocation/git/trees/369cc68d5c03dd4da210adae91b2820e5b82ba08"},"url":"https://api.github.com/repos/xx025/seaweedfs-session-revocation/git/commits/d1f503181b29b8616f83783e4d0f591e7743a747","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJqdC/YCRC1aQ7uu5UhlAAA7WYQAABluXTVI84Jd58hwc5scugE\nPWCdYlyN6wTq7VQP6NfmR5UMVIZjETPllNkqvYcITeXQB3hZzfR4Ge9P1wSov3m6\n0oDRxfDko6q8/XUZJ+uCd+IHyCWARVqWLV5TI8Lx6wcmF8OFK+hjQzNv2/TcwRMC\nCp+tckCiq2ndjhTtH0/VJrLRPw5cz7It6iQXrhql94WdF/i3lPJMD+3PnRmC9EUY\n7ZAgWmAJIoAaKei2FgFAkaGVHkmh9DZpWWu+lheGJBRdm3ecL6hoxYlJ+tESFNBZ\nMWfCRDKhPkI17lzAvUDuS5Wxw5ELxK9Ka+no3hhy6cu4xFWfJvinH0g869y0aBs0\nbs9BIQ/ZPMhbMh8FjHC7uMBmaUqP2Qv+s/9KszIBP7GGiv0FDPya67C37+5PRxwj\nwKV4Y9IANxuolSWK4iRmxU265rI7JK536W6J8V9s9RclB/QhjYySls5ZRD32p22j\nx8o5YkQ4l+wPB7Xlne6h14onc0VsISiv6GMgqSNB5GryoABR8esvRgaGU08fJpeu\nZaIau0Q0fV2rJxdSTVdBadITEc+B1DFpXEJzy/iXkD44nO6GtK+B8RbrR3GhfCnv\nJIoUZyOn8s85LJA5y4wWqwUwLLfhllH6bA5SYD9YyQONCV5mVk/5iVFglBiiPIuZ\njuNwvRaJrFXzr2Dsrv8F\n=fOjX\n-----END PGP SIGNATURE-----\n","payload":"tree 369cc68d5c03dd4da210adae91b2820e5b82ba08\nparent a5e8254ffd3bfa3414a8dff3c24799a841425dd8\nauthor Konstantin Lebedev <9497591+kmlebedev@users.noreply.github.com> 1785999320 +0500\ncommitter GitHub <noreply@github.com> 1785999320 -0700\n\n[s3] force filer apply s3 expiry metadata (#10469)\n\n* fix: apply S3 Expiry Metadata\n\n* add test Header X-Seaweedfs-Expires-S3\n\n* resolve comments\n\n* test entry lookup by mtime\n\n* filer: skip s3 expiry stamp on versioned entries\n\nThe s3 expiry path skips entries carrying a version id, so stamping one\ntakes away its expiry rather than moving it onto mtime. Files under\n.versions/ are written once, so crtime already tracks their needles.\n\n---------\n\nCo-authored-by: Konstantin Lebedev <whitefox@mayflower.work>\nCo-authored-by: Chris Lu <chris.lu@gmail.com>","verified_at":"2026-08-16T17:28:05Z"}},"url":"https://api.github.com/repos/xx025/seaweedfs-session-revocation/commits/d1f503181b29b8616f83783e4d0f591e7743a747","html_url":"https://github.com/xx025/seaweedfs-session-revocation/commit/d1f503181b29b8616f83783e4d0f591e7743a747","comments_url":"https://api.github.com/repos/xx025/seaweedfs-session-revocation/commits/d1f503181b29b8616f83783e4d0f591e7743a747/comments","author":{"login":"kmlebedev","id":9497591,"node_id":"MDQ6VXNlcjk0OTc1OTE=","avatar_url":"https://avatars.githubusercontent.com/u/9497591?v=4","gravatar_id":"","url":"https://api.github.com/users/kmlebedev","html_url":"https://github.com/kmlebedev","followers_url":"https://api.github.com/users/kmlebedev/followers","following_url":"https://api.github.com/users/kmlebedev/following{/other_user}","gists_url":"https://api.github.com/users/kmlebedev/gists{/gist_id}","starred_url":"https://api.github.com/users/kmlebedev/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kmlebedev/subsc