b.com/users/Soviut/orgs","repos_url":"https://api.github.com/users/Soviut/repos","events_url":"https://api.github.com/users/Soviut/events{/privacy}","received_events_url":"https://api.github.com/users/Soviut/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":38,"created_at":"2024-11-28T02:45:11Z","updated_at":"2026-08-03T21:42:54Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/honojs/hono/pulls/3707","html_url":"https://github.com/honojs/hono/pull/3707","diff_url":"https://github.com/honojs/hono/pull/3707.diff","patch_url":"https://github.com/honojs/hono/pull/3707.patch","merged_at":null},"body":"When a validator has a target 'json' it will now warn if a request is missing a `Content-Type: application/json` header.\r\n\r\nCloses https://github.com/honojs/middleware/issues/841\r\n\r\nAdded some docs too https://github.com/honojs/website/pull/540\r\n\r\n### The author should do the following, if applicable\r\n\r\n- [ ] Add tests\r\n- [ ] Run tests\r\n- [ ] `bun run format:fix && bun run lint:fix` to format the code\r\n- [ ] Add [TSDoc](https://tsdoc.org/)/[JSDoc](https://jsdoc.app/about-getting-started) to document the code\r\n","reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/3707/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/honojs/hono/issues/3707/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/honojs/hono/issues/4062","repository_url":"https://api.github.com/repos/honojs/hono","labels_url":"https://api.github.com/repos/honojs/hono/issues/4062/labels{/name}","comments_url":"https://api.github.com/repos/honojs/hono/issues/4062/comments","events_url":"https://api.github.com/repos/honojs/hono/issues/4062/events","html_url":"https://github.com/honojs/hono/issues/4062","id":2982887117,"node_id":"I_kwDOGiE5WM6xyz7N","number":4062,"title":"Support `body` validation target to handle form OR json content type use-case","user":{"login":"davidthor","id":1107950,"node_id":"MDQ6VXNlcjExMDc5NTA=","avatar_url":"https://avatars.githubusercontent.com/u/1107950?v=4","gravatar_id":"","url":"https://api.github.com/users/davidthor","html_url":"https://github.com/davidthor","followers_url":"https://api.github.com/users/davidthor/followers","following_url":"https://api.github.com/users/davidthor/following{/other_user}","gists_url":"https://api.github.com/users/davidthor/gists{/gist_id}","starred_url":"https://api.github.com/users/davidthor/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/davidthor/subscriptions","organizations_url":"https://api.github.com/users/davidthor/orgs","repos_url":"https://api.github.com/users/davidthor/repos","events_url":"https://api.github.com/users/davidthor/events{/privacy}","received_events_url":"https://api.github.com/users/davidthor/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":4338084797,"node_id":"LA_kwDOGiE5WM8AAAABApHrvQ","url":"https://api.github.com/repos/honojs/hono/labels/enhancement","name":"enhancement","color":"C5DEF5","default":true,"description":"New feature or request.","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2025-04-09T13:46:05Z","updated_at":"2025-04-18T00:11:48Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What is the feature you are proposing?\n\nThe [`validator`](https://github.com/honojs/hono/blob/16a9a949c66bd561e55fffba1580ddc18ef30857/src/validator/validator.ts#L30) function is used by most of the hono middleware packages (e.g. [`@hono/zod-validator`](https://github.com/honojs/middleware/tree/main/packages/zod-validator)) to validate incoming request data, automatically throw errors where applicable, and provided typed data back via `c.req.valid(...)`. The current implementation will treat all middleware calls as intersecting and ensure that ALL the data validates currently before passing the request through to the route handler:\n\n```ts\napp.post(\n  '/',\n  zValidator('query', z.object({ q: z.string().optional() })),\n  zValidator('json', z.object({ name: z.string() })),\n  async (c) => {\n    // Both typed correctly\n    const query = c.req.valid('query');\n    const json = c.req.valid('json');\n  }\n);\n```\n\nHowever, requiring ALL the validators to be used on every request fails in the case of `json` and `form` data which cannot exist simultaneously because they are both part of the `body` of the request. (See https://github.com/honojs/middleware/issues/907 for some context). Requests will always fail if a route tries to validate both `json` and `form` data simultaneously. \n\nThe more appropriate expectation for `body` data in this case would be to validate either `json` OR `form` data based on the incoming content type. This is a valid way to discriminate incoming data, and it would be great for the native hono validation to support it.\n\n-------\n\nWhat I propose is to add support for `body` inside of [`ValidationTargets`](https://github.com/honojs/hono/blob/16a9a949c66bd561e55fffba1580ddc18ef30857/src/types.ts#L1930) that would take in a dictionary of appropriate targets along with a validation function for each. When validating the incoming requests, it would only validate the incoming data against the function matching the incoming content type:\n\n```ts\napp.post(\n  '/',\n  validator('body', {\n    json: (value, c) => {\n      // Only called when Content-Type = 'application/json'\n    },\n    form: (value, c) => {\n      // Only called when Content-Type = 'application/form-data'\n    }\n  }),\n  async (c) => {\n    if (c.req.header('User-Agent') === 'application/json') {\n      const json = c.req.valid('json');\n    } else {\n     const data = c.req.valid('form');\n    }\n  }\n);\n```","reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/4062/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/honojs/hono/issues/4062/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/honojs/hono/issues/2439","repository_url":"https://api.github.com/repos/honojs/hono","labels_url":"https://api.github.com/repos/honojs/hono/issues/2439/labels{/name}","comments_url":"https://api.github.com/repos/honojs/hono/issues/2439/comments","events_url":"https://api.github.com/repos/honojs/hono/issues/2439/events","html_url":"https://github.com/honojs/hono/issues/2439","id":2216204780,"node_id":"I_kwDOGiE5WM6EGJns","number":2439,"title":"Response serialization and validation","user":{"login":"sher","id":381501,"node_id":"MDQ6VXNlcjM4MTUwMQ==","avatar_url":"https://avatars.githubusercontent.com/u/381501?v=4","gravatar_id":"","url":"https://api.github.com/users/sher","html_url":"https://github.com/sher","followers_url":"https://api.github.com/users/sher/followers","following_url":"https://api.github.com/users/sher/following{/other_user}","gists_url":"https://api.github.com/users/sher/gists{/gist_id}","starred_url":"https://api.github.com/users/sher/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/sher/subscriptions","organizations_url":"https://api.github.com/users/sher/orgs","repos_url":"https://api.github.com/users/sher/repos","events_url":"https://api.github.com/users/sher/events{/privacy}","received_events_url":"https://api.github.com/users/sher/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":4338084797,"node_id":"LA_kwDOGiE5WM8AAAABApHrvQ","url":"https://api.github.com/repos/honojs/hono/labels/enhancement","name":"enhancement","color":"C5DEF5","default":true,"description":"New feature or request.","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":27,"created_at":"2024-03-30T04:15:25Z","updated_at":"2026-08-08T12:55:22Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What is the feature you are proposing?\r\n\r\nCertain frameworks (eg: [fastify](https://fastify.dev/docs/latest/Reference/Validation-and-Serialization/#serialization)) provide response validation for success or error payloads.\r\nIs there support for such feature in hono? If not, is it something planned?\r\n\r\n### Context\r\nApart from obvious advantages like schema-first approach, this feature would greatly help securing API internals.\r\nFor example, when you have multiple unique IDs for DB records and you want to make sure that only `external_id` IDs are ever returned without accidentally leaking `internal_id` IDs.\r\n","reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/2439/reactions","total_count":30,"+1":27,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":3,"eyes":0},"timeline_url":"https://api.github.com/repos/honojs/hono/issues/2439/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/honojs/hono/issues/664","repository_url":"https://api.github.com/repos/honojs/hono","labels_url":"https://api.github.com/repos/honojs/hono/issues/664/labels{/name}","comments_url":"https://api.github.com/repos/honojs/hono/issues/664/comments","events_url":"https://api.github.com/repos/honojs/hono/issues/664/events","html_url":"https://github.com/honojs/hono/issues/664","id":1451401521,"node_id":"I_kwDOGiE5WM5WgqEx","number":664,"title":"Feature request: support for file upload","user":{"login":"skitsanos","id":1391820,"node_id":"MDQ6VXNlcjEzOTE4MjA=","avatar_url":"https://avatars.githubusercontent.com/u/1391820?v=4","gravatar_id":"","url":"https://api.github.com/users/skitsanos","html_url":"https://github.com/skitsanos","followers_url":"https://api.github.com/users/skitsanos/followers","following_url":"https://api.github.com/users/skitsanos/following{/other_user}","gists_url":"https://api.github.com/users/skitsanos/gists{/gist_id}","starred_url":"https://api.github.com/users/skitsanos/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/skitsanos/subscriptions","organizations_url":"https://api.github.com/users/skitsanos/orgs","repos_url":"https://api.github.com/users/skitsanos/repos","events_url":"https://api.github.com/users/skitsanos/events{/privacy}","received_events_url":"https://api.github.com/users/skitsanos/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":4338084797,"node_id":"LA_kwDOGiE5WM8AAAABApHrvQ","url":"https://api.github.com/repos/honojs/hono/labels/enhancement","name":"enhancement","color":"C5DEF5","default":true,"description":"New feature or request.","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":36,"created_at":"2022-11-16T11:21:06Z","updated_at":"2025-02-21T13:25:32Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"I have a played a bit here with `bun` and `hono` to see how it works and realized that the request body comes there in raw format if I want to upload files.\r\n\r\nsurprisingly, getting body as a buffer worked out of the box:\r\n\r\n```ts\r\n const reader = ctx.req.body.getReader()\r\n const result = await reader.read()\r\n const buffer = Buffer.from(result.value ?? [])\r\n```\r\n\r\nSo I have my `buffer`, but the question is -- do we have anything is there any functionality to have a list of files within that buffer?\r\n\r\nIn other words, - maybe there is an example of implementing file uploading with `hono`, or at least some timeline on when it will be available.\r\n\r\nThank you.","reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/664/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/honojs/hono/issues/664/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0}],"search_type":"lexical"}