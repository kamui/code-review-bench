vacy}","received_events_url":"https://api.github.com/users/arvindbr8/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-19T20:50:03Z","updated_at":"2024-08-19T20:50:03Z","body":"https://github.com/grpc/grpc-go/actions/runs/10460638306/job/28967230530?pr=7537","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2297432231/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2303025806","html_url":"https://github.com/grpc/grpc-go/issues/7241#issuecomment-2303025806","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/7241","id":2303025806,"node_id":"IC_kwDOAacf886JRWKO","user":{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"https://api.github.com/users/dfawley/events{/privacy}","received_events_url":"https://api.github.com/users/dfawley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-21T21:15:01Z","updated_at":"2024-08-21T21:15:01Z","body":"Happened to me today.  Maybe this is more common now for some reason?","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2303025806/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2308500809","html_url":"https://github.com/grpc/grpc-go/issues/7241#issuecomment-2308500809","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/7241","id":2308500809,"node_id":"IC_kwDOAacf886JmO1J","user":{"login":"arjan-bal","id":46515553,"node_id":"MDQ6VXNlcjQ2NTE1NTUz","avatar_url":"https://avatars.githubusercontent.com/u/46515553?v=4","gravatar_id":"","url":"https://api.github.com/users/arjan-bal","html_url":"https://github.com/arjan-bal","followers_url":"https://api.github.com/users/arjan-bal/followers","following_url":"https://api.github.com/users/arjan-bal/following{/other_user}","gists_url":"https://api.github.com/users/arjan-bal/gists{/gist_id}","starred_url":"https://api.github.com/users/arjan-bal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arjan-bal/subscriptions","organizations_url":"https://api.github.com/users/arjan-bal/orgs","repos_url":"https://api.github.com/users/arjan-bal/repos","events_url":"https://api.github.com/users/arjan-bal/events{/privacy}","received_events_url":"https://api.github.com/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-24T19:08:01Z","updated_at":"2024-08-24T19:08:01Z","body":"I suspect what's happening here is that that we're sometimes getting a second load report before the client closes the stream. We're setting the load report interval to 50 ms here: https://github.com/grpc/grpc-go/blob/cfd14baa8264cbeebf6308a7b68333c8c2fc6e86/xds/internal/xdsclient/loadreport_test.go#L106-L109\r\n\r\nIn the final assertion of the test, we're checking that the very next request present in the fake server's request channel is the client cancellation: https://github.com/grpc/grpc-go/blob/cfd14baa8264cbeebf6308a7b68333c8c2fc6e86/xds/internal/xdsclient/loadreport_test.go#L136-L138\r\n\r\nWhen the the test takes more than 50 ms b/w sending the first LRS response with the load report interval and this final assertion, another load report can be sent by the client here: https://github.com/grpc/grpc-go/blob/cfd14baa8264cbeebf6308a7b68333c8c2fc6e86/xds/internal/xdsclient/transport/loadreport.go#L136-L150\r\n\r\nI was able to make the test fail with a similar error message (`loadreport_test.go:139: unexpected LRS request: &{ <nil>}, <nil>, want error canceled`) by adding a `time.Sleep(100 * time.Millisecond)` just after receiving the first LRS request on the server here: https://github.com/grpc/grpc-go/blob/cfd14baa8264cbeebf6308a7b68333c8c2fc6e86/xds/internal/xdsclient/loadreport_test.go#L113-L116\r\n\r\nA possible fix would be to read from `fs2.LRSRequestChan.Receive` until we get an error due to context expiration or see the expected client context cancellation response.\r\n```go\r\n\t// Server should receive a stream canceled error.\r\n\tfor {\r\n\t\tu, err := fs2.LRSRequestChan.Receive(ctx)\r\n\t\tif err != nil {\r\n\t\t\tt.Fatalf(\"unexpected error while reading LRS request: %v\", err)\r\n\t\t}\r\n\t\tif u.(*fakeserver.Request).Err == nil {\r\n\t\t\tcontinue\r\n\t\t}\r\n\t\tif status.Code(u.(*fakeserver.Request).Err) != codes.Canceled {\r\n\t\t\tt.Errorf(\"unexpected LRS request: %v, want error canceled\", u)\r\n\t\t}\r\n\t\tbreak\r\n\t}\r\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2308500809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/2310605499","html_url":"https://github.com/grpc/grpc-go/issues/7241#issuecomment-2310605499","issue_url"