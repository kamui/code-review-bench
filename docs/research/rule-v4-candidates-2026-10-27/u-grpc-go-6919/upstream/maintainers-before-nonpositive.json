ars","html_url":"https://github.com/easwars","followers_url":"https://api.github.com/users/easwars/followers","following_url":"https://api.github.com/users/easwars/following{/other_user}","gists_url":"https://api.github.com/users/easwars/gists{/gist_id}","starred_url":"https://api.github.com/users/easwars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/easwars/subscriptions","organizations_url":"https://api.github.com/users/easwars/orgs","repos_url":"https://api.github.com/users/easwars/repos","events_url":"https://api.github.com/users/easwars/events{/privacy}","received_events_url":"https://api.github.com/users/easwars/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":{"url":"https://api.github.com/repos/grpc/grpc-go/milestones/58","html_url":"https://github.com/grpc/grpc-go/milestone/58","labels_url":"https://api.github.com/repos/grpc/grpc-go/milestones/58/labels","id":10009170,"node_id":"MI_kwDOAacf884AmLpS","number":58,"title":"1.60 Release","description":"","creator":{"login":"ginayeh","id":1888193,"node_id":"MDQ6VXNlcjE4ODgxOTM=","avatar_url":"https://avatars.githubusercontent.com/u/1888193?v=4","gravatar_id":"","url":"https://api.github.com/users/ginayeh","html_url":"https://github.com/ginayeh","followers_url":"https://api.github.com/users/ginayeh/followers","following_url":"https://api.github.com/users/ginayeh/following{/other_user}","gists_url":"https://api.github.com/users/ginayeh/gists{/gist_id}","starred_url":"https://api.github.com/users/ginayeh/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ginayeh/subscriptions","organizations_url":"https://api.github.com/users/ginayeh/orgs","repos_url":"https://api.github.com/users/ginayeh/repos","events_url":"https://api.github.com/users/ginayeh/events{/privacy}","received_events_url":"https://api.github.com/users/ginayeh/received_events","type":"User","user_view_type":"public","site_admin":false},"open_issues":0,"closed_issues":61,"state":"closed","created_at":"2023-10-05T21:35:13Z","updated_at":"2023-12-19T03:28:57Z","due_on":"2023-11-28T00:00:00Z","closed_at":"2023-12-12T00:30:56Z"},"comments":2,"created_at":"2023-12-06T02:32:39Z","updated_at":"2024-07-15T01:49:00Z","closed_at":"2023-12-07T22:04:31Z","assignee":{"login":"easwars","id":1638487,"node_id":"MDQ6VXNlcjE2Mzg0ODc=","avatar_url":"https://avatars.githubusercontent.com/u/1638487?v=4","gravatar_id":"","url":"https://api.github.com/users/easwars","html_url":"https://github.com/easwars","followers_url":"https://api.github.com/users/easwars/followers","following_url":"https://api.github.com/users/easwars/following{/other_user}","gists_url":"https://api.github.com/users/easwars/gists{/gist_id}","starred_url":"https://api.github.com/users/easwars/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/easwars/subscriptions","organizations_url":"https://api.github.com/users/easwars/orgs","repos_url":"https://api.github.com/users/easwars/repos","events_url":"https://api.github.com/users/easwars/events{/privacy}","received_events_url":"https://api.github.com/users/easwars/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":"resolved","draft":false,"pull_request":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/6834","html_url":"https://github.com/grpc/grpc-go/pull/6834","diff_url":"https://github.com/grpc/grpc-go/pull/6834.diff","patch_url":"https://github.com/grpc/grpc-go/pull/6834.patch","merged_at":"2023-12-07T22:04:31Z"},"body":"In https://github.com/grpc/grpc-go/pull/6672, we attempted to configure OS defaults for TCP keepalive parameters (keepalive time and interval). But this had the unintended consequence of disabling TCP keepalives completely because of the way things are implemented in the Go stdlib. In this PR, we attempt to do the following:\r\n\r\nSummary of changes:\r\n- Always enable TCP keepalives on client connections \r\n  - This has been the behavior for a while because the Go stdlib enables TCP keepalives as long as the `net.Dialer.KeepAlive` field is not set to a negative value. \r\n  - Explicitly setting the socket option ensures the old behavior persists.\r\n- Use OS defaults for TCP keepalive interval and time\r\n  - We do this by setting the `net.Dialer.KeepAlive` field to a negative value, thereby disabling the Go stdlib's override of these values to `15s`.\r\n \r\nThere will be a follow-up PR for the server side.\r\n\r\nAddresses https://github.com/grpc/grpc-go/issues/6250\r\n\r\nRELEASE NOTES:\r\n- client: always enable TCP keepalives with OS defaults","reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/6834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc-go/issues/6834/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/6672","repository_url":"https://api.github.com/repos/grpc/grpc-go","labels_url":"https://api.github.com/repos/grpc/grpc-go/issues/6672/labels{/name}","comments_url":"https://api.github.com/repos/grpc/grpc-go/issues/6672/comments","events_url":"https://api.github.com/repos/grpc/grpc-go/issues/6672/events","html_url":"https://github.com/grpc/grpc-go/pull/6672","id":1920680757,"node_id":"PR_kwDOAacf885bm_oF","number":6672,"title":"grpc: disable and document overrides of OS default TCP keepalive by Go","user":{"login":"JaydenTeoh","id":90945854,"node_id":"MDQ6VXNlcjkwOTQ1ODU0","avatar_url":"https://avatars.githubusercontent.com/u/90945854?v=4","gravatar_id":"","url":"https://api.github.com/users/JaydenTeoh","html_url":"https://github.com/JaydenTeoh","followers_url":"https://api.github.com/users/JaydenTeoh/followers","following_url":"https://api.github.com/users/JaydenTeoh/following{/other_user}","gists_url":"h