}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ec9dff77b186d5308955fe0fc50e3e4cbe187e2c","url":"https://api.github.com/repos/Gayathri625/grpc-go-clone/commits/ec9dff77b186d5308955fe0fc50e3e4cbe187e2c","html_url":"https://github.com/Gayathri625/grpc-go-clone/commit/ec9dff77b186d5308955fe0fc50e3e4cbe187e2c"}],"stats":{"total":20,"additions":7,"deletions":13},"files":[{"sha":"b725048a386239acc5b975234b3fc689ed11465c","filename":"examples/features/retry/README.md","status":"modified","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/Gayathri625/grpc-go-clone/blob/566aad1ffd25190a01c160e1a7f4ca645b4896dc/examples%2Ffeatures%2Fretry%2FREADME.md","raw_url":"https://github.com/Gayathri625/grpc-go-clone/raw/566aad1ffd25190a01c160e1a7f4ca645b4896dc/examples%2Ffeatures%2Fretry%2FREADME.md","contents_url":"https://api.github.com/repos/Gayathri625/grpc-go-clone/contents/examples%2Ffeatures%2Fretry%2FREADME.md?ref=566aad1ffd25190a01c160e1a7f4ca645b4896dc","patch":"@@ -41,7 +41,6 @@ RetryableStatusCodes: Retry only when receiving these status codes.\n             \"methodConfig\": [{\n                 // config per method or all methods under service\n                 \"name\": [{\"service\": \"grpc.examples.echo.Echo\"}],\n-                \"waitForReady\": true,\n \n                 \"retryPolicy\": {\n                     \"MaxAttempts\": 4,"},{"sha":"00acc5f7b8142b26cbf68787c3a8b00a630c9bf0","filename":"examples/features/retry/client/main.go","status":"modified","additions":0,"deletions":1,"changes":1,"blob_url":"https://github.com/Gayathri625/grpc-go-clone/blob/566aad1ffd25190a01c160e1a7f4ca645b4896dc/examples%2Ffeatures%2Fretry%2Fclient%2Fmain.go","raw_url":"https://github.com/Gayathri625/grpc-go-clone/raw/566aad1ffd25190a01c160e1a7f4ca645b4896dc/examples%2Ffeatures%2Fretry%2Fclient%2Fmain.go","contents_url":"https://api.github.com/repos/Gayathri625/grpc-go-clone/contents/examples%2Ffeatures%2Fretry%2Fclient%2Fmain.go?ref=566aad1ffd25190a01c160e1a7f4ca645b4896dc","patch":"@@ -36,7 +36,6 @@ var (\n \tretryPolicy = `{\n \t\t\"methodConfig\": [{\n \t\t  \"name\": [{\"service\": \"grpc.examples.echo.Echo\"}],\n-\t\t  \"waitForReady\": true,\n \t\t  \"retryPolicy\": {\n \t\t\t  \"MaxAttempts\": 4,\n \t\t\t  \"InitialBackoff\": \".01s\","},{"sha":"2d562d5728e5e2c16b323dc3a7f7e0df91fd48ba","filename":"rpc_util.go","status":"modified","additions":7,"deletions":11,"changes":18,"blob_url":"https://github.com/Gayathri625/grpc-go-clone/blob/566aad1ffd25190a01c160e1a7f4ca645b4896dc/rpc_util.go","raw_url":"https://github.com/Gayathri625/grpc-go-clone/raw/566aad1ffd25190a01c160e1a7f4ca645b4896dc/rpc_util.go","contents_url":"https://api.github.com/repos/Gayathri625/grpc-go-clone/contents/rpc_util.go?ref=566aad1ffd25190a01c160e1a7f4ca645b4896dc","patch":"@@ -271,17 +271,13 @@ func (o PeerCallOption) after(c *callInfo, attempt *csAttempt) {\n \t}\n }\n \n-// WaitForReady configures the action to take when an RPC is attempted on broken\n-// connections or unreachable servers. If waitForReady is false and the\n-// connection is in the TRANSIENT_FAILURE state, the RPC will fail\n-// immediately. Otherwise, the RPC client will block the call until a\n-// connection is available (or the call is canceled or times out) and will\n-// retry the call if it fails due to a transient error.  gRPC will not retry if\n-// data was written to the wire unless the server indicates it did not process\n-// the data.  Please refer to\n-// https://github.com/grpc/grpc/blob/master/doc/wait-for-ready.md.\n-//\n-// By default, RPCs don't \"wait for ready\".\n+// WaitForReady configures the RPC's behavior when the client is in\n+// TRANSIENT_FAILURE, which occurs when all addresses fail to connect.  If\n+// waitForReady is false, the RPC will fail immediately.  Otherwise, the client\n+// will wait until a connection becomes available or the RPC's deadline is\n+// reached.\n+//\n+// By default, RPCs do not \"wait for ready\".\n func WaitForReady(waitForReady bool) CallOption {\n \treturn FailFastCallOption{FailFast: !waitForReady}\n }"}]}