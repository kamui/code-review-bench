ta) => {})`\r\n\r\nWhere `data.event` is the native event (and now `data.reason`)\r\n\r\nor \r\n\r\n`onOpenChange={(open, event, data) => {})`\r\n\r\nI've changed approach since cloning events is messy, we should avoid mutating native DOM events with custom properties.\r\n\r\nThe handler is now attached to data either way: `data.preventBaseUIHandler()`\r\n\r\nWe could attach the React event as `data.reactEvent` and keep `data.event` as native (not all events are from React props)","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3197498168/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3200105315","html_url":"https://github.com/mui/base-ui/pull/2382#issuecomment-3200105315","issue_url":"https://api.github.com/repos/mui/base-ui/issues/2382","id":3200105315,"node_id":"IC_kwDOLW-eZs6-vbtj","user":{"login":"vladmoroz","id":8441036,"node_id":"MDQ6VXNlcjg0NDEwMzY=","avatar_url":"https://avatars.githubusercontent.com/u/8441036?v=4","gravatar_id":"","url":"https://api.github.com/users/vladmoroz","html_url":"https://github.com/vladmoroz","followers_url":"https://api.github.com/users/vladmoroz/followers","following_url":"https://api.github.com/users/vladmoroz/following{/other_user}","gists_url":"https://api.github.com/users/vladmoroz/gists{/gist_id}","starred_url":"https://api.github.com/users/vladmoroz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vladmoroz/subscriptions","organizations_url":"https://api.github.com/users/vladmoroz/orgs","repos_url":"https://api.github.com/users/vladmoroz/repos","events_url":"https://api.github.com/users/vladmoroz/events{/privacy}","received_events_url":"https://api.github.com/users/vladmoroz/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-19T10:08:49Z","updated_at":"2025-08-19T10:08:49Z","body":"> I've changed approach since cloning events is messy, we should avoid mutating native DOM events with custom properties.\r\n> The handler is now attached to data either way: data.preventBaseUIHandler()\r\n\r\nYeah I much prefer this, the contract is much clearer when the methods like this are on a separate object instead of sneaking it into the event. If you are sticking to `allowPreventDefault, allowStopPropagation`, would a boolean option for preventing the Base UI handler also work?\r\n\r\nI don't care about React events vs native events too much, having access to the native event is enough for me personally.\r\n","author_association":"COLLABORATOR","reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3200105315/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3200372319","html_url":"https://github.com/mui/base-ui/pull/2382#issuecomment-3200372319","issue_url":"https://api.github.com/repos/mui/base-ui/issues/2382","id":3200372319,"node_id":"IC_kwDOLW-eZs6-wc5f","user":{"login":"atomiks","id":22450188,"node_id":"MDQ6VXNlcjIyNDUwMTg4","avatar_url":"https://avatars.githubusercontent.com/u/22450188?v=4","gravatar_id":"","url":"https://api.github.com/users/atomiks","html_url":"https://github.com/atomiks","followers_url":"https://api.github.com/users/atomiks/followers","following_url":"https://api.github.com/users/atomiks/following{/other_user}","gists_url":"https://api.github.com/users/atomiks/gists{/gist_id}","starred_url":"https://api.github.com/users/atomiks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atomiks/subscriptions","organizations_url":"https://api.github.com/users/atomiks/orgs","repos_url":"https://api.github.com/users/atomiks/repos","events_url":"https://api.github.com/users/atomiks/events{/privacy}","received_events_url":"https://api.github.com/users/atomiks/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-08-19T11:31:38Z","updated_at":"2025-08-19T11:31:38Z","body":"> would a boolean option for preventing the Base UI handler also work?\r\n\r\nIf you prevent the entire handler, then you shouldn't need to specify any options right? Options are basically if you want to prevent the handler from also doing something to the event while letting it execute","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3200372319/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]