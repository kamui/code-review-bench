[{"sha":"171ba12f8d59761030dc156ae2fb2db498751dc7","node_id":"C_kwDORPxBDtoAKDE3MWJhMTJmOGQ1OTc2MTAzMGRjMTU2YWUyZmIyZGI0OTg3NTFkYzc","commit":{"author":{"name":"Micka.design","email":"34682172+mickadesign@users.noreply.github.com","date":"2026-10-11T15:41:06Z"},"committer":{"name":"Micka.design","email":"34682172+mickadesign@users.noreply.github.com","date":"2026-10-11T15:41:06Z"},"message":"refactor(motion): install and import the motion package, not framer-motion\n\nRegistry items now declare `motion` and import from `motion/react`, and the\nsite runs motion 14.1. The motion package pins one exact framer-motion\ninside, so an app that installs FF components and wraps itself in\nMotionConfig from motion/react gets a single copy and one shared context.\n\n- every import across registry, site, tests, preset generators and docs\n  snippets moves to motion/react; framer-motion leaves package.json\n- registry.json dependencies: framer-motion -> motion (public/r rebuilt)\n- skill stack check: motion is the requirement now; a direct framer-motion\n  dependency that is not the copy motion pins is flagged, since a second\n  copy splits MotionConfig\n- prose and comments say Motion\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"ace8cab0e70b039d7a5c1056cb4e81544c61af6e","url":"https://api.github.com/repos/mickadesign/fluid-functionalism/git/trees/ace8cab0e70b039d7a5c1056cb4e81544c61af6e"},"url":"https://api.github.com/repos/mickadesign/fluid-functionalism/git/commits/171ba12f8d59761030dc156ae2fb2db498751dc7","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/mickadesign/fluid-functionalism/commits/171ba12f8d59761030dc156ae2fb2db498751dc7","html_url":"https://github.com/mickadesign/fluid-functionalism/commit/171ba12f8d59761030dc156ae2fb2db498751dc7","comments_url":"https://api.github.com/repos/mickadesign/fluid-functionalism/commits/171ba12f8