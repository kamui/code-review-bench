[{"sha":"6e5444749b3d26e7b8af96f020bcca0f61a6f596","node_id":"C_kwDONBtDZ9oAKDZlNTQ0NDc0OWIzZDI2ZTdiOGFmOTZmMDIwYmNjYTBmNjFhNmY1OTY","commit":{"author":{"name":"Lokendra","email":"lokendrakushwah8051@gmail.com","date":"2026-09-16T19:10:18Z"},"committer":{"name":"Lokendra","email":"lokendrakushwah8051@gmail.com","date":"2026-09-16T19:10:18Z"},"message":"Document the 37 fluid-only components\n\nThey shipped in the package but appeared nowhere in the docs. Each now has a\npage, a registry entry, a copy-pasteable shim and a working preview, slotted\ninto the sidebar under a section — including a new Agent section for the\nchat/streaming/reasoning set.\n\nThe previews are ported from fluid-ui's own demos rather than written from\nscratch, so they show the behaviour the components were designed around.\n\nPulling these into apps/www's program surfaced ~135 pre-existing\nnoUncheckedIndexedAccess errors in the fluid sources, which packages/ui had\nopted out of. Almost all traced to a few shared declarations that lost their\nnon-empty guarantee in the type — toRadixValue, the step list, bridgePair's\ndestructure — so they are fixed at the root rather than at each read.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"fd0ab0d0ffecfc189b59ac0ef62e1761102df9d5","url":"https://api.github.com/repos/Lokendrakushwah12/pixa-ui/git/trees/fd0ab0d0ffecfc189b59ac0ef62e1761102df9d5"},"url":"https://api.github.com/repos/Lokendrakushwah12/pixa-ui/git/commits/6e5444749b3d26e7b8af96f020bcca0f61a6f596","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Lokendrakushwah12/pixa-ui/commits/6e5444749b3d26e7b8af96f020bcca0f61a6f596","html_url":"https://github.com/Lokendrakushwah12/pixa-ui/commit/6e5444749b3d26e7b8af96f020bcca0f61a6f596","comments_url":"https://api.github.com/repos/Lokendrakushwah12/pixa-ui/commits/6e5444749b3d26e7b8af96f020bcca0f61a6f596/comments","au