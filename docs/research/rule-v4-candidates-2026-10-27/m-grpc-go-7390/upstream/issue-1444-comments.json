[{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/323181427","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-323181427","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":323181427,"node_id":"MDEyOklzc3VlQ29tbWVudDMyMzE4MTQyNw==","user":{"login":"gyuho","id":6799218,"node_id":"MDQ6VXNlcjY3OTkyMTg=","avatar_url":"https://avatars.githubusercontent.com/u/6799218?v=4","gravatar_id":"","url":"https://api.github.com/users/gyuho","html_url":"https://github.com/gyuho","followers_url":"https://api.github.com/users/gyuho/followers","following_url":"https://api.github.com/users/gyuho/following{/other_user}","gists_url":"https://api.github.com/users/gyuho/gists{/gist_id}","starred_url":"https://api.github.com/users/gyuho/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gyuho/subscriptions","organizations_url":"https://api.github.com/users/gyuho/orgs","repos_url":"https://api.github.com/users/gyuho/repos","events_url":"https://api.github.com/users/gyuho/events{/privacy}","received_events_url":"https://api.github.com/users/gyuho/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-17T20:13:34Z","updated_at":"2017-08-17T20:13:34Z","body":"We will see if we can temporarily mask timed-out endpoint in application layer.\r\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/323181427/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/323817816","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-323817816","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":323817816,"node_id":"MDEyOklzc3VlQ29tbWVudDMyMzgxNzgxNg==","user":{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"https://api.github.com/users/dfawley/events{/privacy}","received_events_url":"https://api.github.com/users/dfawley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-08-21T18:29:18Z","updated_at":"2017-08-21T18:29:18Z","body":"It looks like clients are only waiting for a connection to be made and for the client preface and a settings frame to be sent to the server -- never waiting for the server to send a valid settings frame back -- before attempting to use the connection.  It may make sense to wait for that settings frame before using the connection.  We'd need to do this through a `DialOption`, because this will break cmux users that don't have the [\"workaround for java\"](https://github.com/soheilhy/cmux#limitations) in place.\r\n\r\nFurther, we noticed there are no deadlines on the reads/writes happening during connection initialization, which is problematic -- we should set these to the deadline of the context during this phase.\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/323817816/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/330656655","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-330656655","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":330656655,"node_id":"MDEyOklzc3VlQ29tbWVudDMzMDY1NjY1NQ==","user":{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"https://api.github.com/users/dfawley/events{/privacy}","received_events_url":"https://api.github.com/users/dfawley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-09-19T20:01:38Z","updated_at":"2017-09-19T20:01:38Z","body":"cc @vtubati\r\n\r\nThe changes to implement this are not significant, but we have higher priority things in flight right now.  I expect this to be done within a month.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/330656655/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/337757935","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-337757935","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":337757935,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNzc1NzkzNQ==","user":{"login":"tsuna","id":128281,"node_id":"MDQ6VXNlcjEyODI4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/128281?v=4","gravatar_id":"","url":"https://api.github.com/users/tsuna","html_url":"https://github.com/tsuna","followers_url":"https://api.github.com/users/tsuna/followers","following_url":"https://api.github.com/users/tsuna/following{/other_user}","gists_url":"https://api.github.com/users/tsuna/gists{/gist_id}","starred_url":"https://api.github.com/users/tsuna/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsuna/subscriptions","organizations_url":"https://api.github.com/users/tsuna/orgs","repos_url":"https://api.github.com/users/tsuna/repos","events_url":"https://api.github.com/users/tsuna/events{/privacy}","received_events_url":"https://api.github.com/users/tsuna/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-10-18T23:37:01Z","updated_at":"2017-10-18T23:37:01Z","body":"Any update on this bug?  We regularly run into crazy busy loop situations and I have to manually patch `transportMonitor()` in our vendored code to add a `time.Sleep(1 * time.Second)` at the end of the endless `for` loop in there as a poor man's solution to get gRPC to chill out instead of going crazy.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/337757935/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/337968029","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-337968029","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":337968029,"node_id":"MDEyOklzc3VlQ29tbWVudDMzNzk2ODAyOQ==","user":{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"https://api.github.com/users/dfawley/events{/privacy}","received_events_url":"https://api.github.com/users/dfawley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-10-19T16:46:20Z","updated_at":"2017-10-19T16:46:20Z","body":"Thanks for the ping.  We should hopefully be able to have this done by the end of next week.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/337968029/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/341485325","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-341485325","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":341485325,"node_id":"MDEyOklzc3VlQ29tbWVudDM0MTQ4NTMyNQ==","user":{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"https://api.github.com/users/dfawley/events{/privacy}","received_events_url":"https://api.github.com/users/dfawley/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-11-02T16:48:30Z","updated_at":"2017-11-02T16:48:30Z","body":"We haven't made much progress on this, but it's at the top of our priority list.  Also, we have a slightly different plan:\r\n\r\n1. As before, add a `DialOption` to block in the client until a settings frame is received from the server before sending RPCs on the connection.\r\n\r\n2. The new part: even if the option is _not_ set, do not consider the connection \"good\" (and consequently reset the backoff timer) until a settings frame is received from the server.  We would still proceed to send RPCs on this connection immediately, as we do today.  But if a failure occurs before a settings frame is received, we will resume connecting to alternate backends and backoff with the same deadline as if the initial server never connected at all.\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/341485325/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/344927314","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-344927314","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":344927314,"node_id":"MDEyOklzc3VlQ29tbWVudDM0NDkyNzMxNA==","user":{"login":"anshupitlia","id":8578665,"node_id":"MDQ6VXNlcjg1Nzg2NjU=","avatar_url":"https://avatars.githubusercontent.com/u/8578665?v=4","gravatar_id":"","url":"https://api.github.com/users/anshupitlia","html_url":"https://github.com/anshupitlia","followers_url":"https://api.github.com/users/anshupitlia/followers","following_url":"https://api.github.com/users/anshupitlia/following{/other_user}","gists_url":"https://api.github.com/users/anshupitlia/gists{/gist_id}","starred_url":"https://api.github.com/users/anshupitlia/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anshupitlia/subscriptions","organizations_url":"https://api.github.com/users/anshupitlia/orgs","repos_url":"https://api.github.com/users/anshupitlia/repos","events_url":"https://api.github.com/users/anshupitlia/events{/privacy}","received_events_url":"https://api.github.com/users/anshupitlia/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-11-16T13:47:43Z","updated_at":"2017-11-16T13:47:43Z","body":"Any update on this? ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/344927314/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/348316266","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-348316266","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":348316266,"node_id":"MDEyOklzc3VlQ29tbWVudDM0ODMxNjI2Ng==","user":{"login":"tsuna","id":128281,"node_id":"MDQ6VXNlcjEyODI4MQ==","avatar_url":"https://avatars.githubusercontent.com/u/128281?v=4","gravatar_id":"","url":"https://api.github.com/users/tsuna","html_url":"https://github.com/tsuna","followers_url":"https://api.github.com/users/tsuna/followers","following_url":"https://api.github.com/users/tsuna/following{/other_user}","gists_url":"https://api.github.com/users/tsuna/gists{/gist_id}","starred_url":"https://api.github.com/users/tsuna/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tsuna/subscriptions","organizations_url":"https://api.github.com/users/tsuna/orgs","repos_url":"https://api.github.com/users/tsuna/repos","events_url":"https://api.github.com/users/tsuna/events{/privacy}","received_events_url":"https://api.github.com/users/tsuna/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-11-30T20:48:25Z","updated_at":"2017-11-30T20:48:25Z","body":"Any update please?  This is a problem with the client busy-looping when connecting to a TCP reverse-proxy like haproxy that accepts the connection and has no other choice than closing it if no backend is healthy.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/348316266/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/348320071","html_url":"https://github.com/grpc/grpc-go/issues/1444#issuecomment-348320071","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/1444","id":348320071,"node_id":"MDEyOklzc3VlQ29tbWVudDM0ODMyMDA3MQ==","user":{"login":"MakMukhi","id":20670279,"node_id":"MDQ6VXNlcjIwNjcwMjc5","avatar_url":"https://avatars.githubusercontent.com/u/20670279?v=4","gravatar_id":"","url":"https://api.github.com/users/MakMukhi","html_url":"https://github.com/MakMukhi","followers_url":"https://api.github.com/users/MakMukhi/followers","following_url":"https://api.github.com/users/MakMukhi/following{/other_user}","gists_url":"https://api.github.com/users/MakMukhi/gists{/gist_id}","starred_url":"https://api.github.com/users/MakMukhi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MakMukhi/subscriptions","organizations_url":"https://api.github.com/users/MakMukhi/orgs","repos_url":"https://api.