[{"sha":"816ea69cb8d24df97611935384d380a752c14e0f","node_id":"C_kwDOAD-LgtoAKDgxNmVhNjljYjhkMjRkZjk3NjExOTM1Mzg0ZDM4MGE3NTJjMTRlMGY","commit":{"author":{"name":"Jacob Rief","email":"jacob.rief@gmail.com","date":"2026-10-22T12:26:30Z"},"committer":{"name":"nessita","email":"124304+nessita@users.noreply.github.com","date":"2026-10-23T13:32:18Z"},"message":"Refs #30949 -- Replaced django.utils.functional.cached_property with functools.cached_property.\n\nSince Python 3.12, `functools.cached_property` no longer takes a lock\n(https://github.com/python/cpython/issues/87634), which was the main\nobjection to using it instead of Django's own implementation.\n\n`Prefetch(to_attr=...)` and the admindocs model detail page now accept\n`functools.cached_property` as well as Django's own `cached_property`.\n\nCo-authored-by: Natalia <124304+nessita@users.noreply.github.com>","tree":{"sha":"7662a128602655431060fe89d2f257d86bf083cc","url":"https://api.github.com/repos/django/django/git/trees/7662a128602655431060fe89d2f257d86bf083cc"},"url":"https://api.github.com/repos/django/django/git/commits/816ea69cb8d24df97611935384d380a752c14e0f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/django/django/commits/816ea69cb8d24df97611935384d380a752c14e0f","html_url":"https://github.com/django/django/commit/816ea69cb8d24df97611935384d380a752c14e0f","comments_url":"https://api.github.com/repos/django/django/commits/816ea69cb8d24df97611935384d380a752c14e0f/comments","author":{"login":"jrief","id":1132472,"node_id":"MDQ6VXNlcjExMzI0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1132472?v=4","gravatar_id":"","url":"https://api.github.com/users/jrief","html_url":"https://github.com/jrief","followers_url":"https://api.github.com/users/jrief/followers","following_url":"https://api.github.com/users/jrief/following{/other_user}","gists_url":"https://api.github.com/users/jrief/g