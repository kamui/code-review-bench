[
  {
    "name": "public-code-zshenv-targeted",
    "command": [
      "gh",
      "api",
      "--method",
      "GET",
      "search/code",
      "-f",
      "q=compinit filename:.zshenv -skip_global_compinit",
      "-f",
      "per_page=10"
    ],
    "exit": 0
  },
  {
    "name": "public-code-ret-exact",
    "command": [
      "gh",
      "api",
      "--method",
      "GET",
      "search/code",
      "-f",
      "q=\"ret=XX\" language:Shell",
      "-f",
      "per_page=10"
    ],
    "exit": 0
  },
  {
    "name": "public-code-test-script",
    "command": [
      "gh",
      "api",
      "--method",
      "GET",
      "search/code",
      "-f",
      "q=\"get_comp_args\" repo:BurntSushi/ripgrep",
      "-f",
      "per_page=10"
    ],
    "exit": 0
  }
]
