hub.com/users/RussellSanders1/events{/privacy}","received_events_url":"https://api.github.com/users/RussellSanders1/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-08T00:11:09Z","updated_at":"2023-09-08T00:11:09Z","body":"I saw a similar issue which suggested manually parsing form data, so it’s not a priority for me. Thanks!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1710909341/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1710912493","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1710912493","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1710912493,"node_id":"IC_kwDOGiE5WM5l-nPt","user":{"login":"Abdillah","id":3030950,"node_id":"MDQ6VXNlcjMwMzA5NTA=","avatar_url":"https://avatars.githubusercontent.com/u/3030950?v=4","gravatar_id":"","url":"https://api.github.com/users/Abdillah","html_url":"https://github.com/Abdillah","followers_url":"https://api.github.com/users/Abdillah/followers","following_url":"https://api.github.com/users/Abdillah/following{/other_user}","gists_url":"https://api.github.com/users/Abdillah/gists{/gist_id}","starred_url":"https://api.github.com/users/Abdillah/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Abdillah/subscriptions","organizations_url":"https://api.github.com/users/Abdillah/orgs","repos_url":"https://api.github.com/users/Abdillah/repos","events_url":"https://api.github.com/users/Abdillah/events{/privacy}","received_events_url":"https://api.github.com/users/Abdillah/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-08T00:15:53Z","updated_at":"2023-09-08T00:16:26Z","body":"> this doesn't answer the question, as the question is clearly about [req.parseBody()](https://hono.dev/api/request#parsebody).\r\n\r\nBecause parseBody and queries may have the same format, I hope both enable single key multiple value parsing to array.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1710912493/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1712798526","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1712798526","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1712798526,"node_id":"IC_kwDOGiE5WM5mFzs-","user":{"login":"yusukebe","id":10682,"node_id":"MDQ6VXNlcjEwNjgy","avatar_url":"https://avatars.githubusercontent.com/u/10682?v=4","gravatar_id":"","url":"https://api.github.com/users/yusukebe","html_url":"https://github.com/yusukebe","followers_url":"https://api.github.com/users/yusukebe/followers","following_url":"https://api.github.com/users/yusukebe/following{/other_user}","gists_url":"https://api.github.com/users/yusukebe/gists{/gist_id}","starred_url":"https://api.github.com/users/yusukebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-10T12:15:23Z","updated_at":"2023-09-10T12:15:23Z","body":"I think this implementation is good, if passing the `all: true` as an option, it return multiple values as an array:\r\n\r\n```ts\r\nc.req.parseBody({ all: true })\r\n```\r\n\r\nWith this way, it will not be a breaking change.\r\n\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1712798526/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1728923456","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1728923456","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1728923456,"node_id":"IC_kwDOGiE5WM5nDUdA","user":{"login":"rimai4","id":12866372,"node_id":"MDQ6VXNlcjEyODY2Mzcy","avatar_url":"https://avatars.githubusercontent.com/u/12866372?v=4","gravatar_id":"","url":"https://api.github.com/users/rimai4","html_url":"https://github.com/rimai4","followers_url":"https://api.github.com/users/rimai4/followers","following_url":"https://api.github.com/users/rimai4/following{/other_user}","gists_url":"https://api.github.com/users/rimai4/gists{/gist_id}","starred_url":"https://api.github.com/users/rimai4/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rimai4/subscriptions","organizations_url":"https://api.github.com/users/rimai4/orgs","repos_url":"https://api.github.com/users/rimai4/repos","events_url":"https://api.github.com/users/rimai4/events{/privacy}","received_events_url":"https://api.github.com/users/rimai4/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-21T06:20:25Z","updated_at":"2023-09-21T06:20:25Z","body":"I ran into this as well. \r\n\r\nI think it would be better to parse multiple keys into an array by default for consistency & predictability. `{ all: true }` is inconsistent with the way Hono handles queries. Parsing multiple keys into an array by default also makes it clear for users what to expect: post a key once if you want a single value and post it multiple times if you want an array.\r\n\r\nThe `{ all: true }` option also would mean that the validator & zValidator middleware would need this argument as well.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1728923456/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1730339399","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1730339399","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1730339399,"node_id":"IC_kwDOGiE5WM5nIuJH","user":{"login":"yusukebe","id":10682,"node_id":"MDQ6VXNlcjEwNjgy","avatar_url":"https://avatars.githubusercontent.com/u/10682?v=4","gravatar_id":"","url":"https://api.github.com/users/yusukebe","html_url":"https://github.com/yusukebe","followers_url":"https://api.github.com/users/yusukebe/followers","following_url":"https://api.github.com/users/yusukebe/following{/other_user}","gists_url":"https://api.github.com/users/yusukebe/gists{/gist_id}","starred_url":"https://api.github.com/users/yusukebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-21T21:41:21Z","updated_at":"2023-09-21T22:01:09Z","body":"The PR #1488 may resolve this issue.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1730339399/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1730356182","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1730356182","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1730356182,"node_id":"IC_kwDOGiE5WM5nIyPW","user":{"login":"yusukebe","id":10682,"node_id":"MDQ6VXNlcjEwNjgy","avatar_url":"https://avatars.githubusercontent.com/u/10682?v=4","gravatar_id":"","url":"https://api.github.com/users/yusukebe","html_url":"https://github.com/yusukebe","followers_url":"https://api.github.com/users/yusukebe/followers","following_url":"https://api.github.com/users/yusukebe/following{/other_user}","gists_url":"https://api.github.com/users/yusukebe/gists{/gist_id}","starred_url":"https://api.github.com/users/yusukebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-09-21T22:00:43Z","updated_at":"2023-09-21T22:17:01Z","body":"My concern is that the user expects an array to come in, but a single value comes in and it is not an array. This is not the behavior the user expects.\r\n\r\nSo I suggested `{ all: true }`. When using a validator, the user specifies whether it is an array or not, so the `all` option is not necessary.\r\n\r\nThe same reason why `FormData` has `get()` and `getAll()`.\r\n\r\nhttps://developer.mozilla.org/en-US/docs/Web/API/FormData/get\r\nhttps://developer.mozilla.org/en-US/docs/Web/API/FormData/getAll\r\n\r\nNevertheless, it can be solved if the user checks if it’s an array or not.\r\n\r\n```ts\r\napp.post('/', async (c) => {\r\n  const { tests } = await c.req.parseBody()\r\n  if (Array.isArray(tests)) {\r\n    //...\r\n  } else {\r\