[{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1521928247","html_url":"https://github.com/honojs/hono/issues/1018#issuecomment-1521928247","issue_url":"https://api.github.com/repos/honojs/hono/issues/1018","id":1521928247,"node_id":"IC_kwDOGiE5WM5atsg3","user":{"login":"bogordesaincom","id":51335197,"node_id":"MDQ6VXNlcjUxMzM1MTk3","avatar_url":"https://avatars.githubusercontent.com/u/51335197?v=4","gravatar_id":"","url":"https://api.github.com/users/bogordesaincom","html_url":"https://github.com/bogordesaincom","followers_url":"https://api.github.com/users/bogordesaincom/followers","following_url":"https://api.github.com/users/bogordesaincom/following{/other_user}","gists_url":"https://api.github.com/users/bogordesaincom/gists{/gist_id}","starred_url":"https://api.github.com/users/bogordesaincom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bogordesaincom/subscriptions","organizations_url":"https://api.github.com/users/bogordesaincom/orgs","repos_url":"https://api.github.com/users/bogordesaincom/repos","events_url":"https://api.github.com/users/bogordesaincom/events{/privacy}","received_events_url":"https://api.github.com/users/bogordesaincom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-04-25T14:50:31Z","updated_at":"2023-04-25T14:50:42Z","body":"please see https://hono.dev/api/request \r\n\r\n```js\r\n// Captured params\r\napp.get('/entry/:id', (c) => {\r\n  const id = c.req.param('id')\r\n  ...\r\n})\r\n\r\n// Get all params at once\r\napp.get('/entry/:id/comment/:commentId', (c) => {\r\n  const { id, commentId } = c.req.param()\r\n})\r\n\r\n```","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1521928247/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs