over.\r\n\r\nhttps://github.com/grpc/grpc-go/blob/36d87572dba304d444361ca3ddc77d5a9c0f831c/balancer_conn_wrappers.go#L245-L248","reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/4881/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc-go/issues/4881/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/4879","repository_url":"https://api.github.com/repos/grpc/grpc-go","labels_url":"https://api.github.com/repos/grpc/grpc-go/issues/4879/labels{/name}","comments_url":"https://api.github.com/repos/grpc/grpc-go/issues/4879/comments","events_url":"https://api.github.com/repos/grpc/grpc-go/issues/4879/events","html_url":"https://github.com/grpc/grpc-go/pull/4879","id":1027663454,"node_id":"PR_kwDOAacf884tQ1XD","number":4879,"title":"grpclb: recover after receiving an empty server list","user":{"login":"menghanl","id":960845,"node_id":"MDQ6VXNlcjk2MDg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/960845?v=4","gravatar_id":"","url":"https://api.github.com/users/menghanl","html_url":"https://github.com/menghanl","followers_url":"https://api.github.com/users/menghanl/followers","following_url":"https://api.github.com/users/menghanl/following{/other_user}","gists_url":"https://api.github.com/users/menghanl/gists{/gist_id}","starred_url":"https://api.github.com/users/menghanl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/menghanl/subscriptions","organizations_url":"https://api.github.com/users/menghanl/orgs","repos_url":"https://api.github.com/users/menghanl/repos","events_url":"https://api.github.com/users/menghanl/events{/privacy}","received_events_url":"https://api.github.com/users/menghanl/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":586671344,"node_id":"M