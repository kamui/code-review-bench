om/users/purnesh42H/followers","following_url":"https://api.github.com/users/purnesh42H/following{/other_user}","gists_url":"https://api.github.com/users/purnesh42H/gists{/gist_id}","starred_url":"https://api.github.com/users/purnesh42H/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/purnesh42H/subscriptions","organizations_url":"https://api.github.com/users/purnesh42H/orgs","repos_url":"https://api.github.com/users/purnesh42H/repos","events_url":"https://api.github.com/users/purnesh42H/events{/privacy}","received_events_url":"https://api.github.com/users/purnesh42H/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Oh I was just asking with respect to release notes because currently the bug points to test flake. Anyways, I just checked it doesn't matter because release notes refer to the fix PR and not the issue. Although in the release notes, we should prefix the package\r\n\r\n`balancer: Fix race condition that could lead to multiple transports being created in parallel`","created_at":"2024-07-04T09:01:56Z","updated_at":"2024-07-04T09:01:57Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665384768","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665384768"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665384768"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665384768/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665403839","pull_request_review_id":2158417417,"id":1665403839,"node_id":"PRRC_kwDOAacf885jRAu_","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"purnesh42H","id":12795451,"node_id":"MDQ6VXNlcjEyNzk1NDUx","avatar_url":"https://avatars.githubusercontent.com/u/12795451?v=4","gravatar_id":"","url":"https://api.github.com/users/purnesh42H","html_url":"https://github.com/purnesh42H","followers_url":"https://api.github.com/users/purnesh42H/followers","following_url":"https://api.github.com/users/purnesh42H/following{/other_user}","gists_url":"https://api.github.com/users/purnesh42H/gists{/gist_id}","starred_url":"https://api.github.com/users/purnesh42H/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/purnesh42H/subscriptions","organizations_url":"https://api.github.com/users/purnesh42H/orgs","repos_url":"https://api.github.com/users/purnesh42H/repos","events_url":"https://api.github.com/users/purnesh42H/events{/privacy}","received_events_url":"https://api.github.com/users/purnesh42H/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Also, it looks like without your fix, there is a case where resetTransport can error out and return without updating the connectivity state https://github.com/grpc/grpc-go/blob/bdd707e642e40cf75db5ac3f0f6af48077f48368/clientconn.go#L1237\r\n\r\nMay be we can make the resetTransport() in the same critical section instead of releasing lock and aquiring again in resetTransport()?","created_at":"2024-07-04T09:15:58Z","updated_at":"2024-07-04T09:16:01Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665403839","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665403839"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665403839"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665403839/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665531034","pull_request_review_id":2158634941,"id":1665531034,"node_id":"PRRC_kwDOAacf885jRfya","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"arjan-bal","id":46515553,"node_id":"MDQ6VXNlcjQ2NTE1NTUz","avatar_url":"https://avatars.githubusercontent.com/u/46515553?v=4","gravatar_id":"","url":"https://api.github.com/users/arjan-bal","html_url":"https://github.com/arjan-bal","followers_url":"https://api.github.com/users/arjan-bal/followers","following_url":"https://api.github.com/users/arjan-bal/following{/other_user}","gists_url":"https://api.github.com/users/arjan-bal/gists{/gist_id}","starred_url":"https://api.github.com/users/arjan-bal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arjan-bal/subscriptions","organizations_url":"https://api.github.com/users/arjan-bal/orgs","repos_url":"https://api.github.com/users/arjan-bal/repos","events_url":"https://api.github.com/users/arjan-bal/events{/privacy}","received_events_url":"https://api.github.com/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"I don't see any benefit in adding the `acCtcx.Err` check in `connect` because even resetTransport sets the the state to `Connecting` and releases the lock:\r\nhttps://github.com/grpc/grpc-go/blob/bdd707e642e40cf75db5ac3f0f6af48077f48368/clientconn.go#L1262-L1263\r\n\r\nThis means that the context can be cancelled (and subsequently addrConn shutdown) after the channel is in `connecting` state even without the change.\r\n\r\nIIUC we just need to ensure that we don't set connecting state after the channel enters shutdown.\r\n\r\nThe test for shutdown state on top should be enough protection to ensure shutdown state comes only after we enter `connecting`.","created_at":"2024-07-04T10:51:59Z","updated_at":"2024-07-04T10:51:59Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665531034","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665531034"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665531034"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665531034/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665560040","pull_request_review_id":2158685449,"id":1665560040,"node_id":"PRRC_kwDOAacf885jRm3o","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"arjan-bal","id":46515553,"node_id":"MDQ6VXNlcjQ2NTE1NTUz","avatar_url":"https://avatars.githubusercontent.com/u/46515553?v=4","gravatar_id":"","url":"https://api.github.com/users/arjan-bal","html_url":"https://github.com/arjan-bal","followers_url":"https://api.github.com/users/arjan-bal/followers","following_url":"https://api.github.com/users/arjan-bal/following{/other_user}","gists_url":"https://api.github.com/users/arjan-bal/gists{/gist_id}","starred_url":"https://api.github.com/users/arjan-bal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arjan-bal/subscriptions","organizations_url":"https://api.github.com/users/arjan-bal/orgs","repos_url":"https://api.github.com/users/arjan-bal/repos","events_url":"https://api.github.com/users/arjan-bal/events{/privacy}","received_events_url":"https://api.github.com/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> May be we can make the resetTransport() in the same critical section instead of releasing lock and aquiring again in resetTransport()?\r\n\r\nWe could rename `resetTransport` to `resetTransportLocked` and expect the callers to hold the lock while calling this method. However, `resetTransport` releases the lock temporarily. Add to this that ac.updateAddrs calls `resetTransport` in a new go routine so it can't hold the lock till `resetTransport` completes. It feels a little risky to make that change. I don't know for sure, but I feel we could end up in a situation where the lock is not released correctly resulting in a deadlock. \r\n\r\nI don't want do make that change as the first option.","created_at":"2024-07-04T11:17:17Z","updated_at":"2024-07-04T12:21:36Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665560040","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665560040"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1665560040"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1665560040/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666265411","pull_request_review_id":2159790632,"id":1666265411,"node_id":"PRRC_kwDOAacf885jUTFD","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"purnesh42H","id":12795451,"node_id":"MDQ6VXNlcjEyNzk1NDUx","avatar_url":"https://avatars.githubusercontent.com/u/12795451?v=4","gravatar_id":"","url":"https://api.github.com/users/purnesh42H","html_url":"https://github.com/purnesh42H","followers_url":"https://api.github.com/users/purnesh42H/followers","following_url":"https://api.github.com/users/purnesh42H/following{/other_user}","gists_url":"https://api.github.com/users/purnesh42H/gists{/gist_id}","starred_url":"https://api.github.com/users/purnesh42H/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/purnesh42H/subscriptions","organizations_url":"https://api.github.com/users/purnesh42H/orgs","repos_url":"https://api.github.com/users/purnesh42H/repos","events_url":"https://api.github.com/users/purnesh42H/events{/privacy}","received_events_url":"https://api.github.com/users/purnesh42H/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> I don't see any benefit in adding the acCtcx.Err check in connect because even resetTransport sets the the state to Connecting and releases the lock\r\n\r\nFrom the code it looks like in case of `acCtcx.Err`, resetTransport() doesn't update the state and return so state will be still idle but after your fix in case of `acCtcx.Err` state will be updated to `connecting`. Am I missing something?","created_at":"2024-07-05T04:30:30Z","updated_at":"2024-07-05T04:30:33Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1666265411","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666265411"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1666265411"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666265411/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666381203","pull_request_review_id":2160027239,"id":1666381203,"node_id":"PRRC_kwDOAacf885jUvWT","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"arjan-bal","id":46515553,"node_id":"MDQ6VXNlcjQ2NTE1NTUz","avatar_url":"https://avatars.githubusercontent.com/u/46515553?v=4","gravatar_id":"","url":"https://api.github.com/users/arjan-bal","html_url":"https://github.com/arjan-bal","followers_url":"https://api.github.com/users/arjan-bal/followers","following_url":"https://api.github.com/users/arjan-bal/following{/other_user}","gists_url":"https://api.github.com/users/arjan-bal/gists{/gist_id}","starred_url":"https://api.github.com/users/arjan-bal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arjan-bal/subscriptions","organizations_url":"https://api.github.com/users/arjan-bal/orgs","repos_url":"https://api.github.com/users/arjan-bal/repos","events_url":"https://api.github.com/users/arjan-bal/events{/privacy}","received_events_url":"https://api.github.com/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"From my understanding, `ac.ctx` is used to control the creation of remote connections while `ac.state` is used to synchronize all the state transitions for the `addrConn`. `ac.connect()` doesn't deal with creating remote connections, so it doesn't need to check `ac.ctx.Err()`. It needs to ensure the transition to `Connecting` is valid, which it does by locking the mutex and verifying that `ac.state != Shutdown`\r\n\r\n`ac.ctx` is used to avoid doing throw away work which takes significant time (creating a remote conn).\r\n\r\nPlease let me know if your understanding is different.","created_at":"2024-07-05T06:30:33Z","updated_at":"2024-07-05T06:30:33Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1666381203","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666381203"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1666381203"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1666381203/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":null,"original_line":923,"side":"RIGHT","in_reply_to_id":1665323860,"author_association":"CONTRIBUTOR","original_position":6,"position":1,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1668478364","pull_request_review_id":2163055670,"id":1668478364,"node_id":"PRRC_kwDOAacf885jcvWc","diff_hunk":"@@ -918,6 +918,9 @@ func (ac *addrConn) connect() error {\n \t\tac.mu.Unlock()\n \t\treturn nil\n \t}\n+\t// Update the state to ensure no concurrent requests start once the lock\n+\t// is released.\n+\tac.updateConnectivityState(connectivity.Connecting, nil)","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"c3a3d1c48adcf492696029fa946d606e5e7ba40a","user":{"login":"purnesh42H","id":12795451,"node_id":"MDQ6VXNlcjEyNzk1NDUx","avatar_url":"https://avatars.githubusercontent.com/u/12795451?v=4","gravatar_id":"","url":"https://api.github.com/users/purnesh42H","html_url":"https://github.com/purnesh42H","followers_url":"https://api.github.com/users/purnesh42H/followers","following_url":"https://api.github.com/users/purnesh42H/following{/other_user}","gists_url":"https://api.github.com/users/purnesh42H/gists{/gist_id}"