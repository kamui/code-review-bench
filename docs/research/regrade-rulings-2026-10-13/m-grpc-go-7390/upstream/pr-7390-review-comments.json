om/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Add the doc comment.","created_at":"2024-07-09T06:26:40Z","updated_at":"2024-07-09T06:26:40Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669810260","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669810260"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669810260"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669810260/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1234,"original_line":1231,"side":"RIGHT","in_reply_to_id":1669193136,"author_association":"CONTRIBUTOR","original_position":30,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669816419","pull_request_review_id":2165179455,"id":1669816419,"node_id":"PRRC_kwDOAacf885jh2Bj","diff_hunk":"@@ -1231,8 +1228,7 @@ func (ac *addrConn) adjustParams(r transport.GoAwayReason) {\n \t}\n }\n \n-func (ac *addrConn) resetTransport() {\n-\tac.mu.Lock()\n+func (ac *addrConn) resetTransportAndUnlock() {","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"6214c9dd1cd421727852b03cafceac7c9e9eb973","user":{"login":"arjan-bal","id":46515553,"node_id":"MDQ6VXNlcjQ2NTE1NTUz","avatar_url":"https://avatars.githubusercontent.com/u/46515553?v=4","gravatar_id":"","url":"https://api.github.com/users/arjan-bal","html_url":"https://github.com/arjan-bal","followers_url":"https://api.github.com/users/arjan-bal/followers","following_url":"https://api.github.com/users/arjan-bal/following{/other_user}","gists_url":"https://api.github.com/users/arjan-bal/gists{/gist_id}","starred_url":"https://api.github.com/users/arjan-bal/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/arjan-bal/subscriptions","organizations_url":"https://api.github.com/users/arjan-bal/orgs","repos_url":"https://api.github.com/users/arjan-bal/repos","events_url":"https://api.github.com/users/arjan-bal/events{/privacy}","received_events_url":"https://api.github.com/users/arjan-bal/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"> should we have code check for this as well?\r\n\r\nWe don't verify if the mutex is locked in other functions in the code which assume the caller has the lock. These functions have the suffix `Locked` in the name. \r\n* There is a `TryLock()` method on `sync/mutex`, but its use is discouraged. \r\n* `resetTransportAndUnlock` is a private method and we run tests with race detector so we can catch incorrect usage.\r\n* When the `resetTransportAndUnlock` method tries to unlock a mutex that isn't locked, it will panic.","created_at":"2024-07-09T06:32:24Z","updated_at":"2024-07-09T06:32:58Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669816419","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669816419"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669816419"},"pull_request":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/7390"}},"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669816419/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":1234,"original_line":1231,"side":"RIGHT","in_reply_to_id":1669193136,"author_association":"CONTRIBUTOR","original_position":30,"position":33,"subject_type":"line"},{"url":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669817008","pull_request_review_id":2165180354,"id":1669817008,"node_id":"PRRC_kwDOAacf885jh2Kw","diff_hunk":"@@ -1231,8 +1228,7 @@ func (ac *addrConn) adjustParams(r transport.GoAwayReason) {\n \t}\n }\n \n-func (ac *addrConn) resetTransport() {\n-\tac.mu.Lock()\n+func (ac *addrConn) resetTransportAndUnlock() {","path":"clientconn.go","commit_id":"76ef33f44a600c3ed1a385979fd1dfbcade3fbb6","original_commit_id":"6214c9dd1cd421727852b03cafceac7c9e9eb973","user":{"login":"purnesh42H","id":12795451,"node_id":"MDQ6VXNlcjEyNzk1NDUx","avatar_url":"https://avatars.githubusercontent.com/u/12795451?v=4","gravatar_id":"","url":"https://api.github.com/users/purnesh42H","html_url":"https://github.com/purnesh42H","followers_url":"https://api.github.com/users/purnesh42H/followers","following_url":"https://api.github.com/users/purnesh42H/following{/other_user}","gists_url":"https://api.github.com/users/purnesh42H/gists{/gist_id}","starred_url":"https://api.github.com/users/purnesh42H/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/purnesh42H/subscriptions","organizations_url":"https://api.github.com/users/purnesh42H/orgs","repos_url":"https://api.github.com/users/purnesh42H/repos","events_url":"https://api.github.com/users/purnesh42H/events{/privacy}","received_events_url":"https://api.github.com/users/purnesh42H/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"i meant just having a doc doesn't enforce the mutex should be locked. Unlocking a mutex that is not locked in Go will result in a runtime panic. ","created_at":"2024-07-09T06:33:02Z","updated_at":"2024-07-09T06:33:33Z","html_url":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669817008","pull_request_url":"https://api.github.com/repos/grpc/grpc-go/pulls/7390","_links":{"self":{"href":"https://api.github.com/repos/grpc/grpc-go/pulls/comments/1669817008"},"html":{"href":"https://github.com/grpc/grpc-go/pull/7390#discussion_r1669817008"}