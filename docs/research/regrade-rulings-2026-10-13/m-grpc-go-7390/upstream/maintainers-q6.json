zNQ==","avatar_url":"https://avatars.githubusercontent.com/u/514535?v=4","gravatar_id":"","url":"https://api.github.com/users/fho","html_url":"https://github.com/fho","followers_url":"https://api.github.com/users/fho/followers","following_url":"https://api.github.com/users/fho/following{/other_user}","gists_url":"https://api.github.com/users/fho/gists{/gist_id}","starred_url":"https://api.github.com/users/fho/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fho/subscriptions","organizations_url":"https://api.github.com/users/fho/orgs","repos_url":"https://api.github.com/users/fho/repos","events_url":"https://api.github.com/users/fho/events{/privacy}","received_events_url":"https://api.github.com/users/fho/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":6,"created_at":"2021-12-08T11:56:09Z","updated_at":"2022-06-12T02:04:07Z","closed_at":"2021-12-13T09:39:57Z","assignee":{"login":"fho","id":514535,"node_id":"MDQ6VXNlcjUxNDUzNQ==","avatar_url":"https://avatars.githubusercontent.com/u/514535?v=4","gravatar_id":"","url":"https://api.github.com/users/fho","html_url":"https://github.com/fho","followers_url":"https://api.github.com/users/fho/followers","following_url":"https://api.github.com/users/fho/following{/other_user}","gists_url":"https://api.github.com/users/fho/gists{/gist_id}","starred_url":"https://api.github.com/users/fho/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fho/subscriptions","organizations_url":"https://api.github.com/users/fho/orgs","repos_url":"https://api.github.com/users/fho/repos","events_url":"https://api.github.com/users/fho/events{/privacy}","received_events_url":"https://api.github.com/users/fho/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Hello,\r\n\r\nI'm implementing a custom [resolver](https://github.com/simplesurance/grpcconsulresolver) that queries a Consul server to resolve a target.\r\nIt can happen that a service is unregistered in Consul and therefore the set of known addresses for a target changes to none.\r\nWhen this happens I'm calling `UpdateState` with an empty address slice.\r\n`UpdateState` then returns in response a `ErrBadResolverState` error.\r\n\r\nBecause `UpdateState()` returned an error my resolver starts to poll consul and call `UpdateState` periodically again (also with empty addresses).  This behavior is broken.\r\nDespite that `UpdateState()` returns an error, grpc-go seems to handle it as expected.\r\nIt triggers reresolving periodically again via `ResolveNow`.\r\n\r\nIs this a bug in grpc-go and it should not return an error when a resolver submits an empty set of address?\r\nOtherwise what behavior is expected by the resolver when all addresses for a host vanish?\r\n\r\nI'm using grpc-go version 1.42.","reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/5048/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc-go/issues/5048/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/3491","repository_url":"https://api.github.com/repos/grpc/grpc-go","labels_url":"https://api.github.com/repos/grpc/grpc-go/issues/3491/labels{/name}","comments_url":"https://api.github.com/repos/grpc/grpc-go/issues/3491/comments","events_url":"https://api.github.com/repos/grpc/grpc-go/issues/3491/events","html_url":"https://github.com/grpc/grpc-go/pull/3491","id":591496220,"node_id":"MDExOlB1bGxSZXF1ZXN0Mzk2NjYxMTI0","number":3491,"title":"balancer: change roundrobin to accept empty address list","user":{"login":"menghanl","id":960845,"node_id":"MDQ6VXNlcjk2MDg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/960845?v=4","gravatar_id":"","url":"https://api.github.com/users/menghanl","html_url":"https://github.com/menghanl","followers_url":"https://api.github.com/users/menghanl/followers","following_url":"https://api.github.com/users/menghanl/following{/other_user}","gists_url":"https://api.github.com/users/menghanl/gists{/gist_id}","starred_url":"https://api.github.com/users/menghanl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/menghanl/subscriptions","organizations_url":"https://api.github.com/users/menghanl/orgs","repos_url":"https://api.github.com/users/menghanl/repos","events_url":"https://api.github.com/users/menghanl/events{/privacy}","received_events_url":"https://api.github.com/users/menghanl/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":586671344,"node_id":"MDU6TGFiZWw1ODY2NzEzNDQ=","url":"https://api.github.com/repos/grpc/grpc-go/labels/Type:%20Bug","name":"Type: Bug","color":"bfdadc","default":false,"description":null,"archived_at":null,"archived_by":null}],"state":"closed","locked":true,"assignees":[{"login":"dfawley","id":26072277,"node_id":"MDQ6VXNlcjI2MDcyMjc3","avatar_url":"https://avatars.githubusercontent.com/u/26072277?v=4","gravatar_id":"","url":"https://api.github.com/users/dfawley","html_url":"https://github.com/dfawley","followers_url":"https://api.github.com/users/dfawley/followers","following_url":"https://api.github.com/users/dfawley/following{/other_user}","gists_url":"https://api.github.com/users/dfawley/gists{/gist_id}","starred_url":"https://api.github.com/users/dfawley/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dfawley/subscriptions","organizations_url":"https://api.github.com/users/dfawley/orgs","repos_url":"https://api.github.com/users/dfawley/repos","events_url":"http