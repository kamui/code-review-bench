[{"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964394315", "html_url": "https://github.com/grpc/grpc-go/issues/4965#issuecomment-964394315", "issue_url": "https://api.github.com/repos/grpc/grpc-go/issues/4965", "id": 964394315, "node_id": "IC_kwDOAacf8845e31L", "user": {"login": "menghanl", "id": 960845, "node_id": "MDQ6VXNlcjk2MDg0NQ==", "avatar_url": "https://avatars.githubusercontent.com/u/960845?v=4", "gravatar_id": "", "url": "https://api.github.com/users/menghanl", "html_url": "https://github.com/menghanl", "followers_url": "https://api.github.com/users/menghanl/followers", "following_url": "https://api.github.com/users/menghanl/following{/other_user}", "gists_url": "https://api.github.com/users/menghanl/gists{/gist_id}", "starred_url": "https://api.github.com/users/menghanl/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/menghanl/subscriptions", "organizations_url": "https://api.github.com/users/menghanl/orgs", "repos_url": "https://api.github.com/users/menghanl/repos", "events_url": "https://api.github.com/users/menghanl/events{/privacy}", "received_events_url": "https://api.github.com/users/menghanl/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2021-11-09T17:55:57Z", "updated_at": "2021-11-09T17:55:57Z", "body": "Thanks for the report!\r\nAnd adding a nil check for b.sc looks like the right fix to me.\r\n\r\nThis is a very tricky race.\r\n`cc.Connect()` must be called after the resolver's first update, but before the pickfirst balancer creates the SubConn.\r\nI cannot think of a good test. @dfawley, WDYT?", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964394315/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964408546", "html_url": "https://github.com/grpc/grpc-go/issues/4965#issuecomment-964408546", "issue_url": "https://api.github.com/repos/grpc/grpc-go/issues/4965", "id": 964408546, "node_id": "IC_kwDOAacf8845e7Ti", "user": {"login": "dfawley", "id": 26072277, "node_id": "MDQ6VXNlcjI2MDcyMjc3", "avatar_url": "https://avatars.githubusercontent.com/u/26072277?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dfawley", "html_url": "https://github.com/dfawley", "followers_url": "https://api.github.com/users/dfawley/followers", "following_url": "https://api.github.com/users/dfawley/following{/other_user}", "gists_url": "https://api.github.com/users/dfawley/gists{/gist_id}", "starred_url": "https://api.github.com/users/dfawley/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dfawley/subscriptions", "organizations_url": "https://api.github.com/users/dfawley/orgs", "repos_url": "https://api.github.com/users/dfawley/repos", "events_url": "https://api.github.com/users/dfawley/events{/privacy}", "received_events_url": "https://api.github.com/users/dfawley/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2021-11-09T18:13:45Z", "updated_at": "2021-11-09T18:13:45Z", "body": "Brainstorming: can we create a `NewSubConn` during `pickFirstBalancer.Build` with an empty address list, so that `b.sc` would never be `nil`?", "author_association": "MEMBER", "pin": null, "reactions": {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964408546/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964411784", "html_url": "https://github.com/grpc/grpc-go/issues/4965#issuecomment-964411784", "issue_url": "https://api.github.com/repos/grpc/grpc-go/issues/4965", "id": 964411784, "node_id": "IC_kwDOAacf8845e8GI", "user": {"login": "menghanl", "id": 960845, "node_id": "MDQ6VXNlcjk2MDg0NQ==", "avatar_url": "https://avatars.githubusercontent.com/u/960845?v=4", "gravatar_id": "", "url": "https://api.github.com/users/menghanl", "html_url": "https://github.com/menghanl", "followers_url": "https://api.github.com/users/menghanl/followers", "following_url": "https://api.github.com/users/menghanl/following{/other_user}", "gists_url": "https://api.github.com/users/menghanl/gists{/gist_id}", "starred_url": "https://api.github.com/users/menghanl/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/menghanl/subscriptions", "organizations_url": "https://api.github.com/users/menghanl/orgs", "repos_url": "https://api.github.com/users/menghanl/repos", "events_url": "https://api.github.com/users/menghanl/events{/privacy}", "received_events_url": "https://api.github.com/users/menghanl/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2021-11-09T18:17:52Z", "updated_at": "2021-11-09T18:17:52Z", "body": "I think adding a nil check is easier and straightforward.\r\nAn empty address list is invalid for pickfirst.\r\nAlso note that we set `b.sc` back to nil when the SubConn switches to shutdown.", "author_association": "CONTRIBUTOR", "pin": null, "reactions": {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964411784/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964414372", "html_url": "https://github.com/grpc/grpc-go/issues/4965#issuecomment-964414372", "issue_url": "https://api.github.com/repos/grpc/grpc-go/issues/4965", "id": 964414372, "node_id": "IC_kwDOAacf8845e8uk", "user": {"login": "entombedvirus", "id": 1622, "node_id": "MDQ6VXNlcjE2MjI=", "avatar_url": "https://avatars.githubusercontent.com/u/1622?v=4", "gravatar_id": "", "url": "https://api.github.com/users/entombedvirus", "html_url": "https://github.com/entombedvirus", "followers_url": "https://api.github.com/users/entombedvirus/followers", "following_url": "https://api.github.com/users/entombedvirus/following{/other_user}", "gists_url": "https://api.github.com/users/entombedvirus/gists{/gist_id}", "starred_url": "https://api.github.com/users/entombedvirus/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/entombedvirus/subscriptions", "organizations_url": "https://api.github.com/users/entombedvirus/orgs", "repos_url": "https://api.github.com/users/entombedvirus/repos", "events_url": "https://api.github.com/users/entombedvirus/events{/privacy}", "received_events_url": "https://api.github.com/users/entombedvirus/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2021-11-09T18:21:10Z", "updated_at": "2021-11-09T18:21:10Z", "body": "> cc.Connect() must be called after the resolver's first update, but before the pickfirst balancer creates the SubConn.\r\nI cannot think of a good test.\r\n\r\nyep, additionally, the resolver's first update must result in an empty addr list AND the resolver implementation must choose to call resolver.ClientConn.UpdateState instead of the more appropriate resolver.ClientConn.ReportError for the race to trigger. The reason ReportError doesn't trigger it is because cc.mu is held long enough inside cc.UpdateState that cc.Connect wont find pickfirst with a nil b.sc.\r\n\r\nAll the ways I could think of writing a proper unit test to catch the race involved inserting some kind of synchronization primitive to grpc.ClientConn make the cc.Connect goroutine block until resolver calls cc.UpdateState with an empty addr list. \r\n", "author_association": "NONE", "pin": null, "reactions": {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964414372/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}, {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964422856", "html_url": "https://github.com/grpc/grpc-go/issues/4965#issuecomment-964422856", "issue_url": "https://api.github.com/repos/grpc/grpc-go/issues/4965", "id": 964422856, "node_id": "IC_kwDOAacf8845e-zI", "user": {"login": "dfawley", "id": 26072277, "node_id": "MDQ6VXNlcjI2MDcyMjc3", "avatar_url": "https://avatars.githubusercontent.com/u/26072277?v=4", "gravatar_id": "", "url": "https://api.github.com/users/dfawley", "html_url": "https://github.com/dfawley", "followers_url": "https://api.github.com/users/dfawley/followers", "following_url": "https://api.github.com/users/dfawley/following{/other_user}", "gists_url": "https://api.github.com/users/dfawley/gists{/gist_id}", "starred_url": "https://api.github.com/users/dfawley/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/dfawley/subscriptions", "organizations_url": "https://api.github.com/users/dfawley/orgs", "repos_url": "https://api.github.com/users/dfawley/repos", "events_url": "https://api.github.com/users/dfawley/events{/privacy}", "received_events_url": "https://api.github.com/users/dfawley/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "created_at": "2021-11-09T18:32:26Z", "updated_at": "2021-11-10T19:57:29Z", "body": "> An empty address list is invalid for pickfirst.\r\n\r\nThis could be changed, though, right?\r\n\r\n> Also note that we set b.sc back to nil when the SubConn switches to shutdown.\r\n\r\nThis is also not necessarily required, and grpc shouldn't be calling ExitIdle on the balancer after it shuts it down.\r\n\r\n> I think adding a nil check is easier and straightforward.\r\n\r\nMy concern is that every usage of `b.sc` requires a `nil` check, and one was missed.  So clearly this is error-prone.  Making it always set would help.\r\n\r\n~~Can we stimulate this condition with a manual name resolver, report no addresses, then call `cc.Connect()`?  With an empty address list, `b.sc` will never be created, and the state of the LB policy never changes from idle.~~ This doesn't work reliably, because the state will change to TRANSIENT_FAILURE instead of staying IDLE, unless you hit the race.", "author_association": "MEMBER", "pin": null, "reactions": {"url": "https://api.github.com/repos/grpc/grpc-go/issues/comments/964422856/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "performed_via_github_app": null, "minimized": null}]