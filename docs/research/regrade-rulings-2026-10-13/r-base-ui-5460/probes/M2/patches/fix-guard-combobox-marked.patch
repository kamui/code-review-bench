@@ -0,0 +1,8 @@
+'use client';
+import * as React from 'react';
+
+/**
+ * True for an element that a composite control (Combobox, Number Field) renders as its text box.
+ * The composite owns the field value; the text it passes down is only what the box displays.
+ */
+export const CompositeInputContext = React.createContext(false);
