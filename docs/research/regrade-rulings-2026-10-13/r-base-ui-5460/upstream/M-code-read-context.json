 "ogdakke/voidmesh/components/ui/color-picker/color-value-input.tsx@abf0154ad (2026-03-07T18:21:31Z)": [
  "1: import { useState, useRef } from \"react\";",
  "2: import { cssToOklch } from \"#lib/color-utils.ts\";",
  "3: import { useIsMobile } from \"#hooks/use-is-mobile.ts\";",
  "4: import { Select, SelectItem } from \"#ui/select/select.tsx\";",
  "5: import { NativeSelect, NativeSelectOption } from \"#ui/native-select/native-select.tsx\";",
  "6: import { useColorPicker } from \"./use-color-picker\";",
  "7: import { Field } from \"#ui/field/field.tsx\";",
  "8: import {",
  "9:   detectColorValueFormat,",
  "10:   formatOklchForValueFormat,",
  "11:   getColorValueFormatDefinition,",
  "12:   normalizeColorValueForFormat,",
  "13:   type ColorValueFormat,",
  "14: } from \"./color-value-formats\";",
  "15: import type { FieldRootProps } from \"@base-ui/react\";",
  "16: ",
  "17: interface ValueInputProps extends FieldRootProps {}",
  "18: export function ValueInput(props: ValueInputProps) {",
  "19:   const {",
  "20:     state: { oklch },",
  "21:     actions: { setCssValue, setSelectedFormat },",
  "22:     meta: { supportsP3, selectedFormat, availableFormats },",
  "23:   } = useColorPicker();",
  "24: ",
  "25:   const isMobile = useIsMobile();",
  "26:   const [focused, setFocused] = useState(false);",
  "27:   const [inputValue, setInputValue] = useState(\"\");",
  "28:   const inputRef = useRef<HTMLInputElement>(null);",
  "29:   const inputValueRef = useRef(\"\");",
  "30:   const initialValueRef = useRef(\"\");",
  "31:   const suppressBlurApplyRef = useRef(false);",
  "32: ",
  "33:   const displayValue = focused ? inputValue : formatOklchForValueFormat(oklch, selectedFormat);",
  "34:   const formatOptions = { supportsP3 };",
  "35: ",
  "36:   const tryApply = (raw: string) => {",
  "37:     const detectedFormat = detectColorValueFormat(raw, formatOptions);",
  "38:     if (!detectedFormat) return null;",
  "39: ",
  "40:     const normalized = normalizeColorValueForFormat(raw, detectedFormat);",
  "41:     if (!normalized) return null;",
  "42: ",
  "43:     if (detectedFormat !== selectedFormat) {",
  "44:       setSelectedFormat(detectedFormat);",
  "45:     }",
  "46: ",
  "47:     setCssValue(normalized);",
  "48:     return normalized;",
  "49:   };",
  "50: ",
  "51:   const handleFormatChange = (nextFormat: ColorValueFormat) => {",
  "52:     const draftValue = inputValueRef.current;",
  "53:     const draftFormat = detectColorValueFormat(draftValue, formatOptions);",
  "54:     const sourceColor =",
  "55:       focused && draftFormat !== null",
  "56:         ? cssToOklch(normalizeColorValueForFormat(draftValue, draftFormat) ?? draftValue)",
  "57:         : oklch;",
  "58:     const converted = formatOklchForValueFormat(sourceColor, nextFormat);",
  "59: ",
  "60:     suppressBlurApplyRef.current = false;",
  "61:     setSelectedFormat(nextFormat);",
  "62:     inputValueRef.current = converted;",
  "63:     setInputValue(converted);",
  "64:     initialValueRef.current = converted;",
  "65:     setCssValue(converted, sourceColor);",
  "66:   };",
  "67: ",
  "68:   return (",
  "69:     <div className=\"color-picker__value-row\">",
  "70:       {availableFormats.length > 1 &&",
  "71:         (isMobile ? (",
  "72:           <NativeSelect",
  "73:             aria-label=\"Color format\"",
  "74:             value={selectedFormat}",
  "75:             onPointerDownCapture={() => {",
  "76:               suppressBlurApplyRef.current = true;",
  "77:             }}",
  "78:             onChange={(event) => handleFormatChange(event.target.value as ColorValueFormat)}",
  "79:             variant=\"quiet\"",
  "80:             className=\"color-picker__format-native-select\"",
  "81:           >",
  "82:             {availableFormats.map((format) => (",
  "83:               <NativeSelectOption key={format} value={format}>",
  "84:                 {getColorValueFormatDefinition(format)?.label ?? format}",
  "85:               </NativeSelectOption>",
  "86:             ))}",
  "87:           </NativeSelect>",
  "88:         ) : (",
  "89:           <div",
  "90:             className=\"color-picker__format-select\"",
  "91:             onPointerDownCapture={() => {",
  "92:               suppressBlurApplyRef.current = true;",
  "93:             }}",
  "94:           >",
  "95:             <Select",
  "96:               aria-label=\"Color format\"",
  "97:               value={selectedFormat}",
  "98:               onValueChange={(value) => handleFormatChange(value as ColorValueFormat)}",
  "99:               formatValue={getColorValueFormatDefinition(selectedFormat)?.label ?? selectedFormat}",
  "100:             >",
  "101:               {availableFormats.map((format) => (",
  "102:                 <SelectItem key={format} value={format}>",
  "103:                   {getColorValueFormatDefinition(format)?.label ?? format}",
  "104:                 </SelectItem>",
  "105:               ))}",
  "106:             </Select>",
  "107:           </div>",
  "108:         ))}",
  "109:       <Field.Root",
  "110:         {...props}",
  "111:         validate={(v) => (detectColorValueFormat(String(v), formatOptions) ? null : \"\")}",
  "112:         validationMode=\"onChange\"",
  "113:       >",
  "114:         {props.children}",
  "115:         <Field.Control",
  "116:           ref={inputRef}",
  "117:           className=\"color-picker__value-input\"",
  "118:           type=\"text\"",
  "119:           value={displayValue}",
  "120:           aria-label=\"Color value\"",
  "121:           spellCheck={false}",
  "122:           autoComplete=\"off\"",
  "123:           onFocus={() => {",
  "124:             const css = formatOklchForValueFormat(oklch, selectedFormat);",
  "125:             setFocused(true);",
  "126:             inputValueRef.current = css;",
  "127:             setInputValue(css);",
  "128:             initialValueRef.current = css;",
  "129:           }}",
  "130:           onBlur={() => {",
  "131:             if (suppressBlurApplyRef.current) {",
  "132:               suppressBlurApplyRef.current = false;",
  "133:               setFocused(false);",
  "134:               return;",
  "135:             }",
  "136:             if (inputValueRef.current !== initialValueRef.current) {",
  "137:               tryApply(inputValueRef.current);",
  "138:             }",
  "139:             setFocused(false);",
  "140:           }}",
  "141:           onChange={(e) => {",
  "142:             const nextValue = e.target.value;",
  "143:             inputValueRef.current = nextValue;",
  "144:             setInputValue(nextValue);",
  "145:             tryApply(nextValue);",
  "146:           }}",
  "147:           onKeyDown={(e) => {",
  "148:             if (e.key === \"Enter\") {",
  "149:               tryApply(inputValueRef.current);",
  "150:               inputRef.current?.blur();",
  "151:             }",
  "152:           }}",
  "153:           onPaste={(e) => {",
  "154:             e.preventDefault();",
  "155:             const pasted = e.clipboardData.getData(\"text\").trim();",
  "156:             inputValueRef.current = pasted;",
  "157:             setInputValue(pasted);",
  "158:             tryApply(pasted);",
  "159:           }}",
  "160:         />",
  "161:       </Field.Root>",
  "162:     </div>",
  "163:   );",
  "164: }"
 ],
