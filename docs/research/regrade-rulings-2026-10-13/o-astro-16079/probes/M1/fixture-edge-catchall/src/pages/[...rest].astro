---
// A catch-all page, as a site with a content-driven fallback or its own "not found" page has.
const seen = {
	route: '[...rest]',
	rest: Astro.params.rest,
	href: Astro.url.href,
	pathname: Astro.url.pathname,
	search: Astro.url.search,
	q: Astro.url.searchParams.get('q'),
};
---
<html>
	<head>
		<title>Catch-all</title>
	</head>
	<body>
		<h1>Catch-all</h1>
		<script type="application/json" id="probe" set:html={JSON.stringify(seen)} />
	</body>
</html>
