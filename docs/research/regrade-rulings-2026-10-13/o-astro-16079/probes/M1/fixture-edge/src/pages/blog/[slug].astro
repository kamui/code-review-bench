---
const seen = {
	route: 'blog/[slug]',
	slug: Astro.params.slug,
	href: Astro.url.href,
	pathname: Astro.url.pathname,
	search: Astro.url.search,
	ref: Astro.url.searchParams.get('ref'),
};
---
<html>
	<head>
		<title>Blog</title>
	</head>
	<body>
		<h1>Blog</h1>
		<script type="application/json" id="probe" set:html={JSON.stringify(seen)} />
	</body>
</html>
