---
const seen = {
	route: 'index',
	href: Astro.url.href,
	pathname: Astro.url.pathname,
	search: Astro.url.search,
	q: Astro.url.searchParams.get('q'),
	requestUrl: Astro.request.url,
};
---
<html>
	<head>
		<title>Index</title>
	</head>
	<body>
		<h1>Index</h1>
		<script type="application/json" id="probe" set:html={JSON.stringify(seen)} />
	</body>
</html>
