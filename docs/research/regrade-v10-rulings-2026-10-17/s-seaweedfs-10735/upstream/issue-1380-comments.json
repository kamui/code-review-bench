vacy}","received_events_url":"https://api.github.com/users/chrislusf/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-07-02T14:18:07Z","updated_at":"2020-07-02T14:59:41Z","body":"what is the mysql database setting, schema? Maybe related to mysql version.\r\n\r\nTry to test it with another store, to see whether the exported meta file has problem or the mysql has problem.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/653033184/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/653302949","html_url":"https://github.com/seaweedfs/seaweedfs/issues/1380#issuecomment-653302949","issue_url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/1380","id":653302949,"node_id":"MDEyOklzc3VlQ29tbWVudDY1MzMwMjk0OQ==","user":{"login":"zhutong196","id":48009847,"node_id":"MDQ6VXNlcjQ4MDA5ODQ3","avatar_url":"https://avatars.githubusercontent.com/u/48009847?v=4","gravatar_id":"","url":"https://api.github.com/users/zhutong196","html_url":"https://github.com/zhutong196","followers_url":"https://api.github.com/users/zhutong196/followers","following_url":"https://api.github.com/users/zhutong196/following{/other_user}","gists_url":"https://api.github.com/users/zhutong196/gists{/gist_id}","starred_url":"https://api.github.com/users/zhutong196/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zhutong196/subscriptions","organizations_url":"https://api.github.com/users/zhutong196/orgs","repos_url":"https://api.github.com/users/zhutong196/repos","events_url":"https://api.github.com/users/zhutong196/events{/privacy}","received_events_url":"https://api.github.com/users/zhutong196/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2020-07-03T02:30:53Z","updated_at":"2020-07-03T02:30:53Z","body":"> Try to test it with another store, to see whether the exported meta file has problem or the mysql has problem.\r\nI try to use MySQL as the back-end storage of the filer. The test results show that the information fields of the table in the storage file are normal, and I pass the fs.meta.save fs.meta.load ,The data can be imported into redis from mysql successfully. Then go to redis to check the value , and the value is all garbled.And my MySQL and redis do not set any parameters。My redis's version is 3.0.4,mysql 5.7\r\n\r\n**Test1: export meta file to redis from mysql**\r\n> fs.meta.load ./localhost-8888-20200702-183431.meta\r\nload /dir1\r\nload /dir2\r\nload /dir3\r\nload /topics\r\nload /dir1/test1\r\nload /dir2/test2\r\nload /dir3/test3\r\nload /topics/.system\r\nload /topics/.system/log\r\nload /topics/.system/log/2020-07-02\r\nload /topics/.system/log/2020-07-02/18-11.segment\r\nload /topics/.system/log/2020-07-02/18-15.segment\r\n\r\ntotal 7 directories, 5 files\r\n./localhost-8888-20200702-183431.meta is loaded.\r\n>\r\n\r\nThen I go to redis to see the value, which is shown as follows. \r\n[root@master ~]# kubectl exec -it -n seaweedfs redis-6bd547dbdc-ts4rw /bin/bash\r\nroot@redis-6bd547dbdc-ts4rw:/data# redis-cli\r\n127.0.0.1:6379> AUTH redis2020\r\nOK\r\n127.0.0.1:6379> KEYS *\r\n 1) \"/topics/.system/log\\x00\"\r\n 2) \"/topics/.system/log\"\r\n 3) \"/topics/.system/log/2020-07-02/18-11.segment\"\r\n 4) \"/topics\"\r\n 5) \"/dir2\\x00\"\r\n 6) \"/topics/.system\"\r\n 7) \"/dir1/test1\"\r\n 8) \"/dir3/test3\"\r\n 9) \"/dir3\\x00\"\r\n10) \"/topics/.system/log/2020-07-03\"\r\n11) \"/topics/.system/log/2020-07-03\\x00\"\r\n12) \"/dir2/test2\"\r\n13) \"/\\x00\"\r\n14) \"/dir2\"\r\n15) \"/dir1\"\r\n16) \"/topics/.system\\x00\"\r\n17) \"/topics/.system/log/2020-07-02/18-15.segment\"\r\n18) \"/topics/.system/log/2020-07-02\\x00\"\r\n19) \"/dir1\\x00\"\r\n20) \"/topics/.system/log/2020-07-02\"\r\n21) \"/topics\\x00\"\r\n22) \"/dir3\"\r\n23) \"/topics/.system/log/2020-07-03/10-10.segment\"\r\n127.0.0.1:6379> get /dir1\r\n\"\\\"\\x17\\x10\\xb7\\xe5\\xf6\\xf7\\x05\\x18\\xf8\\x83\\x80\\x80\\b0\\xb7\\xe5\\xf6\\xf7\\x05B\\x03000\"\r\n127.0.0.1:6379>\r\n\r\n**So the reason why I failed to import MySQL is not mysql, but redis seems to have processed my data, and all the values are garbled**\r\n\r\nredis config as follow:\r\n[root@master ~]# kubectl describe cm -n seaweedfs redis-conf\r\nName:         redis-conf\r\nNamespace:    seaweedfs\r\nLabels:       <none>\r\nAnnotations:  <none>\r\n\r\nData\r\n====\r\nredis.conf:\r\n----\r\nport 6379\r\ntimeout 300\r\nrequirepass redis2020\r\nappendonly yes\r\ndir /var/lib/redis\r\n\r\nEvents:  <none>","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/653302949/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/653344490","html_url":"https://github.com/seaweedfs/seaweedfs/issues/1380#issuecomment-653344490","issue_url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/1380","id":653344490,"node_id":"MDEyOklzc3VlQ29tbWVudDY1MzM0NDQ5MA==","user":{"login":"chrislusf","id":1543151,"node_id":"MDQ6VXNlcjE1NDMxNTE=","avatar_url":"https://avatars.githubusercontent.com/u/1543151?v=4","gravatar_id":"","url":"https://api.github.com/users/chrislusf","html_url":"https://github.com/chrislusf","followers_url":"https://api.github.com/users/chrislusf/followers","following_url":"https://api.github.com/users/chrislusf/following{/other_user}","gists_url":"https://api.github.com/users/chrislusf/gists{/gist_id}","starred_url":"https://api.github.com/users/chrislusf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrislusf/subscriptions","organizations_url":