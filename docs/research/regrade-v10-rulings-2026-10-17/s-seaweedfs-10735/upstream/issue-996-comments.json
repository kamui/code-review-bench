node_a/assets/seaweedfs/seq/\" -ip=10.10.10.60 -port=9333 -ip.bind=10.10.10.60 -whiteList={PRIV_LAN_IPS},127.0.0.1 -pulseSeconds=15 -volumePreallocate=false -volumeSizeLimitMB=30000\r\n\r\n\r\nNODE_B (volume-2)\r\n/usr/local/seaweedfs/bin/weed-volume volume -dir=/node_b/assets/weed/volumes -dataCenter=DEV1 -rack=NODE_B -max=256 -images.fix.orientation=false -ip=node_b.local-domain.com -port=9339 -port.public=8080 -mserver=10.10.10.60:9333 -pulseSeconds=15 -whiteList={PRIV_LAN_IPS},127.0.0.1 -index=leveldb\r\n\r\n\r\nNODE_B (filer)\r\n/usr/local/seaweedfs/bin/weed-filer filer -collection=global_blobs -dataCenter=DEV1 -maxMB=32 -ip=10.10.10.70 -port=8888 -port.readonly=8090 -master=10.10.10.60:9333 -dirListLimit=100000 -disableDirListing=false\r\n\r\n\r\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/506942277/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/comments/506974019","html_url":"https://github.com/seaweedfs/seaweedfs/issues/996#issuecomment-506974019","issue_url":"https://api.github.com/repos/seaweedfs/seaweedfs/issues/996","id":506974019,"node_id":"MDEyOklzc3VlQ29tbWVudDUwNjk3NDAxOQ==","user":{"login":"chrislusf","id":1543151,"node_id":"MDQ6VXNlcjE1NDMxNTE=","avatar_url":"https://avatars.githubusercontent.com/u/1543151?v=4","gravatar_id":"","url":"https://api.github.com/users/chrislusf","html_url":"https://github.com/chrislusf","followers_url":"https://api.github.com/users/chrislusf/followers","following_url":"https://api.github.com/users/chrislusf/following{/other_user}","gists_url":"https://api.github.com/users/chrislusf/gists{/gist_id}","starred_url":"https://api.github.com/users/chrislusf/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chrislusf/subscriptions","organizations_url":"