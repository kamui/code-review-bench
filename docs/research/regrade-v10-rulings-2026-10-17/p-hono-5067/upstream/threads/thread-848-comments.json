s/yusukebe/following{/other_user}","gists_url":"https://api.github.com/users/yusukebe/gists{/gist_id}","starred_url":"https://api.github.com/users/yusukebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2023-05-22T08:49:06Z","updated_at":"2023-05-22T08:49:06Z","body":"@charnould \r\n\r\nWith the current version, you can write it as follows:\r\n\r\n```ts\r\napp.post('/upload', async (c) => {\r\n  const { image } = await c.req.parseBody()\r\n\r\n  if (image instanceof File) {\r\n    console.log(image.name) // show the file name\r\n    const buffer = await image.arrayBuffer()\r\n    // do something with the buffer\r\n  }\r\n\r\n  return c.text('Uploaded!')\r\n})\r\n```\r\n\r\nWritten in https://github.com/honojs/hono/issues/664#issuecomment-1484007684","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1556806066/reactions","total_count":7,"+1":7,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/1558888001","html_url":"https://github.com/honojs/hono/issues/848#issuecomment-1558888001","issue_url":"https://api.github.com/repos/honojs/hono/issues/848","id":1558888001,"node_id":"IC_kwDOGiE5WM5c6r5B","user":{"login":"varHarrie","id":14304201,"node_id":"MDQ6VXNlcjE0MzA0MjAx","avatar_url":"https://avatars.githubusercontent.com/u/14304201?v=4","gravatar_id":"","url":"https://api.github.com/users/varHarrie","html_url":"https://github.com/varHarrie","followers_url":"https://api.github.com/