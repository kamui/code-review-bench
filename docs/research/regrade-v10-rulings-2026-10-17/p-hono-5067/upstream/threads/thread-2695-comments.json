content.com/u/121654029?v=4","gravatar_id":"","url":"https://api.github.com/users/EdamAme-x","html_url":"https://github.com/EdamAme-x","followers_url":"https://api.github.com/users/EdamAme-x/followers","following_url":"https://api.github.com/users/EdamAme-x/following{/other_user}","gists_url":"https://api.github.com/users/EdamAme-x/gists{/gist_id}","starred_url":"https://api.github.com/users/EdamAme-x/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EdamAme-x/subscriptions","organizations_url":"https://api.github.com/users/EdamAme-x/orgs","repos_url":"https://api.github.com/users/EdamAme-x/repos","events_url":"https://api.github.com/users/EdamAme-x/events{/privacy}","received_events_url":"https://api.github.com/users/EdamAme-x/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-05-25T22:46:26Z","updated_at":"2024-05-25T22:48:32Z","body":"request is avaible.\r\nbut, parsed formData is non-avaible.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2131600471/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2131603403","html_url":"https://github.com/honojs/hono/issues/2695#issuecomment-2131603403","issue_url":"https://api.github.com/repos/honojs/hono/issues/2695","id":2131603403,"node_id":"IC_kwDOGiE5WM5_Da_L","user":{"login":"EdamAme-x","id":121654029,"node_id":"U_kgDOB0BLDQ","avatar_url":"https://avatars.githubusercontent.com/u/121654029?v=4","gravatar_id":"","url":"https://api.github.com/users/EdamAme-x","html_url":"https://github.com/EdamAme-x","followers_url":"https://api.github.com/users/EdamAme-x/followers","following_url":"https://api.github.com/users/EdamAme-x/following{/other_user}","gists_url":"https://api.github.com/users/EdamAme-x/gists{/gist_id}","starred_url":"https://api.github.com/users/EdamAme-x/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/EdamAme-x/subscriptions","organizations_url":"https://api.github.com/users/EdamAme-x/orgs","repos_url":"https://api.github.com/users/EdamAme-x/repos","events_url":"https://api.github.com/users/EdamAme-x/events{/privacy}","received_events_url":"https://api.github.com/users/EdamAme-x/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-05-25T22:48:20Z","updated_at":"2024-05-25T22:48:20Z","body":"It is likely that the formData you submitted is corrupted..  \r\nIf not, please tell me additional information.\r\n\r\n```ts\r\nfunction convertFormDataToBodyData<T extends BodyData = BodyData>(\r\n  formData: FormData,\r\n  options: ParseBodyOptions\r\n): T {\r\n  const form: BodyData = {}\r\n\r\n  formData.forEach((value, key) => {\r\n    const shouldParseAllValues = options.all || key.endsWith('[]')\r\n\r\n    if (!shouldParseAllValues) {\r\n      form[key] = value\r\n    } else {\r\n      handleParsingAllValues(form, key, value)\r\n    }\r\n  })\r\n\r\n  return form as T\r\n}\r\n```","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2131603403/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2132139034","html_url":"https://github.com/honojs/hono/issues/2695#issuecomment-2132139034","issue_url":"https://api.github.com/repos/honojs/hono/issues/2695","id":2132139034,"node_id":"IC_kwDOGiE5WM5_Fdwa","user":{"login":"LuisMalhadas","id":93918064,"node_id":"U_kgDOBZkTcA","avatar_url":"https://avatars.githubusercontent.com/u/93918064?v=4","gravatar_id":"","url":"https://api.github.com/users/LuisMalhadas","html_url":"https://github.com/LuisMalhadas","followers_url":"https://api.github.com/users/LuisMalhadas/followers","following_url":"https://api.github.com/users/LuisMalhadas/following{/other_user}","gists_url":"https://api.github.com/users/LuisMalhadas/gists{/gist_id}","starred_url":"https://api.github.com/users/LuisMalhadas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/LuisMalhadas/subscriptions","organizations_url":"https://api.github.com/users/LuisMalhadas/orgs","repos_url":"https://api.github.com/users/LuisMalhadas/repos","events_url":"https://api.github.com/users/LuisMalhadas/events{/privacy}","received_events_url":"https://api.github.com/users/LuisMalhadas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-05-26T08:44:48Z","updated_at":"2024-05-26T09:43:01Z","body":"@EdamAme-x First of all thanks for paying attention to it and replying.\r\nIt could be... I have actually encountered similar issue: https://github.com/lau1944/bunrest/issues/46\r\nAnd with so many attempts at this, I may confuse somethings.\r\n\r\nEither way...\r\n\r\nI feel it is an issue with OpenAPIHono, as well.\r\nThe following is the definition I use for this particular endpoint:\r\n```Typescript\r\nspeech2text_app.openapi(\r\n    createRoute({\r\n      method: 'post',\r\n      path: '',\r\n      description: 'Transcribes an audio file to text',\r\n      request: {\r\n        params: z.object({\r\n            language: z.string().optional().openapi({ description: 'The language of the output text.'})\r\n        }),\r\n        body: {\r\n            content: {\r\n                'application/x-www-form-urlencoded': {\r\n                    schema: z.string().openapi({ format: 'binary', description: 'The audio file to transcribe' })\r\n                }\r\n            },\r\n            required: true\r\n        },\r\n        headers: auth_schema\r\n      },\r\n      responses: {\r\n        200: {\r\n          description: 'The full text of the audio file',\r\n          content: {\r\n            'application/json': {\r\n              schema: z.object({\r\n                text: z.string().openapi({ description: 'The transcribed text' })\r\n              })\r\n            }\r\n          }\r\n        },\r\n        ...\r\n```\r\nTo give more details\r\nThis is the php code that I am using to make the request:\r\n```php\r\n...\r\n    $endpoint = $this->base_url.\"/speech2text\";\r\n    $options = array();\r\n    $header = array(\r\n        'Authorization:' . .......,\r\n        'mimetype:' . $filemime,\r\n    );\r\n\r\n    $curl = new \\curl(['ignoresecurity' => true]);\r\n    $curl->setHeader($header);\r\n    $curl->setopt($options);\r\n    $response = $curl->post($endpoint, base64_encode($curlFile));\r\n    ...\r\n```\r\nIt is an audio file.\r\nIn Bun I receive it like so:\r\n```Typescript\r\n...\r\n    const audiodata = new FormData()\r\n    const audio = atob(req.body??'')\r\n    const buffer = new ArrayBuffer(audio.length)\r\n    const view = new Uint8Array(buffer)\r\n    for (let i = 0; i < audio.length; i++) {\r\n        view[i] = audio.charCodeAt(i)\r\n    }\r\n    const blob = new Blob([view], { type: req.headers?.mimetype as string })\r\n    audiodata.append('audio_file', blob, req.headers?.mimetype as string)\r\n```\r\nThat is working (for now), but implies I load the file all into memory.\r\nThe framework in use, on the php stack side, appears to be quite limited, and this may be the only method available to send...\r\nNevertheless using the HonoOpenAPI swagger frontend: \r\n```\r\n- I have disabled the authorisation header here (due to another issue with the swagger frontend and headers) -\r\n\r\n2024-05-26T08:34:49.407Z   <-- POST /speech2text\r\nRequest received:: \r\n Request (0 KB) {\r\n  method: \"POST\",\r\n  url: \"http://localhost:4007/speech2text\",\r\n  headers: Headers {\r\n    \"host\": \"localhost:4007\",\r\n    \"accept\": \"application/json\",\r\n    \"accept-encoding\": \"gzip, deflate\",\r\n    \"accept-language\": \"en-GB,en;q=0.9\",\r\n    \"sec-fetch-mode\": \"cors\",\r\n    \"content-type\": \"application/x-www-form-urlencoded\",\r\n    \"origin\": \"http://localhost:4007\",\r\n    \"user-agent\": \"-----------\",\r\n    \"referer\": \"http://localhost:4007/ui\",\r\n    \"content-length\": \"0\",\r\n    \"connection\": \"keep-alive\",\r\n    \"cookie\": \"-------\",\r\n    \"sec-fetch-dest\": \"empty\",\r\n    \"sec-fetch-site\": \"same-origin\",\r\n  }\r\n}\r\nin c.req.parseBody() comes {}\r\n\r\n2024-05-26T08:34:49.415Z Request received POST http://localhost:4007/speech2text \r\n2024-05-26T08:34:49.417Z   --> POST /speech2text 400 10ms\r\n\r\n{\r\n  \"success\": false,\r\n  \"error\": {\r\n    \"issues\": [\r\n      {\r\n        \"code\": \"invalid_type\",\r\n        \"expected\": \"string\",\r\n        \"received\": \"object\",\r\n        \"path\": [],\r\n        \"message\": \"Expected string, received object\"\r\n      }\r\n    ],\r\n    \"name\": \"ZodError\"\r\n  }\r\n}\r\n```\r\nShouldn't this work?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2132139034/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2280825561","html_url":"https://github.com/honojs/hono/issues/2695#issuecomment-2280825561","issue_url":"https://api.github.com/repos/honojs/hono/issues/2695","id":2280825561,"node_id":"IC_kwDOGiE5WM6H8qLZ","user":{"login":"yusukebe","id":10682,"node_id":"MDQ6VXNlcjEwNjgy","avatar_url":"https://avatars.githubusercontent.com/u/10682?v=4","gravatar_id":"","url":"https://api.github.com/users/yusukebe","html_url":"https://github.com/yusukebe","followers_url":"https://api.github.com/users/yusukebe/followers","following_url":"https://api.github.com/users/yusukebe/following{/other_user}","gists_url":"https://api.github.com/users/yusukebe/gists{/gist_id}","starred_url":"https://api.github.com/users/yusukebe/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-08-10T10:16:58Z","updated_at":"2024-08-10T10:16:58Z","body":"This works well:\r\n\r\n```ts\r\nimport { OpenAPIHono } from '@hono/zod-openapi'\r\n\r\nconst app = new OpenAPIHono()\r\n\r\napp.post('/', async (c) => {\r\n  const bod = await c.req.parseBody()\r\n  return c.json(bod)\r\n})\r\n\r\nexport default app\r\n```\r\n\r\nI don't understand this issue perfectly, but I think it's not a bug. I'll close it. If you still have a problem, please provide a minimal project to reproduce it.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2280825561/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]