{/repo}","subscriptions_url":"https://api.github.com/users/yusukebe/subscriptions","organizations_url":"https://api.github.com/users/yusukebe/orgs","repos_url":"https://api.github.com/users/yusukebe/repos","events_url":"https://api.github.com/users/yusukebe/events{/privacy}","received_events_url":"https://api.github.com/users/yusukebe/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-07-01T01:06:38Z","updated_at":"2024-07-01T01:06:57Z","body":"@HugeLetters Sorry for the late reply.\r\n\r\nI'm investigating it now. I've created a minimal code to reproduce it:\r\n\r\n```ts\r\nimport assert from 'assert'\r\nimport { Hono } from 'hono'\r\nimport { validator } from 'hono/validator'\r\n\r\nconst app = new Hono().post(\r\n  '/',\r\n  async (c, next) => {\r\n    await c.req.parseBody()\r\n    await next()\r\n  },\r\n  validator('form', (value) => {\r\n    console.log('validator - value:', value)\r\n    assert(!(value instanceof FormData), 'Value has to be a Record, not FormData')\r\n    return value\r\n  }),\r\n  (c) => {\r\n    return c.text('Hello Hono!')\r\n  }\r\n)\r\n\r\nconst form = new FormData()\r\nform.append('foo', 'bar')\r\n\r\nawait app.request('/', {\r\n  method: 'POST',\r\n  body: form\r\n})\r\n```\r\n\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/honojs/hono/issues/comments/2198854674/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]