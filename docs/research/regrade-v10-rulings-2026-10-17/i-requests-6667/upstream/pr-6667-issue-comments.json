github.com/users/mingshuang/orgs","repos_url":"https://api.github.com/users/mingshuang/repos","events_url":"https://api.github.com/users/mingshuang/events{/privacy}","received_events_url":"https://api.github.com/users/mingshuang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-18T12:58:46Z","updated_at":"2024-06-18T12:58:46Z","body":"Hi @mm-matthias I tried the latest cpython 3.12.4 and saw the same problem. So I written a python script below to simulate my code in production. and this script can reproduce this problem quickly with requests 2.32.3, and no such kind problem wiht requests 2.31.0. \r\n\r\n```python\r\nimport concurrent.futures\r\nimport random\r\nimport uuid\r\nfrom threading import Thread\r\nfrom time import time\r\n\r\nimport requests\r\n\r\n\r\ndef do_request():\r\n    start = time()\r\n    random_id = uuid.uuid4()\r\n    delay = random.randint(1, 5)\r\n    print(\"start {} delay {} seconds\".format(random_id, delay))\r\n    endpoints = []\r\n    endpoints.append('https://httpbin.org/delay/' + str(delay))\r\n    delay = str(random.randint(1, 5)) + 's'\r\n    endpoints.append('https://run.mocky.io/v3/0432e9f0-674f-45bd-9c18-628b861c2258?mocky-delay=' + str(delay))\r\n    random.shuffle(endpoints)\r\n    response = None\r\n    for endpoint in endpoints:\r\n        try:\r\n            print(\"start {} delay {} seconds\".format(random_id, endpoint))\r\n            if 'run' in endpoint:\r\n                cert = './client.crt', './client.key'\r\n                response = requests.get(endpoint, timeout=random.randint(1, 5), cert=cert)\r\n            else:\r\n                response = requests.get(endpoint, timeout=random.randint(1, 5))\r\n        except Exception as e:\r\n            print(e)\r\n    end = time()\r\n    print(\"finished {} in {} seconds\".format(random_id, end - start))\r\n    return response\r\n\r\n\r\ndef measure():\r\n    cnt = 20\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:\r\n        futures = []\r\n        for server in range(1, cnt):\r\n            futures.append(executor.submit(do_request))\r\n        for future in concurrent.futures.as_completed(futures):\r\n            pass\r\n\r\n\r\nfor i in range(1, 500):\r\n    threads = [Thread(target=measure, args=()) for _ in range(5)]\r\n\r\n    for t in threads: t.start()\r\n    for t in threads: t.join()\r\n\r\n```","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/2176042565/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/2176810762","html_url":"https://github.com/psf/requests/pull/6667#issuecomment-2176810762","issue_url":"https://api.github.com/repos/psf/requests/issues/6667","id":2176810762,"node_id":"IC_kwDOABTKOs6Bv38K","user":{"login":"mm-matthias","id":43849132,"node_id":"MDQ6VXNlcjQzODQ5MTMy","avatar_url":"https://avatars.githubusercontent.com/u/43849132?v=4","gravatar_id":"","url":"https://api.github.com/users/mm-matthias","html_url":"https://github.com/mm-matthias","followers_url":"https://api.github.com/users/mm-matthias/followers","following_url":"https://api.github.com/users/mm-matthias/following{/other_user}","gists_url":"https://api.github.com/users/mm-matthias/gists{/gist_id}","starred_url":"https://api.github.com/users/mm-matthias/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mm-matthias/subscriptions","organizations_url":"https://api.github.com/users/mm-matthias/orgs","repos_url":"https://api.github.com/users/mm-matthias/repos","events_url":"https://api.github.com/users/mm-matthias/events{/privacy}","received_events_url":"https://api.github.com/users/mm-matthias/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-18T19:28:35Z","updated_at":"2024-06-19T08:22:20Z","body":"@mingshuang I've run your script, but without the `client.crt/client.key` as I don't have any files for that. This did not cause any exceptions for me.\r\nBut if you feed different cert files for different files and somewhere the global ssl context is modified (which should not happen) this might maybe cause your errors?\r\nI am not very familiar with how the requests project works, but maybe you should open this as a separate issue (including your OS)? I saw that 2.32.0-2.32.3 suffered from quite a few problems related to the SSL context that were at least partially caused by this PR. So having this on the official radar is probably better than it being buried in this already merged PR discussion.\r\nAlso see https://github.com/psf/requests/issues/6726 .","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/2176810762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/2178701275","html_url":"https://github.com/psf/requests/pull/6667#issuecomment-2178701275","issue_url":"https://api.github.com/repos/psf/requests/issues/6667","id":2178701275,"node_id":"IC_kwDOABTKOs6B3Ffb","user":{"login":"mingshuang","id":8820706,"node_id":"MDQ6VXNlcjg4MjA3MDY=","avatar_url":"https://avatars.githubusercontent.com/u/8820706?v=4","gravatar_id":"","url":"https://api.github.com/users/mingshuang","html_url":"https://github.com/mingshuang","followers_url":"https://api.github.com/users/mingshuang/followers","following_url":"https://api.github.com/users/mingshuang/following{/other_user}","gists_url":"https://api.github.com/users/mingshuang/gists{/gist_id}","starred_url":"https://api.github.com/users/mingshuang/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mingshuang/subscriptions","organizations_url":"https://api.github.com/users/mingshuang/orgs","repos_url":"https://api.github.com/users/mingshuang/repos","events_url":"https://api.github.com/users/mingshuang/events{/privacy}","received_events_url":"https://api.github.com/users/mingshuang/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-06-19T13:17:42Z","updated_at":"2024-06-19T13:17:42Z","body":"hi @mm-matthias sorry forgot to attach the certificate. the certificate can be generated with command `openssl req -x509 -newkey rsa:4096 -keyout client.key -out client.crt -days 365 -nodes`. In my testing, I am using a certificate from letsencrypt. I tried openssl generated certificate and letsencrypt with the script above, both of them can reproduce the problem, but letsencrypt is easier, might saw the `Segmentation fault` in a few minutes, but openssl generated certificate needs around 10 minutes. Because my service is using letsencrypt certificate so i can not attach it here.\r\nAnd I just opened a new issue https://github.com/psf/requests/issues/6745 to track this problem","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/2178701275/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]