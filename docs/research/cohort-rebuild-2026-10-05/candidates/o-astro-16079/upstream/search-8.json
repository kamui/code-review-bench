ott/following{/other_user}","gists_url":"https://api.github.com/users/FredKSchott/gists{/gist_id}","starred_url":"https://api.github.com/users/FredKSchott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FredKSchott/subscriptions","organizations_url":"https://api.github.com/users/FredKSchott/orgs","repos_url":"https://api.github.com/users/FredKSchott/repos","events_url":"https://api.github.com/users/FredKSchott/events{/privacy}","received_events_url":"https://api.github.com/users/FredKSchott/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":6,"created_at":"2021-06-19T14:11:56Z","updated_at":"2021-07-14T18:15:36Z","closed_at":"2021-07-14T18:15:36Z","assignee":{"login":"FredKSchott","id":622227,"node_id":"MDQ6VXNlcjYyMjIyNw==","avatar_url":"https://avatars.githubusercontent.com/u/622227?v=4","gravatar_id":"","url":"https://api.github.com/users/FredKSchott","html_url":"https://github.com/FredKSchott","followers_url":"https://api.github.com/users/FredKSchott/followers","following_url":"https://api.github.com/users/FredKSchott/following{/other_user}","gists_url":"https://api.github.com/users/FredKSchott/gists{/gist_id}","starred_url":"https://api.github.com/users/FredKSchott/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/FredKSchott/subscriptions","organizations_url":"https://api.github.com/users/FredKSchott/orgs","repos_url":"https://api.github.com/users/FredKSchott/repos","events_url":"https://api.github.com/users/FredKSchott/events{/privacy}","received_events_url":"https://api.github.com/users/FredKSchott/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"## What is Missing from Astro Today?\r\n\r\n- `Astro.fetchContent` is currently parsed and compiled at build-time\r\n- This is currently a rigid codemod process: we grab a code snippet from the Astro component, parse its ast, traverse the ast, modify the code snippet, create imports that then need to be injected elsewhere on the page, etc. etc. We've seen bugs here in the past.\r\n- We've revisited a few past build-time steps during our beta launch, and I'd like to revisit this one.\r\n\r\n## Proposed Solution\r\n\r\nProof of Concept: https://github.com/snowpackjs/astro/tree/move-astro-fetchcontent-to-runtime\r\n\r\n- Moves this logic into the package: `astro/dist/internal/fetch-content.js`\r\n- Removes ~200 lines of compiler code (replaces with ~60 lines of runtime code)\r\n- `Astro.fetchContent` is now async (now that we have top-level await, this is no longer as huge of a deal as it was originally)\r\n- Backwards compat: we'll probably want to not touch the existing `fetchContent`, and instead add a new function to Astro. Then, we could add a console.log to `Astro.fetchContent` to notify the user that it is deprecated and to switch over.\r\n\r\n/cc @snowpackjs/maintainers wdyt?\r\n","reactions":{"url":"https://api.github.com/repos/withastro/astro/issues/500/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/withastro/astro/issues/500/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0}],"search_type":"lexical"}