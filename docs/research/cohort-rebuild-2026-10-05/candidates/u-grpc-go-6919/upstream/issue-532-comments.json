ntext.Context, *test.Empty) (*test.Empty, error) { return nil, nil }\n```\n\nAny client is fine.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/180630773/reactions","total_count":3,"+1":3,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/180631762","html_url":"https://github.com/grpc/grpc-go/issues/532#issuecomment-180631762","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/532","id":180631762,"node_id":"MDEyOklzc3VlQ29tbWVudDE4MDYzMTc2Mg==","user":{"login":"xiang90","id":4479947,"node_id":"MDQ6VXNlcjQ0Nzk5NDc=","avatar_url":"https://avatars.githubusercontent.com/u/4479947?v=4","gravatar_id":"","url":"https://api.github.com/users/xiang90","html_url":"https://github.com/xiang90","followers_url":"https://api.github.com/users/xiang90/followers","following_url":"https://api.github.com/users/xiang90/following{/other_user}","gists_url":"https://api.github.com/users/xiang90/gists{/gist_id}","starred_url":"https://api.github.com/users/xiang90/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/xiang90/subscriptions","organizations_url":"https://api.github.com/users/xiang90/orgs","repos_url":"https://api.github.com/users/xiang90/repos","events_url":"https://api.github.com/users/xiang90/events{/privacy}","received_events_url":"https://api.github.com/users/xiang90/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-02-06T00:14:36Z","updated_at":"2016-02-06T00:14:36Z","body":"@ashishgandhi It works fine I believe. You need to return the error correctly, not nil response + nil error.\n","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/180631762/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confuse