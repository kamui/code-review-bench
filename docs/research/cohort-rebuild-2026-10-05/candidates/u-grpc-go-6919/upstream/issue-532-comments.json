.com/users/songshine/subscriptions","organizations_url":"https://api.github.com/users/songshine/orgs","repos_url":"https://api.github.com/users/songshine/repos","events_url":"https://api.github.com/users/songshine/events{/privacy}","received_events_url":"https://api.github.com/users/songshine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-12-16T02:58:02Z","updated_at":"2016-12-16T02:58:02Z","body":"I got this error:\r\n```\r\ngrpc: Server failed to encode response proto: Marshal called with nil\r\n```\r\nRefer to https://github.com/grpc/grpc-go/blob/master/rpc_util.go#L265,  the nil message case has been considered. So the `msg` is not a nil `interface{}` here but the real object of `msg` is nil.  Shouldn't this be fixed?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/267505570/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/267676197","html_url":"https://github.com/grpc/grpc-go/issues/532#issuecomment-267676197","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/532","id":267676197,"node_id":"MDEyOklzc3VlQ29tbWVudDI2NzY3NjE5Nw==","user":{"login":"menghanl","id":960845,"node_id":"MDQ6VXNlcjk2MDg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/960845?v=4","gravatar_id":"","url":"https://api.github.com/users/menghanl","html_url":"https://github.com/menghanl","followers_url":"https://api.github.com/users/menghanl/followers","following_url":"https://api.github.com/users/menghanl/following{/other_user}","gists_url":"https://api.github.com/users/menghanl/gists{/gist_id}","starred_url":"https://api.github.com/users/menghanl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/menghanl/subscriptions","organizations_url":"https://api.github.com/users/menghanl/orgs","repos_url":"https://api.github.com/users/menghanl/repos","events_url":"https://api.github.com/users/menghanl/events{/privacy}","received_events_url":"https://api.github.com/users/menghanl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-12-16T19:29:00Z","updated_at":"2016-12-16T19:29:00Z","body":"> So the msg is not a nil interface{} here but the real object of msg is nil.\r\n\r\n@songshine Can you give an example for this? Or a reproduction of the error?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/267676197/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/267862169","html_url":"https://github.com/grpc/grpc-go/issues/532#issuecomment-267862169","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/532","id":267862169,"node_id":"MDEyOklzc3VlQ29tbWVudDI2Nzg2MjE2OQ==","user":{"login":"songshine","id":7608866,"node_id":"MDQ6VXNlcjc2MDg4NjY=","avatar_url":"https://avatars.githubusercontent.com/u/7608866?v=4","gravatar_id":"","url":"https://api.github.com/users/songshine","html_url":"https://github.com/songshine","followers_url":"https://api.github.com/users/songshine/followers","following_url":"https://api.github.com/users/songshine/following{/other_user}","gists_url":"https://api.github.com/users/songshine/gists{/gist_id}","starred_url":"https://api.github.com/users/songshine/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/songshine/subscriptions","organizations_url":"https://api.github.com/users/songshine/orgs","repos_url":"https://api.github.com/users/songshine/repos","events_url":"https://api.github.com/users/songshine/events{/privacy}","received_events_url":"https://api.github.com/users/songshine/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-12-19T01:18:42Z","updated_at":"2016-12-19T01:18:42Z","body":"@menghanl please think about the example from @ashishgandhi \r\n```\r\nfunc (*server) Do(context.Context, *test.Empty) (*test.Empty, error) { return nil, nil }\r\n```\r\nso when the code run into the line https://github.com/grpc/grpc-go/blob/master/rpc_util.go#L265,\r\n```\r\nif msg != nil {\r\n...\r\n}\r\n```\r\n the `msg` is (*test.Empty)(nil), but `msg != nil` will return true. This is an expected behavior?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/267862169/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/268056152","html_url":"https://github.com/grpc/grpc-go/issues/532#issuecomment-268056152","issue_url":"https://api.github.com/repos/grpc/grpc-go/issues/532","id":268056152,"node_id":"MDEyOklzc3VlQ29tbWVudDI2ODA1NjE1Mg==","user":{"login":"menghanl","id":960845,"node_id":"MDQ6VXNlcjk2MDg0NQ==","avatar_url":"https://avatars.githubusercontent.com/u/960845?v=4","gravatar_id":"","url":"https://api.github.com/users/menghanl","html_url":"https://github.com/menghanl","followers_url":"https://api.github.com/users/menghanl/followers","following_url":"https://api.github.com/users/menghanl/following{/other_user}","gists_url":"https://api.github.com/users/menghanl/gists{/gist_id}","starred_url":"https://api.github.com/users/menghanl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/menghanl/subscriptions","organizations_url":"https://api.github.com/users/menghanl/orgs","repos_url":"https://api.github.com/users/menghanl/repos","events_url":"https://api.github.com/users/menghanl/events{/privacy}","received_events_url":"https://api.github.com/users/menghanl/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-12-19T19:32:03Z","updated_at":"2016-12-19T22:02:20Z","body":"I think the fix should be\r\n - remove the [Fatalf](https://github.com/grpc/grpc-go/blob/master/server.go#L582) in `server.go` and return the error\r\n\r\nSo that the behavior will be, if the error returned by service handler is `nil`, the response will be passed to `Codec` to do Marshal, even if the response is `nil`.\r\n\r\nIn the case of using protobuf and `return nil, nil`, the marshal will still fail with `Marshal called with nil`, and the user will be notified of the error, but not a `Fatalf`.","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/comments/268056152/reactions","total_count":5,"+1":5,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]