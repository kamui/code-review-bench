equests/pull/6716","diff_url":"https://github.com/psf/requests/pull/6716.diff","patch_url":"https://github.com/psf/requests/pull/6716.patch","merged_at":"2024-05-24T21:37:06Z"},"body":"This re-enables the use case of providing a custom SSLContext via a Transport Adapter as broken in #6655 and reported in #6715\r\n\r\nCloses #6715","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/6716/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":1,"eyes":1},"timeline_url":"https://api.github.com/repos/psf/requests/issues/6716/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/psf/requests/issues/6719","repository_url":"https://api.github.com/repos/psf/requests","labels_url":"https://api.github.com/repos/psf/requests/issues/6719/labels{/name}","comments_url":"https://api.github.com/repos/psf/requests/issues/6719/comments","events_url":"https://api.github.com/repos/psf/requests/issues/6719/events","html_url":"https://github.com/psf/requests/issues/6719","id":2312751120,"node_id":"I_kwDOABTKOs6J2cgQ","number":6719,"title":"ERROR - Cannot set verify_mode to CERT_NONE when check_hostname is enabled","user":{"login":"Barsovski","id":7067187,"node_id":"MDQ6VXNlcjcwNjcxODc=","avatar_url":"https://avatars.githubusercontent.com/u/7067187?v=4","gravatar_id":"","url":"https://api.github.com/users/Barsovski","html_url":"https://github.com/Barsovski","followers_url":"https://api.github.com/users/Barsovski/followers","following_url":"https://api.github.com/users/Barsovski/following{/other_user}","gists_url":"https://api.github.com/users/Barsovski/gists{/gist_id}","starred_url":"https://api.github.com/users/Barsovski/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Barsovski/subscriptions","organizations_url":"https://api.github.com/users/Barsovski/orgs","repos_url":"https://api.github.com/users/Barsovski/repos","events_url":"https://api.github.com/users/Barsovski/events{/privacy}","received_events_url":"https://api.github.com/users/Barsovski/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":true,"assignees":[],"milestone":null,"comments":1,"created_at":"2024-05-23T12:06:59Z","updated_at":"2025-05-24T00:04:40Z","closed_at":"2024-05-23T12:54:17Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"<!-- Summary. -->\r\nI'm working with the exchangelib (v5.4) library. \r\nA couple of days ago I noticed that in the Docker container exchangelib started complaining with an error `ValueError: Cannot set verify_mode to CERT_NONE when check_hostname is enabled`.\r\n\r\nExchangelib tries to connect to a local server with a low security level via a custom adapter with this lines\r\n\r\n```python\r\nfrom requests.adapters import HTTPAdapter\r\n\r\n\r\nclass CustomHttpAdapter(HTTPAdapter):\r\n    \"\"\"Transport adapter that allows us to use custom ssl_context.\"\"\"\r\n\r\n    def __init__(self, ssl_context=None, **kwargs):\r\n        self.ssl_context = ssl_context\r\n        super().__init__(**kwargs)\r\n\r\n    def init_poolmanager(self, connections, maxsize, block=False, **kwargs):\r\n        self.ssl_context = ssl.SSLContext(ssl.PROTOCOL_TLSv1)\r\n        self.ssl_context.set_ciphers('DEFAULT:@SECLEVEL=0')\r\n        self.ssl_context.check_hostname = False\r\n\r\n        self.poolmanager = urllib3.poolmanager.PoolManager(\r\n            num_pools=connections, maxsize=maxsize,\r\n            block=block, ssl_context=self.ssl_context, ssl_version=ssl.PROTOCOL_TLSv1)\r\n```\r\nWith this exchangelib shows an error:\r\n```\r\nFile \"/usr/local/lib/python3.11/site-packages/cached_property.py\", line 70, in __get__\r\n2024-05-23T11:53:23.558367392Z     return obj_dict[name]\r\n2024-05-23T11:53:23.558368832Z            ~~~~~~~~^^^^^^\r\n2024-05-23T11:53:23.558370213Z KeyError: \\'calendar\\'\r\n```\r\n\r\nBut if I change the version of requests package from 2.32.0 to 2.31.0, connection and information exchange occurs normally.\r\n\r\n\r\n## System Information\r\n\r\n```json\r\n{\r\n  \"chardet\": {\r\n    \"version\": null\r\n  },\r\n  \"charset_normalizer\": {\r\n    \"version\": \"3.3.2\"\r\n  },\r\n  \"cryptography\": {\r\n    \"version\": \"\"\r\n  },\r\n  \"idna\": {\r\n    \"version\": \"3.7\"\r\n  },\r\n  \"implementation\": {\r\n    \"name\": \"CPython\",\r\n    \"version\": \"3.11.9\"\r\n  },\r\n  \"platform\": {\r\n    \"release\": \"6.5.0-35-generic\",\r\n    \"system\": \"Linux\"\r\n  },\r\n  \"pyOpenSSL\": {\r\n    \"openssl_version\": \"\",\r\n    \"version\": null\r\n  },\r\n  \"requests\": {\r\n    \"version\": \"2.32.0\"\r\n  },\r\n  \"system_ssl\": {\r\n    \"version\": \"300000b0\"\r\n  },\r\n  \"urllib3\": {\r\n    \"version\": \"2.2.1\"\r\n  },\r\n  \"using_charset_normalizer\": true,\r\n  \"using_pyopenssl\": false\r\n}\r\n```\r\n\r\n<!-- This command is only available on Requests v2.16.4 and greater. Otherwise,\r\nplease provide some basic information about your system (Python version,\r\noperating system, &c). -->\r\n","reactions":{"url":"https://api.github.com/repos/psf/requests/issues/6719/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/psf/requests/issues/6719/timeline","performed_via_github_app":null,"state_reason":"not_planned","pinned_comment":null,"score":1.0}],"search_type":"lexical"}