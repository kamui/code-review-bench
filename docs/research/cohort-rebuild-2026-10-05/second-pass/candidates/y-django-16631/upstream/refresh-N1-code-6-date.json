[{"sha":"6c23e2361da6f64e39440bfef1ee53e706e403c1","node_id":"C_kwDOU1qzO9oAKDZjMjNlMjM2MWRhNmY2NGUzOTQ0MGJmZWYxZWU1M2U3MDZlNDAzYzE","commit":{"author":{"name":"Swastik Singh","email":"149944139+swastikongithub@users.noreply.github.com","date":"2026-10-03T07:16:22Z"},"committer":{"name":"Swastik Singh","email":"149944139+swastikongithub@users.noreply.github.com","date":"2026-10-03T07:16:22Z"},"message":"Accounts: first-run setup creates the first administrator\n\nA brand-new database has no accounts and there is no public sign-up, so\nnobody could sign in to add anyone. /setup/bootstrap/ creates the first\nadministrator, and exists only while the user table is empty: the database\ndecides, so no flag, cookie or form field can reopen it, and once any\naccount exists (including one from createsuperuser) GET and POST are 404.\n\nThe account always gets the Administrator role, never superuser or Django\nstaff, whatever the request contains. It is not signed in: the person signs\nin normally and enrols TOTP like every administrator, then lands on Setup.\nCreation re-checks emptiness under a SHARE ROW EXCLUSIVE lock on the user\ntable, so simultaneous attempts produce exactly one administrator. Rate\nlimited to 5/min and 20/hour per address; audited without the password; an\noptional BOOTSTRAP_SETUP_CODE adds a code to the form. The sign-in page\nlinks to setup only while there are no accounts.\n\ncreatesuperuser is unchanged and remains the operator fallback.","tree":{"sha":"e7b070c54d68089bf32ac8b577816ca3e3d469a0","url":"https://api.github.com/repos/swastikongithub/Django-EduRev-P20/git/trees/e7b070c54d68089bf32ac8b577816ca3e3d469a0"},"url":"https://api.github.com/repos/swastikongithub/Django-EduRev-P20/git/commits/6c23e2361da6f64e39440bfef1ee53e706e403c1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/swastikongithub/Django-EduRev-P20/commits/6c23e2361da6f6