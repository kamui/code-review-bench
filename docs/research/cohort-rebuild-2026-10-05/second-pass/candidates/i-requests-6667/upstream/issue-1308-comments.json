[{"url":"https://api.github.com/repos/psf/requests/issues/comments/16293309","html_url":"https://github.com/psf/requests/issues/1308#issuecomment-16293309","issue_url":"https://api.github.com/repos/psf/requests/issues/1308","id":16293309,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjkzMzA5","user":{"login":"medecau","id":59870,"node_id":"MDQ6VXNlcjU5ODcw","avatar_url":"https://avatars.githubusercontent.com/u/59870?v=4","gravatar_id":"","url":"https://api.github.com/users/medecau","html_url":"https://github.com/medecau","followers_url":"https://api.github.com/users/medecau/followers","following_url":"https://api.github.com/users/medecau/following{/other_user}","gists_url":"https://api.github.com/users/medecau/gists{/gist_id}","starred_url":"https://api.github.com/users/medecau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/medecau/subscriptions","organizations_url":"https://api.github.com/users/medecau/orgs","repos_url":"https://api.github.com/users/medecau/repos","events_url":"https://api.github.com/users/medecau/events{/privacy}","received_events_url":"https://api.github.com/users/medecau/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-12T13:41:01Z","updated_at":"2013-04-12T13:41:01Z","body":"Let us pick and choose what version of SSL we use.\n\ncurl https://www.bbva.pt/\nunless\ncurl --sslv3 https://www.bbva.pt/\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/16293309/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/16293425","html_url":"https://github.com/psf/requests/issues/1308#issuecomment-16293425","issue_url":"https://api.github.com/repos/psf/requests/issues/1308","id":16293425,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MjkzNDI1","user":{"login":"Lukasa","id":1382556,"node_id":"MDQ6VXNlcjEzODI1NTY=","avatar_url":"https://avatars.githubusercontent.com/u/1382556?v=4","gravatar_id":"","url":"https://api.github.com/users/Lukasa","html_url":"https://github.com/Lukasa","followers_url":"https://api.github.com/users/Lukasa/followers","following_url":"https://api.github.com/users/Lukasa/following{/other_user}","gists_url":"https://api.github.com/users/Lukasa/gists{/gist_id}","starred_url":"https://api.github.com/users/Lukasa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lukasa/subscriptions","organizations_url":"https://api.github.com/users/Lukasa/orgs","repos_url":"https://api.github.com/users/Lukasa/repos","events_url":"https://api.github.com/users/Lukasa/events{/privacy}","received_events_url":"https://api.github.com/users/Lukasa/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-12T13:43:06Z","updated_at":"2013-04-12T13:43:06Z","body":"The accepted way of doing this in Requests is to use the Transport Adapter functionality. You can see an example of doing exactly this [here](https://lukasa.co.uk/2013/01/Choosing_SSL_Version_In_Requests/).\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/16293425/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/16294594","html_url":"https://github.com/psf/requests/issues/1308#issuecomment-16294594","issue_url":"https://api.github.com/repos/psf/requests/issues/1308","id":16294594,"node_id":"MDEyOklzc3VlQ29tbWVudDE2Mjk0NTk0","user":{"login":"medecau","id":59870,"node_id":"MDQ6VXNlcjU5ODcw","avatar_url":"https://avatars.githubusercontent.com/u/59870?v=4","gravatar_id":"","url":"https://api.github.com/users/medecau","html_url":"https://github.com/medecau","followers_url":"https://api.github.com/users/medecau/followers","following_url":"https://api.github.com/users/medecau/following{/other_user}","gists_url":"https://api.github.com/users/medecau/gists{/gist_id}","starred_url":"https://api.github.com/users/medecau/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/medecau/subscriptions","organizations_url":"https://api.github.com/users/medecau/orgs","repos_url":"https://api.github.com/users/medecau/repos","events_url":"https://api.github.com/users/medecau/events{/privacy}","received_events_url":"https://api.github.com/users/medecau/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-12T14:05:02Z","updated_at":"2013-04-12T14:05:02Z","body":"@lukasa thanks, this solves my problem.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/16294594/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/16295017","html_url":"https://github.com/psf/requests/issues/1308#issuecomment-16295017","issue_url":"https://api.github.com/repos/psf/requests/issues/1308","id":16295017,"node_id":"MDEyOklzc3VlQ29tbWVudDE2Mjk1MDE3","user":{"login":"damiengermonville","id":4136736,"node_id":"MDQ6VXNlcjQxMzY3MzY=","avatar_url":"https://avatars.githubusercontent.com/u/4136736?v=4","gravatar_id":"","url":"https://api.github.com/users/damiengermonville","html_url":"https://github.com/damiengermonville","followers_url":"https://api.github.com/users/damiengermonville/followers","following_url":"https://api.github.com/users/damiengermonville/following{/other_user}","gists_url":"https://api.github.com/users/damiengermonville/gists{/gist_id}","starred_url":"https://api.github.com/users/damiengermonville/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/damiengermonville/subscriptions","organizations_url":"https://api.github.com/users/damiengermonville/orgs","repos_url":"https://api.github.com/users/damiengermonville/repos","events_url":"https://api.github.com/users/damiengermonville/events{/privacy}","received_events_url":"https://api.github.com/users/damiengermonville/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2013-04-12T14:13:20Z","updated_at":"2013-04-12T14:13:20Z","body":"@Lukasa Thanks for the quick answer. I've looked at your post and I think it's a good start to solve my problem maybe (which is setting the ciphers, not the SSL version :p)\n\nThe VerifiedHTTPSConnection wraps the socket and that's where I need to provide ciphers (this is the only way apparently). I'm not sure i'll be able to create a pool and then use it in a adapter, all without having to copy/paste existing code (I'm looking for a clean way of doing it)\n\nMany thanks again\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/psf/requests/issues/comments/16295017/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/psf/requests/issues/comments/16300342","html_url":"https://github.com/psf/requests/issues/1308#issuecomment-16300342","issue_url":"https://api.github.com/repos/psf/requests/issues/1308","id":16300342,"node_id":"MDEyOklzc3VlQ29tbWVudDE2MzAwMzQy","user":{"login":"sigmavirus24","id":240830,"node_id":"MDQ6VXNlcjI0MDgzMA==","avatar_url":"https://avatars.githubusercontent.com/u/240830?v=4","gravatar_id":"","url":"https://api.github.com/users/sigmavirus24","html_url":"https://github.com/sigmavirus24","followers_url":"https://api.github.com/users/sigmavirus24/followers","following_url":"https://api.github.com/users/sigmavirus24/following{/other_user}","gists_url":"https://api.github.com/users/sigmavirus24/gists{/gist_i