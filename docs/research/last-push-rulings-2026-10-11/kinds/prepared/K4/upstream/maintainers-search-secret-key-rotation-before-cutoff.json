github.com/users/felixxm/repos","events_url":"https://api.github.com/users/felixxm/events{/privacy}","received_events_url":"https://api.github.com/users/felixxm/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/django/django/pulls/15198","html_url":"https://github.com/django/django/pull/15198","diff_url":"https://github.com/django/django/pull/15198.diff","patch_url":"https://github.com/django/django/pull/15198.patch","merged_at":"2022-02-01T11:15:56Z"},"body":"ticket-30360\r\n\r\n@carltongibson said we should use the approach of having a second setting called `SECRET_KEY_FALLBACKS` in #13850.\r\n\r\nI made an opinionated approach on supplying a new parameter, `read_keys` to `Signer`. It makes sense to me to identify the keys that can only be used for validation (perhaps I should have named it validator_keys). I also kept the same pattern regarding the setters and getters in PasswordResetTokenGenerator.","reactions":{"url":"https://api.github.com/repos/django/django/issues/15198/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/django/django/issues/15198/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/django/django/issues/13850","repository_url":"https://api.github.com/repos/django/django","labels_url":"https://api.github.com/repos/django/django/issues/13850/labels{/name}","comments_url":"https://api.github.com/repos/django/django/issues/13850/comments","events_url":"https://api.github.com/repos/django/django/issues/13850/events","html_url":"https://github.com/django/django/pull/13850","id":780642949,"node_id":"MDExOlB1bGxSZXF1ZXN0NTUwNTA0NDU1","number":13850,"title":"Fixed #30360 -- Support rotation of secret keys.","user"