field-scoped part of the issue.","closed_by":{"login":"michaldudak","id":4696105,"node_id":"MDQ6VXNlcjQ2OTYxMDU=","avatar_url":"https://avatars.githubusercontent.com/u/4696105?v=4","gravatar_id":"","url":"https://api.github.com/users/michaldudak","html_url":"https://github.com/michaldudak","followers_url":"https://api.github.com/users/michaldudak/followers","following_url":"https://api.github.com/users/michaldudak/following{/other_user}","gists_url":"https://api.github.com/users/michaldudak/gists{/gist_id}","starred_url":"https://api.github.com/users/michaldudak/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/michaldudak/subscriptions","organizations_url":"https://api.github.com/users/michaldudak/orgs","repos_url":"https://api.github.com/users/michaldudak/repos","events_url":"https://api.github.com/users/michaldudak/events{/privacy}","received_events_url":"https://api.github.com/users/michaldudak/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/5196/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mui/base-ui/issues/5196/timeline","performed_via_github_app":null,"state_reason":null}