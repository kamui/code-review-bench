ubusercontent.com/u/19780885?v=4","gravatar_id":"","url":"https://api.github.com/users/Jacksonmills","html_url":"https://github.com/Jacksonmills","followers_url":"https://api.github.com/users/Jacksonmills/followers","following_url":"https://api.github.com/users/Jacksonmills/following{/other_user}","gists_url":"https://api.github.com/users/Jacksonmills/gists{/gist_id}","starred_url":"https://api.github.com/users/Jacksonmills/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Jacksonmills/subscriptions","organizations_url":"https://api.github.com/users/Jacksonmills/orgs","repos_url":"https://api.github.com/users/Jacksonmills/repos","events_url":"https://api.github.com/users/Jacksonmills/events{/privacy}","received_events_url":"https://api.github.com/users/Jacksonmills/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-10-03T02:39:01Z","updated_at":"2025-10-03T03:04:26Z","body":"I can be assigned to this one if possible!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/3363944233/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/4267583200","html_url":"https://github.com/mui/base-ui/issues/718#issuecomment-4267583200","issue_url":"https://api.github.com/repos/mui/base-ui/issues/718","id":4267583200,"node_id":"IC_kwDOLW-eZs7-Xibg","user":{"login":"mj12albert","id":4997971,"node_id":"MDQ6VXNlcjQ5OTc5NzE=","avatar_url":"https://avatars.githubusercontent.com/u/4997971?v=4","gravatar_id":"","url":"https://api.github.com/users/mj12albert","html_url":"https://github.com/mj12albert","followers_url":"https://api.github.com/users/mj12albert/followers","following_url":"https://api.github.com/users/mj12albert/following{/other_user}","gists_url":"https://api.github.com/users/mj12albert/gists{/gist_id}","starred_url":"https://api.github.com/users/mj12albert/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mj12albert/subscriptions","organizations_url":"https://api.github.com/users/mj12albert/orgs","repos_url":"https://api.github.com/users/mj12albert/repos","events_url":"https://api.github.com/users/mj12albert/events{/privacy}","received_events_url":"https://api.github.com/users/mj12albert/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-04-17T11:23:34Z","updated_at":"2026-04-17T13:28:55Z","body":"We decided to not provide this component just for the autosizing ability, since `field-sizing` will eventually make it obsolete.\n\nIf you need a `Field`-integrated textarea this should work:\n\n```tsx\ntype MyTextareaOwnProps = Pick<\n  React.ComponentPropsWithoutRef<'textarea'>,\n  'cols' | 'rows' | 'wrap'\n>;\n\ntype MyTextareaProps = Omit<Field.Control.Props, 'render'> & MyTextareaOwnProps;\n\nconst MyTextarea = React.forwardRef<HTMLTextAreaElement, MyTextareaProps>(\n  function MyTextarea(props, forwardedRef) {\n    return <Field.Control {...props} ref={forwardedRef} render={<textarea />} />;\n  },\n);\n```\n\nHere's an example of an auto-sizing textarea based on the Material UI component's logic: https://stackblitz.com/edit/b451ccof?file=src%2FApp.tsx","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/4267583200/reactions","total_count":4,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":4,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]]