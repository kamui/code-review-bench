ull},{"id":6619776173,"node_id":"LA_kwDOLW-eZs8AAAABipHErQ","url":"https://api.github.com/repos/mui/base-ui/labels/PR:%20out-of-date","name":"PR: out-of-date","color":"ff9933","default":false,"description":"The pull request has merge conflicts and can't be merged.","archived_at":null,"archived_by":null},{"id":10029177824,"node_id":"LA_kwDOLW-eZs8AAAACVckb4A","url":"https://api.github.com/repos/mui/base-ui/labels/poc","name":"poc","color":"805688","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-07-26T22:16:33Z","updated_at":"2026-08-20T10:35:58Z","closed_at":null,"assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/mui/base-ui/pulls/5335","html_url":"https://github.com/mui/base-ui/pull/5335","diff_url":"https://github.com/mui/base-ui/pull/5335.diff","patch_url":"https://github.com/mui/base-ui/pull/5335.patch","merged_at":null},"body":"Fixes nested Menu focus when a submenu is opened with a physical pointer press. The submenu popup now receives focus so subsequent arrow keys are handled by the child menu instead of the parent trigger.\n\nThe focus behavior remains specific to the opening modality:\n\n- Hover leaves focus on the submenu trigger.\n- Keyboard and virtual screen reader presses focus the first submenu item.\n- Physical pointer presses focus the submenu popup.\n\nVirtual presses are tracked internally without changing the public interaction types. On VoiceOver, `aria-expanded` is omitted only when focus moves to a submenu item, avoiding an overlapping announcement while preserving the expanded state for hover and physical pointer focus.\n\nThe private iOS-style morphing menu experiment motivated these changes and is included to exercise the nested popup behavior:\n\nhttps://deploy-preview-5335--base-ui.netlify.app/experiments/menu/ios-style-popups\n\n> [!NOTE]\n> Coarse-pointer devices using a hardware keyboard may lose the visible menu-item focus indicator. A CSS-only `:focus-visible` override may also affect mobile screen-reader focus, so a clean fix may require JS modality tracking.\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/5335/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mui/base-ui/issues/5335/timeline","performed_via_github_app":{"id":1144995,"client_id":"Iv23liVemv8A9if9v0F2","slug":"chatgpt-codex-connector","node_id":"A_kwHOAOQ6Gs4AEXij","owner":{"login":"openai","id":14957082,"node_id":"MDEyOk9yZ2FuaXphdGlvbjE0OTU3MDgy","avatar_url":"https://avatars.githubusercontent.com/u/14957082?v=4","gravatar_id":"","url":"https://api.github.com/users/openai","html_url":"https://github.com/openai","followers_url":"https://api.github.com/users/openai/followers","following_url":"https://api.github.com/users/openai/following{/other_user}","gists_url":"https://api.github.com/users/openai/gists{/gist_id}","starred_url":"https://api.github.com/users/openai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/openai/subscriptions","organizations_url":"https://api.github.com/users/openai/orgs","repos_url":"https://api.github.com/users/openai/repos","events_url":"https://api.github.com/users/openai/events{/privacy}","received_events_url":"https://api.github.com/users/openai/received_events","type":"Organization","user_view_type":"public","site_admin":false},"name":"ChatGPT Codex Connector","description":"Bring ChatGPT and Codex to your GitHub repositories.","external_url":"https://www.chatgpt.com","html_url":"https://github.com/apps/chatgpt-codex-connector","created_at":"2025-02-14T01:37:05Z","updated_at":"2026-09-23T18:52:59Z","permissions":{"actions":"write","checks":"read","contents":"write","emails":"read","issues":