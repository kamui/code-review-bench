s back in\nfield.tsx. ColorField gets color-input.tsx, its markup having been inline until\nnow. Range drops the uncontrolled branch: RangeField is its only caller and\nalways controls it.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"eb6d4f3717c6415ec28ffecb18a29054ab078240","url":"https://api.github.com/repos/nilscox/festivapp/git/trees/eb6d4f3717c6415ec28ffecb18a29054ab078240"},"url":"https://api.github.com/repos/nilscox/festivapp/git/commits/7c897e9a75051659af38a1a13c3c25c1d364ac5c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/nilscox/festivapp/commits/7c897e9a75051659af38a1a13c3c25c1d364ac5c","html_url":"https://github.com/nilscox/festivapp/commit/7c897e9a75051659af38a1a13c3c25c1d364ac5c","comments_url":"https://api.github.com/repos/nilscox/festivapp/commits/7c897e9a75051659af38a1a13c3c25c1d364ac5c/comments","author":{"login":"nilscox","id":5544363,"node_id":"MDQ6VXNlcjU1NDQzNjM=","avatar_url":"https://avatars.githubusercontent.com/u/5544363?v=4","gravatar_id":"","url":"https://api.github.com/users/nilscox","html_url":"https://github.com/nilscox","followers_url":"https://api.github.com/users/nilscox/followers","following_url":"https://api.github.com/users/nilscox/following{/other_user}","gists_url":"https://api.github.com/users/nilscox/gists{/gist_id}","starred_url":"https://api.github.com/users/nilscox/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nilscox/subscriptions","organizations_url":"https://api.github.com/users/nilscox/orgs","repos_url":"https://api.github.com/users/nilscox/repos","events_url":"https://api.github.com/users/nilscox/events{/privacy}","received_events_url":"https://api.github.com/users/nilscox/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"nilscox","id":5544363,"node_id":"MDQ6VXNlcjU1NDQzNjM=","avatar_url":"https://avatars.githubusercontent.com/u/5544363?v=4","gravatar_id":"","url":"https://api.github.com/users/nilscox","html_url":"https://github.com/nilscox","followers_url":"https://api.github.com/users/nilscox/followers","following_url":"https://api.github.com/users/nilscox/following{/other_user}","gists_url":"https://api.github.com/users/nilscox/gists{/gist_id}","starred_url":"https://api.github.com/users/nilscox/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nilscox/subscriptions","organizations_url":"https://api.github.com/users/nilscox/orgs","repos_url":"https://api.github.com/users/nilscox/repos","events_url":"https://api.github.com/users/nilscox/events{/privacy}","received_events_url":"https://api.github.com/users/nilscox/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"98becef135c187224dab5106fc2597ab689893c3","url":"https://api.github.com/repos/nilscox/festivapp/commits/98becef135c187224dab5106fc2597ab689893c3","html_url":"https://github.com/nilscox/festivapp/commit/98becef135c187224dab5106fc2597ab689893c3"}]},{"sha":"b58a19ebce551de372e7a70fd9cee022e30340ed","node_id":"C_kwDOMlDEe9oAKGI1OGExOWViY2U1NTFkZTM3MmU3YTcwZmQ5Y2VlMDIyZTMwMzQwZWQ","commit":{"author":{"name":"nils","email":"nilscox.dev@gmail.com","date":"2026-08-07T11:12:56Z"},"committer":{"name":"nils","email":"nilscox.dev@gmail.com","date":"2026-08-07T11:12:56Z"},"message":"integrate TanStack Form into the backoffice\n\nBase UI's <Form> collected values off the DOM, so every route hand-wrote a\nFormValues type of all-strings and re-coerced them, cross-field rules had no\nhome, and array values were read two different ways with the ones Base UI\ncould not collect kept in a useState beside the form.\n\nThe form primitives now live in components/form/: useAppForm from\ncreateFormHook, bound field components rendering through Base UI's\ninvalid/touched props so the aria wiring survives, and an ArrayField driven by\npushValue/removeValue. parseValidationError flattens a 400 to TanStack's field\npaths and submitToApi puts it on the form's onServer error map.\n\npeople.tsx is the first form converted; the other six follow.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"a2d92814984d08bc71a693400058b34cd4e4cd62","url":"https://api.github.com/repos/nilscox/festivapp/git/trees/a2d92814984d08bc71a693400058b34cd4e4cd62"},"url":"https://api.github.com/repos/nilscox/festivapp/git/commits/b58a19ebce551de372e7a70fd9cee022e30340ed","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/nilscox/festivapp/commits/b58a19ebce551de372e7a70fd9cee022e30340ed","html_url":"https://github.com/nilscox/festivapp/commit/b58a19ebce551de372e7a70fd9cee022e30340ed","comments_url":"https://api.github.com/repos/nilscox/festivapp/commits/b58a19ebce551de372e7a70fd9cee022e30340ed/comments","author":{"login":"nilscox","id":5544363,"node_id":"MDQ6VXNlcjU1NDQzNjM=","avatar_url":"https://avatars.githubusercontent.com/u/5544363?v=4","gravatar_id":"","url":"https://api.github.com/users/nilscox","html_url":"https://github.com/nilscox","followers_url":"https://api.github.com/users/nilscox/followers","following_url":"https://api.github.com/users/nilscox/following{/other_user}","gists_url":"https://api.github.com/users/nilscox/gists{/gist_id}","starred_url":"https://api.github.com/users/nilscox/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nilscox/subscriptions","organizations_url":"https://api.github.com/users/nilscox/orgs","repos_url":"https://api.github.com/users/nilscox/repos","events_url":"https://api.github.com/users/nilscox/events{/privacy}","received_events_url":"https://api.github.com/users/nilscox/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"nilscox","id":5544363,"node_id":"MDQ6VXNlcjU1NDQzNjM=","avatar_url":"https://avatars.githu