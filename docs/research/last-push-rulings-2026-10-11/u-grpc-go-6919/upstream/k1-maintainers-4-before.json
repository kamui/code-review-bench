":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc-go/issues/5788/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/5313","repository_url":"https://api.github.com/repos/grpc/grpc-go","labels_url":"https://api.github.com/repos/grpc/grpc-go/issues/5313/labels{/name}","comments_url":"https://api.github.com/repos/grpc/grpc-go/issues/5313/comments","events_url":"https://api.github.com/repos/grpc/grpc-go/issues/5313/events","html_url":"https://github.com/grpc/grpc-go/issues/5313","id":1207354410,"node_id":"I_kwDOAacf885H9sQq","number":5313,"title":"grpc golang output doesn't validate with goimport","user":{"login":"Bluebugs","id":1481576,"node_id":"MDQ6VXNlcjE0ODE1NzY=","avatar_url":"https://avatars.githubusercontent.com/u/1481576?v=4","gravatar_id":"","url":"https://api.github.com/users/Bluebugs","html_url":"https://github.com/Bluebugs","followers_url":"https://api.github.com/users/Bluebugs/followers","following_url":"https://api.github.com/users/Bluebugs/following{/other_user}","gists_url":"https://api.github.com/users/Bluebugs/gists{/gist_id}","starred_url":"https://api.github.com/users/Bluebugs/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Bluebugs/subscriptions","organizations_url":"https://api.github.com/users/Bluebugs/orgs","repos_url":"https://api.github.com/users/Bluebugs/repos","events_url":"https://api.github.com/users/Bluebugs/events{/privacy}","received_events_url":"https://api.github.com/users/Bluebugs/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":586671344,"node_id":"MDU6TGFiZWw1ODY2NzEzNDQ=","url":"https://api.github.com/repos/grpc/grpc-go/labels/Type:%20Bug","name":"Type: Bug","color":"bfdadc","default":false,"description":null,"archived_at":null,"archived_by":null}],"state":"closed","locked":true,"assignees":[],"milestone":null,"comments":1,"created_at":"2022-04-18T19:10:16Z","updated_at":"2022-10-24T02:05:20Z","closed_at":"2022-04-26T17:36:01Z","assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":"resolved","sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What version of gRPC are you using?\r\nprotoc-gen-go is v1.28.0\r\n\r\n### What version of Go are you using (`go version`)?\r\n1.18\r\n\r\n### What operating system (Linux, Windows, …) and version?\r\nLinux\r\n\r\n### What did you do?\r\nRunning `goimports -e -d examples/helloworld/helloworld/` on this project report errors. And this is true for all project using goimports and protoc-gen-go.\r\n\r\n### What did you expect to see?\r\nNo error being reported.\r\n\r\n### What did you see instead?\r\n```\r\ndiff -u examples/helloworld/helloworld/helloworld.pb.go.orig examples/helloworld/helloworld/helloworld.pb.go\r\n--- examples/helloworld/helloworld/helloworld.pb.go.orig\t2022-04-18 13:07:38.358327018 -0600\r\n+++ examples/helloworld/helloworld/helloworld.pb.go\t2022-04-18 13:07:38.358327018 -0600\r\n@@ -21,11 +21,12 @@\r\n package helloworld\r\n\r\n import (\r\n+\treflect \"reflect\"\r\n+\tsync \"sync\"\r\n+\r\n \tproto \"github.com/golang/protobuf/proto\"\r\n \tprotoreflect \"google.golang.org/protobuf/reflect/protoreflect\"\r\n \tprotoimpl \"google.golang.org/protobuf/runtime/protoimpl\"\r\n-\treflect \"reflect\"\r\n-\tsync \"sync\"\r\n )\r\n\r\n const (\r\ndiff -u examples/helloworld/helloworld/helloworld_grpc.pb.go.orig examples/helloworld/helloworld/helloworld_grpc.pb.go\r\n--- examples/helloworld/helloworld/helloworld_grpc.pb.go.orig\t2022-04-18 13:07:38.361660144 -0600\r\n+++ examples/helloworld/helloworld/helloworld_grpc.pb.go\t2022-04-18 13:07:38.361660144 -0600\r\n@@ -8,6 +8,7 @@\r\n\r\n import (\r\n \tcontext \"context\"\r\n+\r\n \tgrpc \"google.golang.org/grpc\"\r\n \tcodes \"google.golang.org/grpc/codes\"\r\n \tstatus \"google.golang.org/grpc/status\"\r\n```\r\n ","reactions":{"url":"https://api.github.com/repos/grpc/grpc-go/issues/5313/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/grpc/grpc-go/issues/5313/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/grpc/grpc-go/issues/5180","repository_url":"https://api.github.com/repos/grpc/grpc-go","labels_url":"https://api.github.com/repos/grpc/grpc-go/issues/5180/labels{/name}","comments_url":"https://api.github.com/repos/grpc/grpc-go/issues/5180/comments","events_url":"https://api.github.com/repos/grpc/grpc-go/issues/5180/events","html_url":"https://github.com/grpc/grpc-go/pull/5180","id":1118611549,"node_id":"PR_kwDOAacf884xy5mr","number":5180,"title":"reflection: use protobuf/reflect instead of go reflection, fix dynamic messages","user":{"login":"codebutler","id":3827,"node_id":"MDQ6VXNlcjM4Mjc=","avatar_url":"https://avatars.githubusercontent.com/u/3827?v=4","gravatar_id":"","url":"https://api.github.com/users/codebutler","html_url":"https://github.com/codebutler","followers_url":"https://api.github.com/users/codebutler/followers","following_url":"https://api.github.com/users/codebutler/following{/other_user}","gists_url":"https://api.github.com/users/codebutler/gists{/gist_id}","starred_url":"https://api.github.com/users/codebutler/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/codebutler/subscriptions","organizations_url":"https://api.github.com/users/codebutler/orgs","repos_url":"https://api.github.com/users/codebutler/repos","events_url":"https://api.github.com/users/codebutler/events{/privacy}","received_events_url":"https://api.github.com/users/codebutler/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":586671344,"node_id":"MDU6TGFiZWw1ODY2NzEzNDQ=