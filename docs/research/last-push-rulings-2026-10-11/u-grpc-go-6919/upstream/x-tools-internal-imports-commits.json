[{"sha":"1b1e4dafd51a3c1e8959040a00e86d42b5e8a92f","node_id":"C_kwDOAZ43RtoAKDFiMWU0ZGFmZDUxYTNjMWU4OTU5MDQwYTAwZTg2ZDQyYjVlOGE5MmY","commit":{"author":{"name":"Sean Hildebrand","email":"seanwhildebrand@gmail.com","date":"2021-04-05T20:36:22Z"},"committer":{"name":"Gopher Robot","email":"gobot@golang.org","date":"2023-11-29T20:21:11Z"},"message":"internal/imports: remove duplicate unused imports\n\nTrack imports per identifier as a slice to accommodate duplicates. This\nallows us to generate multiple import fixes per import identifier.\n\nFixes golang/go#45398\n\nChange-Id: I78b80efabefc2263251c0087a0f2dc688f708de3\nGitHub-Last-Rev: 79f5729da29d44425eb9faf5247dfac3b4f1d433\nGitHub-Pull-Request: golang/tools#299\nReviewed-on: https://go-review.googlesource.com/c/tools/+/307449\nAuto-Submit: Robert Findley <rfindley@google.com>\nReviewed-by: Dmitri Shuralyov <dmitshur@google.com>\nReviewed-by: Robert Findley <rfindley@google.com>\nLUCI-TryBot-Result: Go LUCI <golang-scoped@luci-project-accounts.iam.gserviceaccount.com>","tree":{"sha":"69407f7829d0c478ceef51eeaad8412a3638f75b","url":"https://api.github.com/repos/golang/tools/git/trees/69407f7829d0c478ceef51eeaad8412a3638f75b"},"url":"https://api.github.com/repos/golang/tools/git/commits/1b1e4dafd51a3c1e8959040a00e86d42b5e8a92f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/golang/tools/commits/1b1e4dafd51a3c1e8959040a00e86d42b5e8a92f","html_url":"https://github.com/golang/tools/commit/1b1e4dafd51a3c1e8959040a00e86d42b5e8a92f","comments_url":"https://api.github.com/repos/golang/tools/commits/1b1e4dafd51a3c1e8959040a00e86d42b5e8a92f/comments","author":{"login":"Deiz","id":84350,"node_id":"MDQ6VXNlcjg0MzUw","avatar_url":"https://avatars.githubusercontent.com/u/84350?v=4","gravatar_id":"","url":"https://api.github.com/users/Deiz","html_url":"https://github.com/Deiz","followers_url":"https://api.github.com/users/Deiz/followers","following_url":"https://api.github.com/users/Deiz/following{/other_user}","gists_url":"https://api.github.com/users/Deiz/gists{/gist_id}","starred_url":"https://api.github.com/users/Deiz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Deiz/subscriptions","organizations_url":"https://api.github.com/users/Deiz/orgs","repos_url":"https://api.github.com/users/Deiz/repos","events_url":"https://api.github.com/users/Deiz/events{/privacy}","received_events_url":"https://api.github.com/users/Deiz/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"gopherbot","id":8566911,"node_id":"MDQ6VXNlcjg1NjY5MTE=","avatar_url":"https://avatars.githubusercontent.com/u/8566911?v=4","gravatar_id":"","url":"https://api.github.com/users/gopherbot","html_url":"https://github.com/gopherbot","followers_url":"https://api.github.com/users/gopherbot/followers","following_url":"https://api.github.com/users/gopherbot/following{/other_user}","gists_url":"https://api.github.com/users/gopherbot/gists{/gist_id}","starred_url":"https://api.github.com/users/gopherbot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/gopherbot/subscriptions","organizations_url":"https://api.github.com/users/gopherbot/orgs","repos_url":"https://api.github.com/users/gopherbot/repos","events_url":"https://api.github.com/users/gopherbot/events{/privacy}","received_events_url":"https://api.github.com/users/gopherbot/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"42c44707b82f0e5edc02308039814857a836b180","url":"https://api.github.com/repos/golang/tools/commits/42c44707b82f0e5edc02308039814857a836b180","html_url":"https://github.com/golang/tools/commit/42c44707b82f0e5edc02308039814857a836b180"}]},{"sha":"a1ca4fcd1f239dbaf964f10b88d32b9130e85475","node_id":"C_kwDOAZ43RtoAKGExY2E0ZmNkMWYyMzlkYmFmOTY0ZjEwYjg4ZDMyYjkxMzBlODU0NzU","commit":{"author":{"name":"Bryan C. Mills","email":"bcmills@google.com","date":"2023-11-07T17:50:45Z"},"committer":{"name":"Gopher Robot","email":"gobot@golang.org","date":"2023-11-15T16:14:37Z"},"message":"internal/gopathwalk: rationalize error and symlink handling in walker.walk\n\nfilepath.WalkDir may invoke its callback with a nil DirEntry and\nnon-nil error — a detail I missed when converting from fastwalk.Walk\nto filepath.WalkDir in CL 508506. Even though gopathwalk.Walk ignores\nfilesystem errors, its callback needs to check for that one.\n\nLooking into this bug, I also realized that the walk callback used to\nreturn only SkipDir or ErrTraverseLink. In retrospect, that makes\nsense given that Walk and WalkDir don't return errors, so I have\ndocumented that property and fixed a few places where it no longer\nheld.\n\nTo help to simplify the code enough to rule out other similar errors,\nwe also inline walker.shouldTraverse and simplify the case for\ntraversing symlinks. This results in slight changes in the visited\npackage directories when a root contains cyclic symlink paths,\nbut since we never expect symlink cycles to occur in the first place\nI don't expect that the changes will affect any users in practice.\n\nFixes golang/go#58054.\nUpdates golang/go#58035.\n\nChange-Id: Ie8cf1e4b5186b0d7b4650305bfc863330541f080\nReviewed-on: https://go-review.googlesource.com/c/tools/+/539480\nLUCI-TryBot-Result: Go LUCI <golang-scoped@luci-project-accounts.iam.gserviceaccount.com>\nTryBot-Result: Gopher Robot <gobot@golang.org>\nReviewed-by: Robert Findley <rfindley@google.com>\nAuto-Submit: Bryan Mills <bcmills@google.com>\nRun-TryBot: Bryan Mills <bcmills@google.com>","tree":{"sha":"1105f5f30f4031d36b0d8b0836379c10febbb591","url":"https://api.github.com/repos/golang/tools/git/trees/1105f5f30f4031d36b0d8b0836379c10febbb591"},"url":"https://api.github.com/repos/golang/tools/git/commits/a1ca4fcd1f239dbaf964f10b88d32b9130e85475","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signatur