[{"sha":"9f99628001cdc79c2d49775cfc3b3ab35b77fb85","node_id":"C_kwDOREOSJ9oAKDlmOTk2MjgwMDFjZGM3OWMyZDQ5Nzc1Y2ZjM2IzYWIzNWI3N2ZiODU","commit":{"author":{"name":"Peter","email":"peter@playerdata.com","date":"2026-08-13T11:08:32Z"},"committer":{"name":"Peter","email":"peter@playerdata.com","date":"2026-08-13T11:08:32Z"},"message":"fix(redis2): remove orphaned directory index members on listing\n\nListDirectoryEntries skipped index members whose value key was gone and\nleft them in the ZSET, so the per-directory child index grew without\nbound under any TTL workload. Mirror the ZRem the logical-expiry branch\nalready performs.\n\nCo-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>","tree":{"sha":"428746bbeae5bf939d676d08c1eced00d3b2460a","url":"https://api.github.com/repos/seaweedfs/seaweedfs/git/trees/428746bbeae5bf939d676d08c1eced00d3b2460a"},"url":"https://api.github.com/repos/seaweedfs/seaweedfs/git/commits/9f99628001cdc79c2d49775cfc3b3ab35b77fb85","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/seaweedfs/seaweedfs/commits/9f99628001cdc79c2d49775cfc3b3ab35b77fb85","html_url":"https://github.com/seaweedfs/seaweedfs/commit/9f99628001cdc79c2d49775cfc3b3ab35b77fb85","comments_url":"https://api.github.com/repos/seaweedfs/seaweedfs/commits/9f99628001cdc79c2d49775cfc3b3ab35b77fb85/comments","author":{"login":"petedodd-pd","id":232547300,"node_id":"U_kgDODdxj5A","avatar_url":"https://avatars.githubusercontent.com/u/232547300?v=4","gravatar_id":"","url":"https://api.github.com/users/petedodd-pd","html_url":"https://github.com/petedodd-pd","followers_url":"https://api.github.com/users/petedodd-pd/followers","following_url":"https://api.github.com/users/petedodd-pd/following{/other_user}","gists_url":"https://api.github.com/users/petedodd-pd/gists{/gist_id}","starred_url":"https://api.github.com/users/petedodd-pd/starred{/owner}{/repo}","subscriptions