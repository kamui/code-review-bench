privacy}","received_events_url":"https://api.github.com/users/carljm/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-02-26T23:54:34Z","updated_at":"2016-02-26T23:54:34Z","body":"I hadn't been following the issue, but I looked over the patch and it looks reasonable to me.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/189530303/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/189531404","html_url":"https://github.com/django/django/pull/5950#issuecomment-189531404","issue_url":"https://api.github.com/repos/django/django/issues/5950","id":189531404,"node_id":"MDEyOklzc3VlQ29tbWVudDE4OTUzMTQwNA==","user":{"login":"timgraham","id":411869,"node_id":"MDQ6VXNlcjQxMTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/411869?v=4","gravatar_id":"","url":"https://api.github.com/users/timgraham","html_url":"https://github.com/timgraham","followers_url":"https://api.github.com/users/timgraham/followers","following_url":"https://api.github.com/users/timgraham/following{/other_user}","gists_url":"https://api.github.com/users/timgraham/gists{/gist_id}","starred_url":"https://api.github.com/users/timgraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timgraham/subscriptions","organizations_url":"https://api.github.com/users/timgraham/orgs","repos_url":"https://api.github.com/users/timgraham/repos","events_url":"https://api.github.com/users/timgraham/events{/privacy}","received_events_url":"https://api.github.com/users/timgraham/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-02-27T00:00:54Z","updated_at":"2016-02-27T00:00:54Z","body":"merged in 3389c5ea229884a1943873fe7e7ffc2800cefc22, thanks!\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/189531404/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/406654296","html_url":"https://github.com/django/django/pull/5950#issuecomment-406654296","issue_url":"https://api.github.com/repos/django/django/issues/5950","id":406654296,"node_id":"MDEyOklzc3VlQ29tbWVudDQwNjY1NDI5Ng==","user":{"login":"youcandanch","id":448732,"node_id":"MDQ6VXNlcjQ0ODczMg==","avatar_url":"https://avatars.githubusercontent.com/u/448732?v=4","gravatar_id":"","url":"https://api.github.com/users/youcandanch","html_url":"https://github.com/youcandanch","followers_url":"https://api.github.com/users/youcandanch/followers","following_url":"https://api.github.com/users/youcandanch/following{/other_user}","gists_url":"https://api.github.com/users/youcandanch/gists{/gist_id}","starred_url":"https://api.github.com/users/youcandanch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/youcandanch/subscriptions","organizations_url":"https://api.github.com/users/youcandanch/orgs","repos_url":"https://api.github.com/users/youcandanch/repos","events_url":"https://api.github.com/users/youcandanch/events{/privacy}","received_events_url":"https://api.github.com/users/youcandanch/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-07-20T16:31:32Z","updated_at":"2018-07-20T17:06:47Z","body":"I may be misunderstanding something here, but I think this introduces some problems with middleware accessing the session in `process_response` if the middleware's further down the chain than the SessionMiddleware is. Say we have these three middlewares installed:\r\n\r\n```python\r\nMIDDLEWARE = (\r\n    'django.contrib.sessions.middleware.SessionMiddleware',\r\n    'django.contrib.auth.middleware.AuthenticationMiddleware',\r\n    'custom_application.middleware.AddPropertyToSessionMiddleware'\r\n)\r\n```\r\n\r\nThe body of `AddPropertyToSessionMiddleware` looks like this:\r\n\r\n```\r\nclass AddPropertyToSessionMiddleware(object):\r\n    def __init__(self, get_response):\r\n        self.get_response = get_response\r\n\r\n    def __call__(self, request):\r\n        response = self.get_response(request)\r\n\r\n        # Save something to the session.\r\n        request.session['new_property'] = 'foo'\r\n\r\n        return response\r\n```\r\n\r\nSince middleware responses are processed LIFO, `AddPropertyToSessionMiddleware` will add a property to session before the session's actually created in the backend. Then, when you arrive on [this line of the SessionMiddleware](https://github.com/django/django/blob/stable/1.11.x/django/contrib/sessions/middleware.py#L46), the `if` condition is met, as `request.session.__dict__` looks like this:\r\n\r\n```python\r\n{\r\n    '_SessionBase__session_key': u'0n2idw7qstws1dcg77n8ynjrfwk9zdwz', \r\n    'modified': True, \r\n    '_session_cache': {'new_property': 'foo'}, \r\n    'accessed': True, \r\n    '_cache': <django_redis.cache.RedisCache object at 0x7f8adf2306d0>, \r\n    'serializer': <class 'django.contrib.sessions.serializers.PickleSerializer'>\r\n}\r\n```\r\n\r\nThus, upon hitting `request.session.save()`, we hit this bit of code; I'm using the [cache backend here](https://github.com/django/django/blob/master/django/contrib/sessions/backends/cache.py#L54), because it doesn't really seem to matter as they all have the same logic:\r\n\r\n```\r\nif self.session_key is None:\r\n    # After doing anything with the session, a session_key exists; even just printing after \r\n    # https://github.com/django/django/blob/stable/1.11.x/django/contrib/sessions/middleware.py#L20 \r\n    # in the middleware means we have a session_key.\r\n    return self.create()\r\nif must_create:\r\n    # As far as I can tell, normal operations of using the middleware \r\n    # won't ever pass through `must_create` at this juncture.\r\n    func = self._cache.add\r\nelif self._cache.get(self.cache_key) is not None:\r\n    # Here's where we run into the problem. In versions previous to 1.10, \r\n    # this was an `else` statement, and automatically implied we were updating \r\n    # the cache layer with the new session. Now we're checking to see if there \r\n    # already _is_ something in the cache, and if it exists, updating it, or throwing \r\n    # an exception. \r\n    func = self._cache.set\r\nelse:\r\n    # At this point, we've never actually hit self.create(), \r\n    # so there isn't anything in the cache, and this exception will be \r\n    # thrown 100% of the time.\r\n    raise UpdateError\r\n```\r\n\r\nSo, yeah, I understand the security gap here, but it does mean that anyone trying to access the session in middleware is likely going to have problems. Any ideas on how to proceed with this? It's a blocker for us upgrading to 1.10+.","author_association":"NONE","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/406654296/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]