[{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2653980092","html_url":"https://github.com/mui/base-ui/issues/1425#issuecomment-2653980092","issue_url":"https://api.github.com/repos/mui/base-ui/issues/1425","id":2653980092,"node_id":"IC_kwDOLW-eZs6eMIW8","user":{"login":"mj12albert","id":4997971,"node_id":"MDQ6VXNlcjQ5OTc5NzE=","avatar_url":"https://avatars.githubusercontent.com/u/4997971?v=4","gravatar_id":"","url":"https://api.github.com/users/mj12albert","html_url":"https://github.com/mj12albert","followers_url":"https://api.github.com/users/mj12albert/followers","following_url":"https://api.github.com/users/mj12albert/following{/other_user}","gists_url":"https://api.github.com/users/mj12albert/gists{/gist_id}","starred_url":"https://api.github.com/users/mj12albert/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mj12albert/subscriptions","organizations_url":"https://api.github.com/users/mj12albert/orgs","repos_url":"https://api.github.com/users/mj12albert/repos","events_url":"https://api.github.com/users/mj12albert/events{/privacy}","received_events_url":"https://api.github.com/users/mj12albert/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-12T15:03:12Z","updated_at":"2025-02-12T15:03:12Z","body":"A workaround is to use a validation function and `match=\"customError\"`:\n\n```jsx\n<Field.Root\n  validationMode=\"onBlur\"\n  validate={(value) => {\n    if (value == null) {\n      return \"This field is required\";\n    }\n    return null;\n  }}\n>\n  <Select.Root required>\n    {/* the rest of the select */}\n  </Select.Root>\n  <Field.Error match=\"customError\" />\n</Field.Root>\n```\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2653980092/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2661710138","html_url":"https://github.com/mui/base-ui/issues/1425#issuecomment-2661710138","issue_url":"https://api.github.com/repos/mui/base-ui/issues/1425","id":2661710138,"node_id":"IC_kwDOLW-eZs6epnk6","user":{"login":"atomiks","id":22450188,"node_id":"MDQ6VXNlcjIyNDUwMTg4","avatar_url":"https://avatars.githubusercontent.com/u/22450188?v=4","gravatar_id":"","url":"https://api.github.com/users/atomiks","html_url":"https://github.com/atomiks","followers_url":"https://api.github.com/users/atomiks/followers","following_url":"https://api.github.com/users/atomiks/following{/other_user}","gists_url":"https://api.github.com/users/atomiks/gists{/gist_id}","starred_url":"https://api.github.com/users/atomiks/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/atomiks/subscriptions","organizations_url":"https://api.github.com/users/atomiks/orgs","repos_url":"https://api.github.com/users/atomiks/repos","events_url":"https://api.github.com/users/atomiks/events{/privacy}","received_events_url":"https://api.github.com/users/atomiks/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-17T00:30:49Z","updated_at":"2025-02-17T00:30:49Z","body":"For basic inputs at least, this is intentional. The input needs to be marked dirty first (changed then emptied) to trigger validation on blur, to reduce error noise while tabbing. Maybe there needs to be a setting to configure this?","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2661710138/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2661990117","html_url":"https://github.com/mui/base-ui/issues/1425#issuecomment-2661990117","issue_url":"https://api.github.com/repos/mui/base-ui/issues/1425","id":2661990117,"node_id":"IC_kwDOLW-eZs6eqr7l","user":{"login":"mj12albert","id":4997971,"node_id":"MDQ6VXNlcjQ5OTc5NzE=","avatar_url":"https://avatars.githubusercontent.com/u/4997971?v=4","gravatar_id":"","url":"https://api.github.com/users/mj12albert","html_url":"https://github.com/mj12albert","followers_url":"https://api.github.com/users/mj12albert/followers","following_url":"https://api.github.com/users/mj12albert/following{/other_user}","gists_url":"https://api.github.com/users/mj12albert/gists{/gist_id}","starred_url":"https://api.github.com/users/mj12albert/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mj12albert/subscriptions","organizations_url":"https://api.github.com/users/mj12albert/orgs","repos_url":"https://api.github.com/users/mj12albert/repos","events_url":"https://api.github.com/users/mj12albert/events{/privacy}","received_events_url":"https://api.github.com/users/mj12albert/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-02-17T04:47:42Z","updated_at":"2025-02-17T06:47:27Z","body":"> The input needs to be marked dirty first (changed then emptied) to trigger validation on blur, to reduce error noise while tabbing\n\nThis seems like a sensible default behavior, maybe it's time to expand the Field docs a bit like https://github.com/mui/base-ui/pull/1356 😬 \n\n> Maybe there needs to be a setting to configure this?\n\nTo keep the API surface lean, we could provide an extra `fieldState` argument to the `validate` function to have the noisier validation-on-blur instead of an extra prop, what do you think?\n```\n<Field.Root validate={(value, { dirty, touched, filled }) => {/* validation logic */}}>\n```\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/mui/base-ui/issues/comments/2661990117/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]