     "object_type": "FileContent",
     "property": "content",
     "fragment": "\t\t\t\"error actually happened. Turning the option off (`unsetopt EVAL_LINENO` \" +\n\t\t\t\"or `setopt NO_EVAL_LINENO`) reverts to pre-Zsh-4.3 behaviour: `$LINENO` \" +\n\t\t\t\"collapses to the line that launched the `eval`, so every runtime error \" +",
     "matches": [
      {
       "text": "setopt NO_EVAL_LINENO",
       "indices": [
        88,
        109
       ]
      }
     ]
    },
    {
     "object_url": "https://api.github.com/repositories/1095311589/contents/pkg/katas/zc2000s.go?ref=55a5407a798af569742e182e0ac8e911f9ead9c8",
     "object_type": "FileContent",
     "property": "content",
     "fragment": "\t\t\tif enabling {\n\t\t\t\treturn zc2001Hit(cmd, \"setopt NO_EVAL_LINENO\")\n\t\t\t}",
     "matches": [
      {
       "text": "setopt NO_EVAL_LINENO",
       "indices": [
        44,
        65
       ]
      }
     ]
    }
   ]
