     "property": "content",
     "fragment": "\t\tID:       \"ZC2001\",\n\t\tTitle:    \"Warn on `unsetopt EVAL_LINENO` \u2014 `$LINENO` inside `eval` stops tracking source, stack traces go blank\",\n\t\tSeverity: SeverityWarning,",
     "matches": [
      {
       "text": "unsetopt EVAL_LINENO",
       "indices": [
        44,
        64
       ]
      }
     ]
    },
    {
     "object_url": "https://api.github.com/repositories/1095311589/contents/pkg/katas/zc2000s.go?ref=55a5407a798af569742e182e0ac8e911f9ead9c8",
     "object_type": "FileContent",
     "property": "content",
     "fragment": "\t\t\t\"`$funcstack` pointing at the line inside the `eval`ed string where the \" +\n\t\t\t\"error actually happened. Turning the option off (`unsetopt EVAL_LINENO` \" +\n\t\t\t\"or `setopt NO_EVAL_LINENO`) reverts to pre-Zsh-4.3 behaviour: `$LINENO` \" +",
     "matches": [
      {
       "text": "unsetopt EVAL_LINENO",
       "indices": [
        133,
        153
       ]
      }
     ]
    }
   ]
