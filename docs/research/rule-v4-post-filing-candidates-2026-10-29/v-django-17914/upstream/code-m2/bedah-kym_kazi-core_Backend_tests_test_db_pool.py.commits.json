[{"sha":"d47f0a1585d9f9d783e2d016d8b70aea3b1431fb","node_id":"C_kwDORtiFNdoAKGQ0N2YwYTE1ODVkOWY5ZDc4M2UyZDAxNmQ4YjcwYWVhM2IxNDMxZmI","commit":{"author":{"name":"BEDAN MUNGAI","email":"85731257+bedah-kym@users.noreply.github.com","date":"2026-10-21T18:08:52Z"},"committer":{"name":"BEDAN MUNGAI","email":"85731257+bedah-kym@users.noreply.github.com","date":"2026-10-21T18:08:52Z"},"message":"fix(settings): opt-in capped Postgres connection pool per process\n\nUnder ASGI every request thread kept its own connection for CONN_MAX_AGE\n(600 s), so the web process alone filled a 15-client session pooler and\npage loads failed with EMAXCONNSESSION. DB_POOL_MAX_SIZE=N now gives each\nprocess a reused pool of at most N connections (CONN_MAX_AGE 0, health\nchecks off, 10 s wait). Unset or 0 keeps today's behaviour; SQLite is never\npooled; an invalid value refuses to boot. Adds psycopg[pool] (psycopg-pool).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"7d2598c0b51f30ecd31a7f325222351c5c2e7df0","url":"https://api.github.com/repos/bedah-kym/kazi-core/git/trees/7d2598c0b51f30ecd31a7f325222351c5c2e7df0"},"url":"https://api.github.com/repos/bedah-kym/kazi-core/git/commits/d47f0a1585d9f9d783e2d016d8b70aea3b1431fb","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/bedah-kym/kazi-core/commits/d47f0a1585d9f9d783e2d016d8b70aea3b1431fb","html_url":"https://github.com/bedah-kym/kazi-core/commit/d47f0a1585d9f9d783e2d016d8b70aea3b1431fb","comments_url":"https://api.github.com/repos/bedah-kym/kazi-core/commits/d47f0a1585d9f9d783e2d016d8b70aea3b1431fb/comments","author":{"login":"bedah-kym","id":85731257,"node_id":"MDQ6VXNlcjg1NzMxMjU3","avatar_url":"https://avatars.githubusercontent.com/u/85731257?v=4","gravatar_id":"","url":"https://api.github.com/users/bedah-kym","html_url":"https://github.com/bedah-kym","followers_url":"https://api.github.com/users/bedah