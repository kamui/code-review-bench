[{"sha":"d1000cf2c3280d99f50f38170b387c0a770e850c","node_id":"C_kwDOR5FE39oAKGQxMDAwY2YyYzMyODBkOTlmNTBmMzgxNzBiMzg3YzBhNzcwZTg1MGM","commit":{"author":{"name":"Pablo Valentini","email":"pablondrina@gmail.com","date":"2026-10-14T16:14:24Z"},"committer":{"name":"Pablo Valentini","email":"pablondrina@gmail.com","date":"2026-10-14T16:14:24Z"},"message":"fix(db): conexão de request cancelado volta ao pool (incidente web-operator 14/10)\n\nSob ASGI, quando o cliente desiste no meio do request, a thread do request\nsegue e abre conexão depois do request_finished; o Django não a enxerga e,\ncom o pool do psycopg (#1632), ela some da capacidade para sempre. Oito\ndessas e todo request cai com PoolTimeout após 10 s.\n\nshop/orphan_connections.py anota a thread dona de cada conexão\n(connection_created) e, no request_started, devolve ao pool as conexões\ncuja thread já morreu. Thread viva nunca é tocada.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"b88c9d6fb07baab7a3aa475cc49e31f618dc2902","url":"https://api.github.com/repos/nelsonboulangerie/django-shopman/git/trees/b88c9d6fb07baab7a3aa475cc49e31f618dc2902"},"url":"https://api.github.com/repos/nelsonboulangerie/django-shopman/git/commits/d1000cf2c3280d99f50f38170b387c0a770e850c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/nelsonboulangerie/django-shopman/commits/d1000cf2c3280d99f50f38170b387c0a770e850c","html_url":"https://github.com/nelsonboulangerie/django-shopman/commit/d1000cf2c3280d99f50f38170b387c0a770e850c","comments_url":"https://api.github.com/repos/nelsonboulangerie/django-shopman/commits/d1000cf2c3280d99f50f38170b387c0a770e850c/comments","author":{"login":"pablondrina","id":23167183,"node_id":"MDQ6VXNlcjIzMTY3MTgz","avatar_url":"https://avatars.githubusercontent.com/u/23167183?v=4","gravatar_id":"","url":"https://api.github.com/users/pablondrina","html_url":"https://gith