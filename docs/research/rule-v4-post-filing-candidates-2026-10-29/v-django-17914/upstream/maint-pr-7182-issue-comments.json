[{"url":"https://api.github.com/repos/django/django/issues/comments/243479780","html_url":"https://github.com/django/django/pull/7182#issuecomment-243479780","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243479780,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzQ3OTc4MA==","user":{"login":"blueyed","id":9766,"node_id":"MDQ6VXNlcjk3NjY=","avatar_url":"https://avatars.githubusercontent.com/u/9766?v=4","gravatar_id":"","url":"https://api.github.com/users/blueyed","html_url":"https://github.com/blueyed","followers_url":"https://api.github.com/users/blueyed/followers","following_url":"https://api.github.com/users/blueyed/following{/other_user}","gists_url":"https://api.github.com/users/blueyed/gists{/gist_id}","starred_url":"https://api.github.com/users/blueyed/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueyed/subscriptions","organizations_url":"https://api.github.com/users/blueyed/orgs","repos_url":"https://api.github.com/users/blueyed/repos","events_url":"https://api.github.com/users/blueyed/events{/privacy}","received_events_url":"https://api.github.com/users/blueyed/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T15:31:25Z","updated_at":"2016-08-30T15:32:12Z","body":"That's maybe not the best way?!\nSee http://stackoverflow.com/a/12027768/15690 for an alternative, but it requires the `request` (for `request.META.get('wsgi.file_wrapper', None)`).\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243479780/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243486030","html_url":"https://github.com/django/django/pull/7182#issuecomment-243486030","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243486030,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzQ4NjAzMA==","user":{"login":"timgraham","id":411869,"node_id":"MDQ6VXNlcjQxMTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/411869?v=4","gravatar_id":"","url":"https://api.github.com/users/timgraham","html_url":"https://github.com/timgraham","followers_url":"https://api.github.com/users/timgraham/followers","following_url":"https://api.github.com/users/timgraham/following{/other_user}","gists_url":"https://api.github.com/users/timgraham/gists{/gist_id}","starred_url":"https://api.github.com/users/timgraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timgraham/subscriptions","organizations_url":"https://api.github.com/users/timgraham/orgs","repos_url":"https://api.github.com/users/timgraham/repos","events_url":"https://api.github.com/users/timgraham/events{/privacy}","received_events_url":"https://api.github.com/users/timgraham/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T15:49:49Z","updated_at":"2016-08-30T15:49:49Z","body":"Maybe I'm not understanding, but this seems a bit contradictory. \"Don't enable [persistent connections] during development.\" Given that the dev server should only be used for development, it seems like the code you proposed is enabling persistent connections during development.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243486030/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243507482","html_url":"https://github.com/django/django/pull/7182#issuecomment-243507482","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243507482,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzUwNzQ4Mg==","user":{"login":"blueyed","id":9766,"node_id":"MDQ6VXNlcjk3NjY=","avatar_url":"https://avatars.githubusercontent.com/u/9766?v=4","gravatar_id":"","url":"https://api.github.com/users/blueyed","html_url":"https://github.com/blueyed","followers_url":"https://api.github.com/users/blueyed/followers","following_url":"https://api.github.com/users/blueyed/following{/other_user}","gists_url":"https://api.github.com/users/blueyed/gists{/gist_id}","starred_url":"https://api.github.com/users/blueyed/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueyed/subscriptions","organizations_url":"https://api.github.com/users/blueyed/orgs","repos_url":"https://api.github.com/users/blueyed/repos","events_url":"https://api.github.com/users/blueyed/events{/privacy}","received_events_url":"https://api.github.com/users/blueyed/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T17:00:57Z","updated_at":"2016-08-30T17:00:57Z","body":"`0` does not mean it's persistent, but disabled.  `None` would be \"keep connections always\".\n`1800` is an arbitrary default here (30 minutes).\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243507482/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243576927","html_url":"https://github.com/django/django/pull/7182#issuecomment-243576927","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243576927,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzU3NjkyNw==","user":{"login":"blueyed","id":9766,"node_id":"MDQ6VXNlcjk3NjY=","avatar_url":"https://avatars.githubusercontent.com/u/9766?v=4","gravatar_id":"","url":"https://api.github.com/users/blueyed","html_url":"https://github.com/blueyed","followers_url":"https://api.github.com/users/blueyed/followers","following_url":"https://api.github.com/users/blueyed/following{/other_user}","gists_url":"https://api.github.com/users/blueyed/gists{/gist_id}","starred_url":"https://api.github.com/users/blueyed/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueyed/subscriptions","organizations_url":"https://api.github.com/users/blueyed/orgs","repos_url":"https://api.github.com/users/blueyed/repos","events_url":"https://api.github.com/users/blueyed/events{/privacy}","received_events_url":"https://api.github.com/users/blueyed/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T20:52:30Z","updated_at":"2016-08-30T20:52:30Z","body":"Better code?\n\n``` python\nimport sys\nis_runserver_with_threading = (\n    sys.argv[1:2] == ['runserver'] and\n    '--nothreading' not in sys.argv[2:]\n)\nconn_max_age = 0 if is_runserver_with_threading else 1800\n```\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243576927/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243583123","html_url":"https://github.com/django/django/pull/7182#issuecomment-243583123","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243583123,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzU4MzEyMw==","user":{"login":"aaugustin","id":788910,"node_id":"MDQ6VXNlcjc4ODkxMA==","avatar_url":"https://avatars.githubusercontent.com/u/788910?v=4","gravatar_id":"","url":"https://api.github.com/users/aaugustin","html_url":"https://github.com/aaugustin","followers_url":"https://api.github.com/users/aaugustin/followers","following_url":"https://api.github.com/users/aaugustin/following{/other_user}","gists_url":"https://api.github.com/users/aaugustin/gists{/gist_id}","starred_url":"https://api.github.com/users/aaugustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaugustin/subscriptions","organizations_url":"https://api.github.com/users/aaugustin/orgs","repos_url":"https://api.github.com/users/aaugustin/repos","events_url":"https://api.github.com/users/aaugustin/events{/privacy}","received_events_url":"https://api.github.com/users/aaugustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T21:14:10Z","updated_at":"2016-08-30T21:14:10Z","body":"The overhead of establishing a connection database is usually negligible in development, since the most common case is to run the database locally. Even in other scenarios, the performance considerations should be minimal. I'm afraid this could come across as a suggestion to optimize runserver for production use, which is a Very Bad Idea.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243583123/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243583967","html_url":"https://github.com/django/django/pull/7182#issuecomment-243583967","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243583967,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzU4Mzk2Nw==","user":{"login":"aaugustin","id":788910,"node_id":"MDQ6VXNlcjc4ODkxMA==","avatar_url":"https://avatars.githubusercontent.com/u/788910?v=4","gravatar_id":"","url":"https://api.github.com/users/aaugustin","html_url":"https://github.com/aaugustin","followers_url":"https://api.github.com/users/aaugustin/followers","following_url":"https://api.github.com/users/aaugustin/following{/other_user}","gists_url":"https://api.github.com/users/aaugustin/gists{/gist_id}","starred_url":"https://api.github.com/users/aaugustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaugustin/subscriptions","organizations_url":"https://api.github.com/users/aaugustin/orgs","repos_url":"https://api.github.com/users/aaugustin/repos","events_url":"https://api.github.com/users/aaugustin/events{/privacy}","received_events_url":"https://api.github.com/users/aaugustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-30T21:17:08Z","updated_at":"2016-08-30T21:17:08Z","body":"Perhaps this section could be reworded to say:\n\n> There's no use enabling persistent connections in development. Since the development server runs each request in its own thread by default, each request opens a new connection anyway.\n\nThe goal here is just to clarify that you can't test persistent connections with the development server (technically it could work with the `--nothreading` option, but then you have a single process, single thread server, which causes other issues).\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243583967/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243745858","html_url":"https://github.com/django/django/pull/7182#issuecomment-243745858","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243745858,"node_id":"MDEyOklzc3VlQ29tbWVudDI0Mzc0NTg1OA==","user":{"login":"blueyed","id":9766,"node_id":"MDQ6VXNlcjk3NjY=","avatar_url":"https://avatars.githubusercontent.com/u/9766?v=4","gravatar_id":"","url":"https://api.github.com/users/blueyed","html_url":"https://github.com/blueyed","followers_url":"https://api.github.com/users/blueyed/followers","following_url":"https://api.github.com/users/blueyed/following{/other_user}","gists_url":"https://api.github.com/users/blueyed/gists{/gist_id}","starred_url":"https://api.github.com/users/blueyed/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/blueyed/subscriptions","organizations_url":"https://api.github.com/users/blueyed/orgs","repos_url":"https://api.github.com/users/blueyed/repos","events_url":"https://api.github.com/users/blueyed/events{/privacy}","received_events_url":"https://api.github.com/users/blueyed/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T12:16:08Z","updated_at":"2016-08-31T12:16:08Z","body":"My situation was that I was seeing \"sorry, too many clients already\" exceptions when using Swagger UI (via django-rest-swagger 0.3.x), although using `max_connections = 100`: apparently the browser (Firefox) creates a lot of simultaneous connections, creating this situation.\n\nThen I found the documentation (just above this PR's patch):\n\n> The development server creates a new thread for each request it handles,\n>  negating the effect of persistent connections. Don't enable them during\n>  development.\n\nSo then I searched for a way to not enable them during development, and found the above.\n\nAgain, I am not trying to enable persistent connections during development (using a threaded runserver), but the opposite: we are using them in production (so they were enabled by default), but had not covered the local/dev settings.\n","author_association":"CONTRIBUTOR","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243745858/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/243815104","html_url":"https://github.com/django/django/pull/7182#issuecomment-243815104","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":243815104,"node_id":"MDEyOklzc3VlQ29tbWVudDI0MzgxNTEwNA==","user":{"login":"aaugustin","id":788910,"node_id":"MDQ6VXNlcjc4ODkxMA==","avatar_url":"https://avatars.githubusercontent.com/u/788910?v=4","gravatar_id":"","url":"https://api.github.com/users/aaugustin","html_url":"https://github.com/aaugustin","followers_url":"https://api.github.com/users/aaugustin/followers","following_url":"https://api.github.com/users/aaugustin/following{/other_user}","gists_url":"https://api.github.com/users/aaugustin/gists{/gist_id}","starred_url":"https://api.github.com/users/aaugustin/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/aaugustin/subscriptions","organizations_url":"https://api.github.com/users/aaugustin/orgs","repos_url":"https://api.github.com/users/aaugustin/repos","events_url":"https://api.github.com/users/aaugustin/events{/privacy}","received_events_url":"https://api.github.com/users/aaugustin/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-08-31T16:09:42Z","updated_at":"2016-08-31T16:09:42Z","body":"Most projects use separate settings modules for dev and prod, but if you're using the same module, you can use something like `'CONN_MAX_AGE': 0 if settings.DEBUG else 600`.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/243815104/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/django/django/issues/comments/245391375","html_url":"https://github.com/django/django/pull/7182#issuecomment-245391375","issue_url":"https://api.github.com/repos/django/django/issues/7182","id":245391375,"node_id":"MDEyOklzc3VlQ29tbWVudDI0NTM5MTM3NQ==","user":{"login":"timgraham","id":411869,"node_id":"MDQ6VXNlcjQxMTg2OQ==","avatar_url":"https://avatars.githubusercontent.com/u/411869?v=4","gravatar_id":"","url":"https://api.github.com/users/timgraham","html_url":"https://github.com/timgraham","followers_url":"https://api.github.com/users/timgraham/followers","following_url":"https://api.github.com/users/timgraham/following{/other_user}","gists_url":"https://api.github.com/users/timgraham/gists{/gist_id}","starred_url":"https://api.github.com/users/timgraham/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/timgraham/subscriptions","organizations_url":"https://api.github.com/users/timgraham/orgs","repos_url":"https://api.github.com/users/timgraham/repos","events_url":"https://api.github.com/users/timgraham/events{/privacy}","received_events_url":"https://api.github.com/users/timgraham/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2016-09-07T19:33:03Z","updated_at":"2016-09-07T19:33:03Z","body":"I don't think this is a common need that needs to be documented, especially since the code isn't so elegant.\n","author_association":"MEMBER","reactions":{"url":"https://api.github.com/repos/django/django/issues/comments/245391375/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]