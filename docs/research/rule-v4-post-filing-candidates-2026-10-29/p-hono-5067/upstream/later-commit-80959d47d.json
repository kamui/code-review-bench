ed_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"21b44b6db6118fc77fabb49832fc4cadd0ef8ec8","url":"https://api.github.com/repos/honojs/hono/commits/21b44b6db6118fc77fabb49832fc4cadd0ef8ec8","html_url":"https://github.com/honojs/hono/commit/21b44b6db6118fc77fabb49832fc4cadd0ef8ec8"}],"stats":{"total":22,"additions":22,"deletions":0},"files":[{"sha":"e4f254698ffc5ac512974df77192eed63cc69b94","filename":"src/request.test.ts","status":"modified","additions":16,"deletions":0,"changes":16,"blob_url":"https://github.com/honojs/hono/blob/80959d47d56ac18c2985336ad311917dc56497c5/src%2Frequest.test.ts","raw_url":"https://github.com/honojs/hono/raw/80959d47d56ac18c2985336ad311917dc56497c5/src%2Frequest.test.ts","contents_url":"https://api.github.com/repos/honojs/hono/contents/src%2Frequest.test.ts?ref=80959d47d56ac18c2985336ad311917dc56497c5","patch":"@@ -381,6 +381,22 @@ describe('Body methods with caching', () => {\n       expect(async () => await req.blob()).not.toThrow()\n     })\n \n+    it('should parse form data even if formData() is called before parseBody()', async () => {\n+      const data = new FormData()\n+      data.append('foo', 'bar')\n+      data.append('file', new File(['hello'], 't.txt', { type: 'text/plain' }))\n+      const req = new HonoRequest(\n+        new Request('http://localhost', {\n+          method: 'POST',\n+          body: data,\n+        })\n+      )\n+      await req.formData()\n+      const body = await req.parseBody()\n+      expect(body['foo']).toBe('bar')\n+      expect(body['file']).toBeInstanceOf(File)\n+    })\n+\n     describe('should not break body methods after parseBody() with non-form content-type', () => {\n       const createReq = () =>\n         new HonoRequest("},{"sha":"62e3c11617130bbbeeb42aec3e12dbd72dceb5ad","filename":"src/utils/body.ts","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/honojs/hono/blob/80959d47d56ac18c2985336ad311917dc56497c5/src%2Futils%2Fbody.ts","raw_url":"https://github.com/honojs/hono/raw/80959d47d56ac18c2985336ad311917dc56497c5/src%2Futils%2Fbody.ts","contents_url":"https://api.github.com/repos/honojs/hono/contents/src%2Futils%2Fbody.ts?ref=80959d47d56ac18c2985336ad311917dc56497c5","patch":"@@ -124,6 +124,12 @@ async function parseFormData<T extends BodyData>(\n   request: HonoRequest | Request,\n   options: ParseBodyOptions\n ): Promise<T> {\n+  if (!isRawRequest(request) && request.bodyCache.formData) {\n+    return convertFormDataToBodyData<T>(\n+      await (request.bodyCache.formData as FormData | Promise<FormData>),\n+      options\n+    )\n+  }\n   const headers = isRawRequest(request) ? request.headers : request.raw.headers\n   const arrayBuffer = await (request as Request).arrayBuffer()\n   const formDataPromise = bufferToFormData(arrayBuffer, headers.get('Content-Type') || '')"}]}